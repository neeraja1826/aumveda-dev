import React, {
  useEffect,
  useState,
} from 'react';

import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  
  useWindowDimensions,
} from 'react-native';
import {
  SafeAreaView,
} from 'react-native-safe-area-context';

import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { Image } from 'expo-image';

import {
  useLocalSearchParams,
  useRouter,
} from 'expo-router';

import {
  getProductBySlug,
} from '../../src/services/productService';
import {
  getProductReviews,
  submitProductReview,
} from '../../src/services/reviewService';

import { useAuth } from '../../src/context/AuthContext';
import {
  useCart,
} from '../../src/context/CartContext';
import { useWishlist } from '../../src/context/WishlistContext';

import ProductCard from '../../src/components/home/ProductCard';

export default function ProductDetailsScreen() {

  // ==========================================================
  // ROUTER
  // ==========================================================

  const {
    slug,
  } = useLocalSearchParams();

  const productSlug = slug ? String(slug) : '';
  const router =
    useRouter();

  const { width } = useWindowDimensions();
  const imageHeight = Math.min(width * 0.95, 460);
const [reviews, setReviews] = useState([]);
const [reviewsLoading, setReviewsLoading] = useState(false);
const { token, isAuthenticated } = useAuth();

const [reviewRating, setReviewRating] = useState(5);
const [reviewTitle, setReviewTitle] = useState('');
const [reviewText, setReviewText] = useState('');
const [reviewSubmitting, setReviewSubmitting] = useState(false);
const [reviewMessage, setReviewMessage] = useState('');
const [reviewError, setReviewError] = useState('');
  // ==========================================================
  // CART
  // ==========================================================

  const {
    cartItems,
    cartCount,
    addToCart,
    increaseQuantity,
    decreaseQuantity,
    removeFromCart,
  } = useCart();

  const {
    isWishlisted,
    toggleWishlist,
  } = useWishlist();

  // ==========================================================
  // PRODUCT STATE
  // ==========================================================

  const [product, setProduct] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [retryCount, setRetryCount] = useState(0);

  // ==========================================================
  // RETRY HANDLER
  // ==========================================================

  const handleRetry = () => {
    if (!productSlug) return;
    setRetryCount((count) => count + 1);
  };
const handleSubmitReview = async () => {
  if (!isAuthenticated || !token) {
    router.push('/login');
    return;
  }

  if (!reviewTitle.trim() && !reviewText.trim()) {
    setReviewError('Please enter a title or written feedback.');
    setReviewMessage('');
    return;
  }

  if (!product?.id) {
    setReviewError('Product information is unavailable.');
    return;
  }

  try {
    setReviewSubmitting(true);
    setReviewError('');
    setReviewMessage('');

    const result = await submitProductReview({
      productId: product.id,
      rating: reviewRating,
      title: reviewTitle,
      reviewText,
      token,
    });

    setReviewMessage(
      result.message || 'Your review was submitted for approval.'
    );

    setReviewTitle('');
    setReviewText('');
    setReviewRating(5);
  } catch (error) {
    setReviewError(
      error.message || 'Unable to submit your review.'
    );
  } finally {
    setReviewSubmitting(false);
  }
};
  // ==========================================================
  // LOAD WHEN PRODUCT / AUTH CHANGES
  // ==========================================================
useEffect(() => {
  if (!product?.id) return;

  let active = true;

  setReviewsLoading(true);

  getProductReviews(product.id)
    .then((data) => {
      if (active) setReviews(data);
    })
    .catch((err) => {
      console.warn('Product reviews:', err.message);
      if (active) setReviews([]);
    })
    .finally(() => {
      if (active) setReviewsLoading(false);
    });

  return () => {
    active = false;
  };
}, [product?.id]);
  useEffect(() => {
    let active = true;

    if (!slug) {
      return () => {
        active = false;
      };
    }

    Promise.resolve()
      .then(() => {
        if (!active) return null;

        setLoading(true);
        setError(null);
        return getProductBySlug(String(slug));
      })
      .then((data) => {
        if (!active) return;

        if (!data) {
          setProduct(null);
          setError('Product not found.');
          return;
        }

        setProduct(data);
      })
      .catch((err) => {
        if (!active) return;

        setProduct(null);
        setError(err?.message || 'Unable to load product.');
      })
      .finally(() => {
        if (active) setLoading(false);
      });

    return () => {
      active = false;
    };
  }, [slug, retryCount]);

  // ==========================================================
  // PRODUCT DATA
  // ==========================================================

  const variantId =
    product?.variant?.id ??
    null;

  const cartItem =
    cartItems.find(
      (item) =>
        item.productId ===
          product?.id &&
        item.variantId ===
          variantId
    );

  const isInCart =
    !!cartItem;

  const cartQuantity =
    Number(
      cartItem?.quantity || 0
    );

  const image =
    product?.image ||
    product?.image_url ||
    product?.thumbnail ||
    null;

  const price =
    Number(
      product?.variant?.price ??
        product?.price ??
        0
    );

  const comparePrice =
    Number(
      product?.variant
        ?.compare_at_price ??
        product?.compare_at_price ??
        0
    );

 const reviewCount = reviews.length;

const rating = reviewCount > 0
  ? reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / reviewCount
  : 0;

  const stock =
    Number(
      product?.variant
        ?.stock_quantity
    ) || 0;

  const variantName =
    product?.variant?.name ||
    '';

  const relatedProducts =
    product?.related_products ||
    [];

  const discount =
    comparePrice > price
      ? Math.round(
          ((comparePrice -
            price) /
            comparePrice) *
            100
        )
      : 0;

  const savingsAmount = comparePrice > price ? comparePrice - price : 0;

  const handleWishlistToggle = async () => {
    if (!product?.id) {
      return;
    }
    await toggleWishlist(product);
  };

  // ==========================================================
  // ADD TO CART
  // ==========================================================

  const handleAddToCart = () => {
    if (!product) {
      return;
    }

    addToCart(
      product,
      1,
      product.variant ?? null
    );
  };

  // ==========================================================
  // BUY NOW
  // ==========================================================

  const handleBuyNow = () => {
    if (!product) {
      return;
    }

    router.push({
      pathname: '/checkout',
      params: {
        buyNow: 'true',
        productId: String(product.id),
        productSlug: String(product.slug || slug),
        variantId: product.variant?.id
          ? String(product.variant.id)
          : '',
        quantity: '1',
      },
    });
  };

  // ==========================================================
  // INCREASE
  // ==========================================================

  const handleIncrease = () => {
    if (!cartItem) {
      return;
    }

    if (
      stock > 0 &&
      cartQuantity >= stock
    ) {
      return;
    }

    increaseQuantity(
      cartItem.itemKey
    );
  };

  // ==========================================================
  // DECREASE
  // ==========================================================

  const handleDecrease = () => {
    if (!cartItem) {
      return;
    }

    if (
      cartQuantity <= 1
    ) {
      removeFromCart(
        cartItem.itemKey
      );
      return;
    }

    decreaseQuantity(
      cartItem.itemKey
    );
  };

  // ==========================================================
  // LOADING STATE
  // ==========================================================

  if (slug && loading) {
    return (
      <SafeAreaView
        style={styles.screen}
        edges={['top', 'bottom']}
      >
        <View style={styles.center}>
          <View style={styles.loadingEmblem}>
            <ActivityIndicator
              size="large"
              color="#D9A52E"
            />
          </View>
          <Text style={styles.loadingBrand}>AUMVEDA</Text>
          <Text style={styles.loadingText}>
            Preparing botanical details...
          </Text>
        </View>
      </SafeAreaView>
    );
  }

  // ==========================================================
  // ERROR STATE
  // ==========================================================

  if (
    !slug ||
    error ||
    !product
  ) {
    return (
      <SafeAreaView
        style={styles.screen}
        edges={['top', 'bottom']}
      >
        <View style={styles.center}>
          <View style={styles.errorIconWrap}>
            <Ionicons
              name="leaf-outline"
              size={42}
              color="#D9A52E"
            />
          </View>

          <Text style={styles.errorTitle}>
            Product Unavailable
          </Text>

          <Text style={styles.errorText}>
            {error ||
              (!slug
                ? 'Product slug is missing.'
                : 'We could not load this Ayurvedic formulation.')}
          </Text>

          {slug && (
            <Pressable
              style={styles.retryButton}
              onPress={handleRetry}
            >
              <Text style={styles.retryText}>
                Retry Formulation
              </Text>
            </Pressable>
          )}
        </View>
      </SafeAreaView>
    );
  }

  // ==========================================================
  // UI
  // ==========================================================

  return (
    <SafeAreaView
      style={styles.screen}
      edges={['top', 'bottom']}
    >
      {/* =====================================================
          PREMIUM HEADER
      ===================================================== */}
      <View style={styles.header}>
        {/* BACK BUTTON */}
        <Pressable
          style={styles.headerButton}
          onPress={() => router.back()}
          hitSlop={8}
          accessibilityRole="button"
          accessibilityLabel="Go back"
        >
          <Ionicons
            name="arrow-back"
            size={20}
            color="#143828"
          />
        </Pressable>

        {/* TITLE / BRAND EMBLEM */}
        <View style={styles.headerTitleWrap}>
          <Text style={styles.headerEyebrow}>AUMVEDA BOTANICALS</Text>
          <Text
            style={styles.headerTitle}
            numberOfLines={1}
          >
            Pure Ayurveda
          </Text>
        </View>

        {/* RIGHT ACTIONS */}
        <View style={styles.headerActions}>
          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/search')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="Search products"
          >
            <Ionicons
              name="search-outline"
              size={19}
              color="#143828"
            />
          </Pressable>

          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/wishlist')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="View Wishlist"
          >
            <Ionicons
              name={isWishlisted(product?.id) ? 'heart' : 'heart-outline'}
              size={19}
              color={isWishlisted(product?.id) ? '#C2410C' : '#143828'}
            />
          </Pressable>

          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/cart')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel={`Cart with ${cartCount} items`}
          >
            <Ionicons
              name="cart-outline"
              size={19}
              color="#143828"
            />
            {cartCount > 0 && (
              <View style={styles.headerCartBadge}>
                <Text style={styles.headerCartBadgeText}>
                  {cartCount > 99 ? '99+' : cartCount}
                </Text>
              </View>
            )}
          </Pressable>
        </View>
      </View>

      {/* =====================================================
          SCROLL CONTENT
      ===================================================== */}
      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.scrollContent}
      >
        {/* ===================================================
            HERO PRODUCT IMAGE STAGE
        =================================================== */}
        <View
          style={[
            styles.imageStage,
            {
              height: imageHeight,
            },
          ]}
        >
          {/* Subtle gold concentric halo behind bottle */}
          <View style={styles.imageHaloOuter}>
            <View style={styles.imageHaloInner} />
          </View>

          {image ? (
            <Image
  source={{ uri: image }}
  style={styles.productImage}
  contentFit="contain"
  cachePolicy="memory-disk"
  transition={0}
/>
          ) : (
            <View style={styles.imagePlaceholder}>
              <Ionicons
                name="leaf-outline"
                size={64}
                color="#D9A52E"
              />
              <Text style={styles.placeholderText}>
                Authentic Formulation
              </Text>
            </View>
          )}

          {/* DISCOUNT BADGE */}
          {discount > 0 && (
            <View style={styles.discountBadge}>
              <Text style={styles.discountSparkle}>✦</Text>
              <Text style={styles.discountText}>
                {discount}% OFF
              </Text>
            </View>
          )}

          {/* FLOATING WISHLIST BUTTON */}
          <Pressable
            style={styles.favoriteButton}
            onPress={handleWishlistToggle}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="Toggle wishlist"
          >
            <Ionicons
              name={
                isWishlisted(product?.id)
                  ? 'heart'
                  : 'heart-outline'
              }
              size={21}
              color={
                isWishlisted(product?.id)
                  ? '#C2410C'
                  : '#123D2B'
              }
            />
          </Pressable>

          {/* AUTHENTICITY PILL AT BOTTOM OF IMAGE */}
          <View style={styles.authenticityPill}>
            <Ionicons
              name="shield-checkmark"
              size={13}
              color="#D9A52E"
            />
            <Text style={styles.authenticityPillText}>
              100% Certified Ayurvedic Formulation
            </Text>
          </View>
        </View>

        {/* ===================================================
            PRODUCT INFORMATION CONTAINER
        =================================================== */}
        <View style={styles.infoCard}>
          {/* CATEGORY & RATING ROW */}
          <View style={styles.eyebrowRow}>
            <Text style={styles.categoryLabel}>
              ✦ AYURVEDA WELLNESS ✦
            </Text>

            <View style={styles.ratingBox}>
              <Ionicons
                name="star"
                size={12}
                color="#D9A52E"
              />
              <Text style={styles.ratingValue}>
                {rating.toFixed(1)}
              </Text>
              <Text style={styles.reviewCount}>
                ({reviewCount})
              </Text>
            </View>
          </View>

          {/* PRODUCT NAME */}
          <Text style={styles.productName}>
            {product.name}
          </Text>

          {/* PRICE ROW */}
          <View style={styles.priceContainer}>
            <View style={styles.priceRow}>
              <Text style={styles.priceCurrency}>₹</Text>
              <Text style={styles.priceValue}>
                {price.toLocaleString('en-IN')}
              </Text>

              {comparePrice > price && (
                <Text style={styles.comparePrice}>
                  ₹{comparePrice.toLocaleString('en-IN')}
                </Text>
              )}

              {savingsAmount > 0 && (
                <View style={styles.savingsPill}>
                  <Text style={styles.savingsPillText}>
                    Save ₹{savingsAmount.toLocaleString('en-IN')}
                  </Text>
                </View>
              )}
            </View>

            <Text style={styles.taxInclusiveText}>
              Inclusive of all taxes • Free express shipping
            </Text>
          </View>

          {/* VARIANT / SIZE */}
          {variantName ? (
            <View style={styles.variantContainer}>
              <Text style={styles.variantLabel}>Select Size / Variant</Text>
              <View style={styles.variantBadge}>
                <Ionicons
                  name="leaf"
                  size={13}
                  color="#D9A52E"
                />
                <Text style={styles.variantText}>
                  {variantName}
                </Text>
              </View>
            </View>
          ) : null}

          {/* 3-PILLAR BOTANICAL TRUST ROW */}
          <View style={styles.trustRow}>
            <View style={styles.trustItem}>
              <View style={styles.trustIconCircle}>
                <Ionicons
                  name="leaf-outline"
                  size={16}
                  color="#123D2B"
                />
              </View>
              <Text style={styles.trustTitle}>Pure Herbs</Text>
              <Text style={styles.trustSubtitle}>Zero Additives</Text>
            </View>

            <View style={styles.trustDivider} />

            <View style={styles.trustItem}>
              <View style={styles.trustIconCircle}>
                <Ionicons
                  name="flask-outline"
                  size={16}
                  color="#143828"
                />
              </View>
              <Text style={styles.trustTitle}>Vedic Recipe</Text>
              <Text style={styles.trustSubtitle}>Lab Tested</Text>
            </View>

            <View style={styles.trustDivider} />

            <View style={styles.trustItem}>
              <View style={styles.trustIconCircle}>
                <Ionicons
                  name="cube-outline"
                  size={16}
                  color="#143828"
                />
              </View>
              <Text style={styles.trustTitle}>Free Express</Text>
              <Text style={styles.trustSubtitle}>Fast Dispatch</Text>
            </View>
          </View>

          {/* DESCRIPTION SECTION */}
          {product.description ? (
            <View style={styles.descriptionSection}>
              <View style={styles.sectionHeaderRow}>
                <View style={styles.sectionTitleDot} />
                <Text style={styles.sectionTitle}>
                  About This Formulation
                </Text>
              </View>

              <Text style={styles.description}>
                {product.description}
              </Text>
            </View>
          ) : null}

          {/* STOCK STATUS */}
          <View style={styles.stockRow}>
            <View
              style={[
                styles.stockDot,
                { backgroundColor: stock > 0 ? '#10B981' : '#EF4444' },
              ]}
            />
            <Text
              style={
                stock > 0
                  ? styles.inStock
                  : styles.outOfStock
              }
            >
              {stock > 0
                ? `${stock} units available — in stock`
                : 'Temporarily out of stock'}
            </Text>
          </View>

          {/* QUANTITY CONTROLS (IF ALREADY IN CART) */}
          {isInCart && (
            <View style={styles.quantitySection}>
              <Text style={styles.quantityLabel}>
                Quantity in Your Cart
              </Text>

              <View style={styles.quantityControl}>
                <Pressable
                  style={styles.quantityButton}
                  onPress={handleDecrease}
                  hitSlop={6}
                  accessibilityRole="button"
                  accessibilityLabel="Decrease quantity"
                >
                  <Ionicons
                    name="remove"
                    size={17}
                    color="#143828"
                  />
                </Pressable>

                <Text style={styles.quantityValue}>
                  {cartQuantity}
                </Text>

                <Pressable
                  style={styles.quantityButton}
                  onPress={handleIncrease}
                  hitSlop={6}
                  accessibilityRole="button"
                  accessibilityLabel="Increase quantity"
                >
                  <Ionicons
                    name="add"
                    size={17}
                    color="#143828"
                  />
                </Pressable>
              </View>
            </View>
          )}

          {/* ACTION BUTTONS (ADD TO CART + BUY NOW) */}
          <View style={styles.actionRow}>
            {!isInCart ? (
              <Pressable
                style={[
                  styles.addButton,
                  stock <= 0 && styles.disabledButton,
                ]}
                onPress={handleAddToCart}
                disabled={stock <= 0}
              >
                <Ionicons
                  name="bag-add-outline"
                  size={18}
                  color="#D4AF37"
                />
                <Text style={styles.addButtonText}>
                  Add to Cart
                </Text>
              </Pressable>
            ) : (
              <View style={styles.addedButton}>
                <Ionicons
                  name="checkmark-circle"
                  size={18}
                  color="#10B981"
                />
                <Text style={styles.addedButtonText}>
                  Added ({cartQuantity})
                </Text>
              </View>
            )}

            <Pressable
              style={[
                styles.buyButtonWrap,
                stock <= 0 && styles.disabledButton,
              ]}
              onPress={handleBuyNow}
              disabled={stock <= 0}
            >
              <LinearGradient
                colors={['#F7DF9B', '#D9A52E', '#B8821F']}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 1 }}
                style={styles.buyButtonGradient}
              >
                <Text style={styles.buyButtonText}>
                  Buy Now
                </Text>
                <Ionicons
                  name="arrow-forward"
                  size={16}
                  color="#123D2B"
                />
              </LinearGradient>
            </Pressable>
          </View>

          {/* CART STATUS BADGE */}
          {isInCart && (
            <View style={styles.cartStatus}>
              <Ionicons
                name="checkmark-circle"
                size={15}
                color="#10B981"
              />
              <Text style={styles.cartStatusText}>
                {cartQuantity} {cartQuantity === 1 ? 'item' : 'items'} currently in your cart
              </Text>
            </View>
          )}
        </View>

        {/* ===================================================
            CUSTOMER REVIEWS
        =================================================== */}
        <View style={styles.reviewsSection}>
          <View style={styles.reviewsHeader}>
            <View>
              <Text style={styles.reviewsEyebrow}>
                CUSTOMER EXPERIENCES
              </Text>
              <Text style={styles.reviewsTitle}>
                Reviews &amp; Ratings
              </Text>
            </View>

            <View style={styles.reviewsSummary}>
              <Ionicons name="star" size={16} color="#D9A52E" />
              <Text style={styles.reviewsAverage}>
                {rating.toFixed(1)}
              </Text>
              <Text style={styles.reviewsTotal}>
                ({reviewCount})
              </Text>
            </View>
          </View>

          {/* SUBMIT A REVIEW */}
          <View style={styles.reviewForm}>
            <Text style={styles.reviewFormTitle}>
              Share Your Experience
            </Text>
            <Text style={styles.reviewFormHint}>
              Tell us about your experience with this product.
            </Text>

            <Text style={styles.reviewFieldLabel}>Your Rating</Text>
            <View style={styles.reviewStars}>
              {[1, 2, 3, 4, 5].map((star) => (
                <Pressable
                  key={star}
                  onPress={() => setReviewRating(star)}
                  disabled={reviewSubmitting}
                  accessibilityRole="button"
                  accessibilityLabel={`${star} star${star > 1 ? 's' : ''}`}
                  style={styles.reviewStarButton}
                >
                  <Ionicons
                    name={star <= reviewRating ? 'star' : 'star-outline'}
                    size={30}
                    color="#D9A52E"
                  />
                </Pressable>
              ))}
            </View>

            <Text style={styles.reviewFieldLabel}>
              Review Title (Optional)
            </Text>
            <TextInput
              value={reviewTitle}
              onChangeText={setReviewTitle}
              placeholder="Summarize your experience"
              placeholderTextColor="#96938B"
              maxLength={150}
              editable={!reviewSubmitting}
              style={styles.reviewInput}
            />

            <Text style={styles.reviewFieldLabel}>
              Your Feedback (Optional)
            </Text>
            <TextInput
              value={reviewText}
              onChangeText={setReviewText}
              placeholder="What did you like about this product?"
              placeholderTextColor="#96938B"
              maxLength={3000}
              multiline
              textAlignVertical="top"
              editable={!reviewSubmitting}
              style={[styles.reviewInput, styles.reviewTextArea]}
            />

            {!!reviewError && (
              <Text style={styles.reviewError}>{reviewError}</Text>
            )}

            {!!reviewMessage && (
              <Text style={styles.reviewSuccess}>{reviewMessage}</Text>
            )}

            <Pressable
              style={[
                styles.reviewSubmitButton,
                reviewSubmitting && styles.reviewSubmitDisabled,
              ]}
              onPress={handleSubmitReview}
              disabled={reviewSubmitting}
              accessibilityRole="button"
            >
              {reviewSubmitting ? (
                <ActivityIndicator color="#FFFFFF" />
              ) : (
                <Text style={styles.reviewSubmitText}>
                  Submit Review
                </Text>
              )}
            </Pressable>

            <Text style={styles.reviewApprovalNote}>
              Reviews are published after approval. You must have purchased this product to review it.
            </Text>
          </View>

          {/* APPROVED REVIEWS */}
          <View style={styles.reviewList}>
            <Text style={styles.reviewListTitle}>
              Customer Feedback
            </Text>

            {reviewsLoading ? (
              <ActivityIndicator color="#123D2B" />
            ) : reviewCount === 0 ? (
              <Text style={styles.reviewEmpty}>
                No approved reviews yet. Be the first to share your experience.
              </Text>
            ) : (
              reviews.map((review) => (
                <View key={review.id} style={styles.reviewCard}>
                  <View style={styles.reviewCardTop}>
                    <View style={styles.reviewRatingStars}>
                      {[1, 2, 3, 4, 5].map((star) => (
                        <Ionicons
                          key={star}
                          name={
                            star <= Number(review.rating)
                              ? 'star'
                              : 'star-outline'
                          }
                          size={14}
                          color="#D9A52E"
                        />
                      ))}
                    </View>

                    {review.created_at ? (
                      <Text style={styles.reviewDate}>
                        {new Date(review.created_at).toLocaleDateString(
                          'en-IN'
                        )}
                      </Text>
                    ) : null}
                  </View>

                  {review.title ? (
                    <Text style={styles.reviewCardTitle}>
                      {review.title}
                    </Text>
                  ) : null}

                  {review.review_text ? (
                    <Text style={styles.reviewCardText}>
                      {review.review_text}
                    </Text>
                  ) : null}
                </View>
              ))
            )}
          </View>
        </View>

        {/* ===================================================
            RELATED PRODUCTS ("COMPLETE YOUR RITUAL")
        =================================================== */}
        {relatedProducts.length > 0 && (
          <View style={styles.relatedSection}>
            <View style={styles.relatedHeader}>
              <Text style={styles.relatedEyebrow}>
                ✦ COMPLETE YOUR RITUAL ✦
              </Text>
              <Text style={styles.relatedTitle}>
                Related Formulations
              </Text>
            </View>

            <View style={styles.relatedGrid}>
              {relatedProducts.map((item) => (
                <ProductCard
                  key={item.id}
                  product={item}
                  onPress={() =>
                    router.push({
                      pathname: '/products/[slug]',
                      params: {
                        slug: item.slug,
                      },
                    })
                  }
                />
              ))}
            </View>
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

