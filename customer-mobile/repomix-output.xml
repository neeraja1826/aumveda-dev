import React, { useState } from 'react';

import {
  Alert,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import {
  Link,
  useLocalSearchParams,
  useRouter,
} from 'expo-router';

import AppButton from '../components/common/AppButton';
import AppTextInput from '../components/common/AppTextInput';

import { useAuth } from '../context/AuthContext';
import { signInWithGoogle } from '../services/googleAuth';
import { colors } from '../theme/colors';

export default function LoginScreen() {
  const router = useRouter();
  const { returnTo } = useLocalSearchParams();
  const postLoginRoute = returnTo === '/checkout' ? '/checkout' : '/(tabs)';

  const { login, loginWithGoogleSession } = useAuth();

  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);

  async function handleLogin() {
    if (!email || !password) {
      Alert.alert(
        'Required',
        'Please enter your email and password.'
      );
      return;
    }

    try {
      setLoading(true);

      await login(
        email.trim(),
        password
      );

      router.replace(postLoginRoute);
    } catch (error) {
      Alert.alert(
        'Login failed',
        error?.message || 'Unable to login. Please try again.'
      );
    } finally {
      setLoading(false);
    }
  }

  return (
    <SafeAreaView
      style={styles.container}
      edges={['top', 'bottom']}
    >
      <KeyboardAvoidingView
        style={styles.container}
        behavior={
          Platform.OS === 'ios'
            ? 'padding'
            : undefined
        }
      >
        <ScrollView
          contentContainerStyle={styles.content}
          keyboardShouldPersistTaps="handled"
          showsVerticalScrollIndicator={false}
        >
          {/* Decorative circles */}
          <View style={styles.decorCircleLarge} />
          <View style={styles.decorCircleSmall} />

          {/* Main authentication card */}
          <View style={styles.authCard}>

            {/* Brand section */}
            <View style={styles.brandSection}>
              <View style={styles.brandMark}>
                <Text style={styles.brandMarkText}>
                  A
                </Text>
              </View>

              <Text style={styles.eyebrow}>
                NATURAL WELLNESS
              </Text>

              <Text style={styles.brand}>
                AUMVEDA
              </Text>

              <Text style={styles.brandDescription}>
                Rooted in nature. Guided by Ayurveda.
              </Text>
            </View>

            {/* Form */}
            <View style={styles.formSection}>

              <View style={styles.heading}>
                <Text style={styles.headingEyebrow}>
                  WELCOME BACK
                </Text>

                <Text style={styles.title}>
                  Sign in
                </Text>

                <Text style={styles.subtitle}>
                  Sign in to continue your wellness journey.
                </Text>
              </View>

              <View style={styles.form}>

                <AppTextInput
                  label="Email Address"
                  value={email}
                  onChangeText={setEmail}
                  placeholder="Enter your email"
                  keyboardType="email-address"
                  autoCapitalize="none"
                />

                <AppTextInput
                  label="Password"
                  value={password}
                  onChangeText={setPassword}
                  placeholder="Enter your password"
                  secureTextEntry
                />

                <Link
                  href={{
                    pathname: '/(auth)/forgot-password',
                    params: { returnTo: postLoginRoute },
                  }}
                  style={styles.forgot}
                >
                  Forgot Password?
                </Link>

                <View style={styles.buttonWrapper}>
                  <AppButton
                    title="Login"
                    onPress={handleLogin}
                    loading={loading}
                  />
                </View>

                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.8}
                  style={styles.googleButton}

                  onPress={async () => {
                    try {
                      setLoading(true);

                      console.log('Starting Google sign-in');

                      const { session, error, cancelled } = await signInWithGoogle();

                      console.log('Google sign-in result:', {
                        hasSession: !!session,
                        cancelled,
                        error: error?.message ?? null,
                      });

                      if (error) {
                        Alert.alert('Google Sign-In Failed', error.message);
                        return;
                      }

                      if (cancelled) {
                        console.log('Google sign-in was cancelled');
                        return;
                      }

                      if (session) {
                        await loginWithGoogleSession(session);
                        router.replace(postLoginRoute);
                      } else {
                        Alert.alert(
                          'Sign-in incomplete',
                          'Google sign-in finished without an authenticated session. Please try again.'
                        );
                      }
                    } catch (error) {
                      console.error('Google button error:', error);
                      Alert.alert(
                        'Google Sign-In Failed',
                        error?.message || 'Please try again.'
                      );
                    } finally {
                      setLoading(false);
                    }
                  }}

                >
                  <Text style={styles.googleButtonText}>
                    Continue with Google
                  </Text>
                </TouchableOpacity>
              </View>

              {/* Account switch */}
              <View style={styles.accountSwitch}>
                <Text style={styles.accountText}>
                  Don&apos;t have an account?
                </Text>

                <Link
                  href="/(auth)/register"
                  style={styles.accountLink}
                >
                  Create Account
                </Link>
              </View>

              <View style={styles.footerNote}>
                <View style={styles.footerDot} />

                <Text style={styles.footerText}>
                  Mindful wellness, naturally
                </Text>

                <View style={styles.footerDot} />
              </View>

            </View>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: colors.background,
  },

  content: {
    flexGrow: 1,
    justifyContent: 'center',
    paddingHorizontal: 16,
    paddingVertical: 30,
    overflow: 'hidden',
  },

  decorCircleLarge: {
    position: 'absolute',
    width: 300,
    height: 300,
    borderRadius: 150,
