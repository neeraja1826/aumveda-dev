      ) : null}

      {/* HAIRLINE DIVIDER */}
      <View style={styles.cardDivider} />

      {/* 2. MAIN ITEM ROW: COMPACT THUMBNAIL + CONCISE PRODUCT DETAILS */}
      <View style={styles.productSection}>
        <View style={styles.thumbnailBox}>
          {productImage ? (
            <Image
              source={{ uri: productImage }}
