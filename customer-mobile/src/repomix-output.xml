    console.log('Review GET response:', responseText);

console.log('Review API status:', response.status);
console.log('Review API response:', responseText);
    if (!response.ok) {
      throw new Error(
        `Unable to load product reviews (${response.status}).`
      );
    }

    let result;

    try {
