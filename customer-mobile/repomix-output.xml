            </View>
            <View style={styles.trustDivider} />
            <View style={styles.trustItem}>
              <Ionicons name="sparkles-outline" size={13} color={colors.primary} />
              <Text style={styles.trustText}>Fast Delivery</Text>
            </View>
          </View>
        </View>
      </View>
    );
  };

  // -----------------------------------------
  // MAIN SCREEN
  // -----------------------------------------
  return (
    <View style={styles.container}>
