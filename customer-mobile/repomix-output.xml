              >
                <Ionicons
                  name={
                    form.marketingOptIn
                      ? 'checkbox'
                      : 'square-outline'
                  }
                  size={22}
                  color={
                    form.marketingOptIn
                      ? colors.primary
                      : colors.textSecondary
                  }
                />
                <View style={styles.marketingText}>
                  <Text style={styles.marketingTitle}>Product Updates</Text>
                  <Text style={styles.marketingDescription}>
                    Receive product announcements, new arrivals and special offers.
                  </Text>
                </View>
              </Pressable>
            </View>
          )}

          <View style={styles.actions}>
            <Pressable
              accessibilityRole="button"
              onPress={() => router.back()}
              disabled={saving}
              style={[styles.cancelButton, saving && styles.disabledControl]}
            >
              <Text style={styles.cancelButtonText}>Cancel</Text>
            </Pressable>

            <Pressable
              accessibilityRole="button"
              onPress={handleSave}
              disabled={fieldsDisabled}
              style={[styles.saveButton, fieldsDisabled && styles.disabledControl]}
            >
              {saving ? (
                <ActivityIndicator color={colors.white} />
              ) : (
                <>
                  <Ionicons name="save-outline" size={17} color={colors.white} />
                  <Text style={styles.saveButtonText}>Save Changes</Text>
                </>
              )}
            </Pressable>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>

      {Platform.OS === 'android' && datePickerVisible && (
        <DateTimePicker
          value={pendingDate}
          mode="date"
          display="calendar"
          presentation="dialog"
          accentColor={colors.primary}
          themeVariant="light"
          onValueChange={(_, date) => saveSelectedDate(date)}
          onDismiss={() => setDatePickerVisible(false)}
          positiveButton={{ label: 'Done' }}
          negativeButton={{ label: 'Cancel' }}
        />
      )}

      {Platform.OS === 'ios' && (
        <Modal
          transparent
          animationType="fade"
          visible={datePickerVisible}
          onRequestClose={() => setDatePickerVisible(false)}
        >
          <View style={styles.datePickerOverlay}>
            <Pressable
              style={StyleSheet.absoluteFillObject}
              onPress={() => setDatePickerVisible(false)}
              accessibilityLabel="Close date picker"
            />
            <View style={styles.datePickerSheet}>
              <View style={styles.datePickerHeader}>
                <Pressable
                  accessibilityRole="button"
                  onPress={() => setDatePickerVisible(false)}
                  hitSlop={8}
                >
                  <Text style={styles.datePickerCancel}>Cancel</Text>
                </Pressable>
                <Text style={styles.datePickerTitle}>Date of Birth</Text>
                <Pressable
                  accessibilityRole="button"
                  onPress={() => saveSelectedDate(pendingDate)}
                  hitSlop={8}
                >
                  <Text style={styles.datePickerDone}>Done</Text>
                </Pressable>
              </View>
              <DateTimePicker
                value={pendingDate}
                mode="date"
                display="inline"
                accentColor={colors.primary}
                themeVariant="light"
                onValueChange={(_, date) => setPendingDate(date)}
              />
            </View>
          </View>
        </Modal>
      )}
    </SafeAreaView>
  );
}

