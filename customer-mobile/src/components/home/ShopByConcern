                    borderColor: theme.border,
                  },
                  pressed && styles.cardPressed,
                ]}
                accessibilityRole="button"
                accessibilityLabel={`Shop ${item.name} concern`}
              >
                <View
                  style={[
                    styles.compactIconWrap,
                    { backgroundColor: theme.iconBg },
                  ]}
                >
                  {item.image_url ? (
                    <Image
                      source={{ uri: item.image_url }}
                      style={styles.compactImage}
                      contentFit="cover"
                      transition={150}
                    />
                  ) : (
                    <Ionicons
                      name={icon}
                      size={14}
                      color={theme.accent}
                    />
                  )}
                </View>

                <Text
                  style={[
                    styles.compactName,
                    { color: theme.accent },
                  ]}
                  numberOfLines={2}
                >
                  {item.name}
                </Text>
              </Pressable>
            );
          }

          // VARIANT 4: MEDIUM (Half-Width Balanced)
