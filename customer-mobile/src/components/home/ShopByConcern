                accessibilityRole="button"
                accessibilityLabel={`Shop ${item.name} concern`}
              >
                <View style={styles.wideTopRow}>
                  <View
                    style={[
                      styles.concernTag,
                      { backgroundColor: theme.tagBg },
                    ]}
                  >
                    <Text
                      style={[
                        styles.concernTagText,
                        { color: theme.tagText },
                      ]}
                    >
                      AYURVEDIC CARE
                    </Text>
                  </View>

                  <View
                    style={[
                      styles.minimalIconWrap,
                      { backgroundColor: theme.iconBg },
                    ]}
                  >
                    {item.image_url ? (
                      <Image
                        source={{ uri: item.image_url }}
                        style={styles.minimalImage}
                        contentFit="cover"
                        transition={150}
                      />
                    ) : (
                      <Ionicons
                        name={icon}
                        size={15}
                        color={theme.accent}
                      />
                    )}
                  </View>
                </View>

                <View style={styles.wideBottomRow}>
                  <Text
                    style={[
                      styles.wideName,
                      { color: theme.accent },
                    ]}
                    numberOfLines={2}
                  >
                    {item.name}
                  </Text>

                  <View
                    style={[
                      styles.arrowCircle,
                      { backgroundColor: theme.iconBg },
                    ]}
                  >
                    <Ionicons
                      name="arrow-forward"
                      size={11}
                      color={theme.accent}
                    />
                  </View>
                </View>
              </Pressable>
            );
          }

          // VARIANT 2: TALL (High Height / Vertical Focus)
          if (config.variant === 'tall') {
            return (
              <Pressable
                key={item.id}
                onPress={() => onSelectConcern?.(item)}
                style={({ pressed }) => [
                  styles.cardBase,
                  styles.tallCard,
                  {
                    width: config.width,
                    minHeight: config.minHeight,
                    backgroundColor: theme.bg,
                    borderColor: theme.border,
                  },
                  pressed && styles.cardPressed,
