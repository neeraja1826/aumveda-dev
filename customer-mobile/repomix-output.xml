                </Text>

                <Ionicons
                  name="arrow-forward"
                  size={17}
                  color="#FFFFFF"
                />
              </Pressable>

              <Pressable
                style={styles.textButton}
                onPress={openEmail}
              >
                <Text style={styles.textButtonText}>
                  Email AUMVEDA
                </Text>

                <Ionicons
                  name="mail-outline"
                  size={15}
                  color="#DDE8DE"
                />
              </Pressable>
            </View>
          </View>

          {/* =================================================
