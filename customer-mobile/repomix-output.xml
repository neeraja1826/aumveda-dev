                with checkout.
              </Text>
            )}

            {addresses.map((address) => {
              const isDefault =
                Boolean(
                  address?.is_default
                );

              return (
                <Pressable
                  key={address.id}
                  style={[
                    styles.addressCard,
                    isDefault &&
                      styles.defaultCard,
                  ]}
                  onPress={() =>
                    handleSelectAddress(
                      address
                    )
                  }
                >
                  <View
                    style={
                      styles.addressTopRow
                    }
                  >
                    <View
                      style={
                        styles.addressIcon
                      }
                    >
                      <Ionicons
