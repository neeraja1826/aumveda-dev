    color: colors.textSecondary,
    fontSize: 15,
    lineHeight: 23,
    marginBottom: 20,
  },
  option: {
    minHeight: 58,
    paddingHorizontal: 16,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    borderRadius: 14,
