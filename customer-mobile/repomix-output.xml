                          address?.label
                            ?.toLowerCase()
                            .includes(
                              'office'
                            )
                            ? 'business-outline'
                            : 'home-outline'
                        }
                        size={19}
                        color={
                          colors.primary
                        }
                      />
                    </View>

                    <View
                      style={
                        styles.addressHeading
                      }
                    >
                      <Text
