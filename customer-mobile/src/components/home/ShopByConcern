            >
              <View style={styles.mediumTopRow}>
                <View
                  style={[
                    styles.minimalIconWrap,
                    { backgroundColor: theme.iconBg },
                  ]}
                >
                  {item.image_url ? (
                    <Image
                      source={{ uri: item.image_url }}
                      style={styles.minimalImage}
                      contentFit="cover"
                      transition={150}
                    />
                  ) : (
                    <Ionicons
                      name={icon}
                      size={15}
                      color={theme.accent}
                    />
                  )}
                </View>

                <View
                  style={[
                    styles.arrowCircle,
                    { backgroundColor: theme.iconBg },
