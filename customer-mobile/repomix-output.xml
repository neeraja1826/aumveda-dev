              <Pressable
                accessibilityRole="checkbox"
                accessibilityState={{ checked: form.marketingOptIn }}
                disabled={fieldsDisabled}
                onPress={() =>
                  updateField('marketingOptIn', !form.marketingOptIn)
                }
                style={[
                  styles.marketingRow,
                  fieldsDisabled && styles.disabledControl,
