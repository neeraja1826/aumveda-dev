{
  "expo": {
    "name": "Aumveda Wellness",
    "slug": "customer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aumveda",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app-icon.png",

    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.aumveda.wellness",

      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png"
      },

      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "aumveda",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash screen.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F1E8"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-notifications"
    ],

    "web": {
      "output": "static",
      "bundler": "metro"
    },

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}