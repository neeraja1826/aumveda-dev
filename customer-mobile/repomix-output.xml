                </View>
                <View style={styles.metricDivider} />
                <View style={styles.metricItem}>
                  <Text style={styles.metricLabel}>PAYMENT</Text>
                  <Text style={styles.metricValue} numberOfLines={1}>
                    {String(order.payment_status || 'Pending').replaceAll('_', ' ')}
