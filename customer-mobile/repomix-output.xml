          <MaterialCommunityIcons
            name="leaf"
            size={14}
            color="#8C4E3A"
            style={styles.motifLeftLeaf}
          />
          <MaterialCommunityIcons
            name="leaf"
            size={14}
            color="#8C4E3A"
            style={styles.motifRightLeaf}
