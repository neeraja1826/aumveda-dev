              </View>

              <Text style={styles.label}>Date of Birth</Text>
              <View style={styles.inputWrap}>
                <Ionicons
                  name="calendar-outline"
                  size={18}
                  color={colors.textSecondary}
                />
                {Platform.OS === 'web' ? (
                  <TextInput
                    value={form.dateOfBirth}
