                uri: imageUrl,
              }}
              style={styles.categoryImage}
              resizeMode="cover"
            />

          ) : (

            <View style={styles.imagePlaceholder}>

              <Ionicons
                name="leaf-outline"
                size={38}
                color="#174B35"
              />

            </View>

