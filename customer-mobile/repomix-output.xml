          <View style={styles.qtyPriceRow}>
            <View style={styles.qtyBadge}>
              <Text style={styles.qtyBadgeText}>Qty: {quantity}</Text>
            </View>

            <Text style={styles.productPrice}>
              {formatAmount(itemPrice, order.currency || 'INR')}
