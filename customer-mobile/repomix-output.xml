                        <Text style={styles.unreadLabel}>NEW</Text>
                      )}
                    </View>
                    <Text style={styles.notificationTitle}>
                      {notification.title || 'Notification'}
                    </Text>
                    <Text style={styles.notificationMessage} numberOfLines={2}>
                      {notification.message || ''}
                    </Text>
