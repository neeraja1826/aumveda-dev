              return (
                <View key={item.id || `${item.product_id || 'item'}-${index}`}>
                  {/* PRODUCT ITEM ROW */}
                  <TouchableOpacity
                    style={styles.productRow}
                    onPress={() => {
                      if (!productSlug) {
                        console.warn(
                          'Order product does not have a slug:',
                          item
                        );
                        return;
                      }

                      router.push({
                        pathname: '/products/[slug]',
                        params: { slug: String(productSlug) },
                      });
                    }}
                    activeOpacity={0.8}
                    accessibilityRole="button"
                  >
                    {/* THUMBNAIL */}
                    <View style={styles.productThumbWrap}>
                      {imageUrl ? (
                        <Image
                          source={{ uri: imageUrl }}
                          style={styles.productThumb}
                          resizeMode="contain"
                        />
                      ) : (
                        <View style={styles.thumbPlaceholder}>
                          <Ionicons name="leaf-outline" size={24} color="#123D2B" />
                        </View>
                      )}
                    </View>

                    {/* PRODUCT DETAILS */}
                    <View style={styles.productInfoWrap}>
                      <Text style={styles.productTitle} numberOfLines={2}>
                        {item.product_name || item.product_id || 'Ayurvedic Botanical'}
                      </Text>

                      {/* VARIANT PILL (e.g. 50 g) */}
                      <View style={styles.variantPill}>
                        <Text style={styles.variantPillText}>
                          {item.variant_name || '50 g'}
                        </Text>
                      </View>

                      {/* QTY */}
                      <Text style={styles.qtyText}>Qty: {quantity}</Text>
                    </View>

                    {/* PRICE ALIGNED ON THE RIGHT */}
                    <Text style={styles.productPrice}>
                      {formatAmount(lineTotal, currency)}
                    </Text>
                  </TouchableOpacity>

                  {/* RETURN / REPLACEMENT ACTION IF DELIVERED */}
                  {canRequestReturn ? (
                    <View style={styles.returnActionWrap}>
                      <TouchableOpacity
                        style={styles.returnActionButton}
                        onPress={() => {
                          setReturnFormItemId(isFormOpen ? null : item.id);
                          setReturnType('return');
                          setReturnQuantity('1');
                          setReturnReason('damaged_product');
                          setReturnDescription('');
                          setReturnSubmitError('');
                          setReturnSubmitSuccess('');
                        }}
                        activeOpacity={0.8}
                      >
                        <Ionicons
                          name={isFormOpen ? 'close' : 'return-down-back-outline'}
                          size={14}
                          color="#123D2B"
                        />
                        <Text style={styles.returnActionText}>
                          {isFormOpen ? 'Cancel Request' : 'Request Return or Exchange'}
                        </Text>
                      </TouchableOpacity>

                      {isFormOpen ? (
                        <View style={styles.returnForm}>
                          <Text style={styles.formLabel}>REQUEST TYPE</Text>
                          <View style={styles.choiceRow}>
                            {[
                              { label: 'Return & Refund', value: 'return' },
                              { label: 'Exchange', value: 'replacement' },
                            ].map((choice) => (
                              <TouchableOpacity
                                key={choice.value}
                                style={[
                                  styles.choiceButton,
                                  returnType === choice.value &&
                                    styles.choiceButtonActive,
                                ]}
                                onPress={() => setReturnType(choice.value)}
                              >
                                <Text
                                  style={[
                                    styles.choiceButtonText,
                                    returnType === choice.value &&
                                      styles.choiceButtonTextActive,
                                  ]}
                                >
                                  {choice.label}
                                </Text>
                              </TouchableOpacity>
                            ))}
                          </View>

                          <Text style={styles.formLabel}>
                            QUANTITY (MAX {quantity})
                          </Text>
                          <TextInput
                            value={returnQuantity}
                            onChangeText={setReturnQuantity}
                            keyboardType="number-pad"
                            maxLength={String(quantity).length || 1}
                            style={styles.formInput}
                            placeholder="Enter quantity"
                            placeholderTextColor="#8F8D85"
                          />

                          <Text style={styles.formLabel}>REASON</Text>
                          <View style={styles.reasonChoices}>
                            {[
                              {
                                label: 'Damaged Product',
                                value: 'damaged_product',
                              },
                              { label: 'Wrong Item', value: 'wrong_item' },
                              {
                                label: 'Quality Issue',
                                value: 'quality_issue',
                              },
                              { label: 'Other', value: 'other' },
                            ].map((choice) => (
                              <TouchableOpacity
                                key={choice.value}
                                style={[
                                  styles.reasonChip,
                                  returnReason === choice.value &&
                                    styles.reasonChipActive,
                                ]}
                                onPress={() => setReturnReason(choice.value)}
                              >
                                <Text
                                  style={[
                                    styles.reasonChipText,
                                    returnReason === choice.value &&
                                      styles.reasonChipTextActive,
                                  ]}
                                >
                                  {choice.label}
                                </Text>
                              </TouchableOpacity>
                            ))}
                          </View>

                          <Text style={styles.formLabel}>
                            ADDITIONAL DETAILS (OPTIONAL)
                          </Text>
                          <TextInput
                            value={returnDescription}
                            onChangeText={setReturnDescription}
                            multiline
                            maxLength={1000}
                            placeholder="Please describe any issues..."
                            placeholderTextColor="#8F8D85"
                            style={[styles.formInput, styles.descriptionInput]}
                            textAlignVertical="top"
                          />

                          {returnSubmitError ? (
                            <Text style={styles.formError}>
                              {returnSubmitError}
                            </Text>
                          ) : null}

                          <TouchableOpacity
                            style={[
                              styles.submitButton,
                              returnSubmitting && styles.buttonDisabled,
                            ]}
                            disabled={returnSubmitting}
                            onPress={() => submitReturnRequest(item)}
                          >
                            {returnSubmitting ? (
                              <ActivityIndicator color="#FFFFFF" size="small" />
                            ) : (
                              <Text style={styles.submitButtonText}>
                                Submit Request
                              </Text>
                            )}
                          </TouchableOpacity>
                        </View>
                      ) : null}
                    </View>
                  ) : existingRequest ? (
                    <View
                      style={[
                        styles.existingRequestBadge,
                        { backgroundColor: returnStatus.backgroundColor },
                      ]}
                    >
                      <Ionicons
                        name={returnStatus.icon}
                        size={14}
                        color={returnStatus.color}
                      />
                      <View style={styles.existingRequestInfo}>
                        <Text style={styles.existingRequestText}>
                          {existingRequest.request_type === 'replacement'
                            ? 'Exchange request'
                            : 'Return request'}
                        </Text>
                        <Text
                          style={[
                            styles.existingRequestStatus,
                            { color: returnStatus.color },
                          ]}
                        >
                          {returnStatus.label}
                        </Text>
                        {returnSubmitSuccess ? (
                          <Text style={styles.returnSubmitSuccessText}>
                            {returnSubmitSuccess}
                          </Text>
                        ) : null}
                        <ReturnRequestTracking request={existingRequest} />
                      </View>
                    </View>
                  ) : returnLoading ? (
                    <View style={styles.returnStatusNotice}>
                      <ActivityIndicator size="small" color="#A87E34" />
                      <Text style={styles.returnStatusNoticeText}>
                        Checking return request status...
                      </Text>
                    </View>
                  ) : returnError ? (
                    <Text style={styles.returnStatusError}>{returnError}</Text>
                  ) : null}

                  {itemReview ? (
                    <View style={styles.orderReviewCard}>
                      <Text style={styles.orderReviewHeading}>Your review</Text>
                      <View
                        style={styles.reviewStars}
                        accessibilityLabel={`${itemReview.rating} out of 5 stars`}
                      >
                        {[1, 2, 3, 4, 5].map((star) => (
                          <Ionicons
                            key={star}
                            name={
                              star <= Number(itemReview.rating)
                                ? 'star'
                                : 'star-outline'
                            }
                            size={16}
                            color="#D9A52E"
                          />
                        ))}
                      </View>
                      {itemReview.title ? (
                        <Text style={styles.orderReviewTitle}>
                          {itemReview.title}
                        </Text>
                      ) : null}
                      {itemReview.review_text ? (
                        <Text style={styles.orderReviewText}>
                          {itemReview.review_text}
                        </Text>
                      ) : null}
                      {itemReview.created_at ? (
                        <Text style={styles.orderReviewDate}>
                          {new Date(itemReview.created_at).toLocaleDateString('en-IN')}
                        </Text>
                      ) : null}
                    </View>
                  ) : isDelivered &&
                    item.id &&
                    reviewProductId &&
                    Array.isArray(orderReviews) ? (
                    <View style={styles.returnActionWrap}>
                      <TouchableOpacity
                        style={styles.returnActionButton}
                        onPress={() => {
                          if (isAnyReviewSubmitting) return;
                          setReviewFormItemId(
                            isReviewFormOpen ? null : String(item.id)
                          );
                          setReviewRating(5);
                          setReviewTitle('');
                          setReviewText('');
                          setReviewSubmitError('');
                        }}
                        activeOpacity={0.8}
                        disabled={isAnyReviewSubmitting}
                        accessibilityRole="button"
                        accessibilityState={{
                          expanded: isReviewFormOpen,
                        }}
                      >
                        <Ionicons
                          name={isReviewFormOpen ? 'close' : 'star-outline'}
                          size={14}
                          color="#123D2B"
                        />
                        <Text style={styles.returnActionText}>
                          {isReviewFormOpen ? 'Cancel Review' : 'Write a Review'}
                        </Text>
                      </TouchableOpacity>

                      {isReviewFormOpen ? (
                        <View style={styles.returnForm}>
                          <Text style={styles.formLabel}>YOUR RATING</Text>
                          <View style={styles.reviewStars}>
                            {[1, 2, 3, 4, 5].map((star) => (
                              <TouchableOpacity
                                key={star}
                                onPress={() => setReviewRating(star)}
                                disabled={isAnyReviewSubmitting}
                                accessibilityRole="button"
                                accessibilityLabel={`${star} star${star > 1 ? 's' : ''}`}
                                accessibilityState={{
                                  selected: reviewRating === star,
                                }}
                              >
                                <Ionicons
                                  name={
                                    star <= reviewRating
                                      ? 'star'
                                      : 'star-outline'
                                  }
                                  size={25}
                                  color="#D9A52E"
                                />
                              </TouchableOpacity>
                            ))}
                          </View>

                          <Text style={styles.formLabel}>
                            TITLE (OPTIONAL)
                          </Text>
                          <TextInput
                            value={reviewTitle}
                            onChangeText={setReviewTitle}
                            maxLength={150}
                            editable={!isAnyReviewSubmitting}
                            style={styles.formInput}
                            placeholder="Summarize your experience"
                            placeholderTextColor="#8F8D85"
                          />

                          <Text style={styles.formLabel}>YOUR REVIEW</Text>
                          <TextInput
                            value={reviewText}
                            onChangeText={setReviewText}
                            multiline
                            maxLength={3000}
                            editable={!isAnyReviewSubmitting}
                            style={[
                              styles.formInput,
                              styles.descriptionInput,
                            ]}
                            placeholder="Share your experience with this product"
                            placeholderTextColor="#8F8D85"
                            textAlignVertical="top"
                          />

                          {reviewSubmitError ? (
                            <Text style={styles.formError}>
                              {reviewSubmitError}
                            </Text>
                          ) : null}

                          <TouchableOpacity
                            style={[
                              styles.submitButton,
                              isReviewSubmitting && styles.buttonDisabled,
                            ]}
                            disabled={isReviewSubmitting}
                            onPress={() => submitReview(item, reviewProductId)}
                            accessibilityRole="button"
                          >
                            {isReviewSubmitting ? (
                              <ActivityIndicator
                                color="#FFFFFF"
                                size="small"
                              />
                            ) : (
                              <Text style={styles.submitButtonText}>
                                Submit Review
                              </Text>
                            )}
                          </TouchableOpacity>
                        </View>
                      ) : null}
                    </View>
                  ) : null}
                </View>
              );
            })}

            {/* DIVIDER LINE */}
            <View style={styles.cardDivider} />

            {/* BOTTOM ROW: ORDER ID & STATUS WITH VERTICAL DIVIDER */}
            <View style={styles.orderMetaRow}>
              {/* ORDER ID */}
              <View style={styles.orderIdGroup}>
                <Text style={styles.metaLabel}>Order ID</Text>
                <Text style={styles.orderIdText}>{displayOrderId}</Text>
              </View>

              {/* VERTICAL DIVIDER */}
              <View style={styles.verticalDivider} />

              {/* STATUS */}
              <View style={styles.statusGroup}>
                <Text style={styles.metaLabel}>Status</Text>
                <View
                  style={[
                    styles.statusPill,
                    {
                      backgroundColor: statusTheme.bg,
                      borderColor: statusTheme.border,
                    },
                  ]}
                >
                  <Ionicons
                    name={statusTheme.icon}
                    size={14}
                    color={statusTheme.color}
                    style={styles.statusIcon}
                  />
                  <Text style={[styles.statusPillText, { color: statusTheme.color }]}>
                    {String(order.status || 'Placed').replaceAll('_', ' ')}
                  </Text>
                </View>
              </View>
            </View>
          </View>

          {/* ============================================================
              CARD 2: ORDER TRACKING (HORIZONTAL STEPPER)
          ============================================================ */}
          <OrderTracking status={order.status} />

          {/* ============================================================
              CARD 3: PAYMENT SUMMARY
          ============================================================ */}
          <View style={styles.sectionCard}>
            {/* WATERMARK LEAF IN TOP RIGHT OF CARD */}
            <Image
              source={require('../../assets/leaves-top-left.png')}
              style={styles.cardWatermarkLeaf}
              resizeMode="contain"
              pointerEvents="none"
            />

            {/* HEADER */}
            <View style={styles.sectionHeaderRow}>
              <View style={styles.sectionIconWrap}>
                <Ionicons name="card-outline" size={17} color="#123D2B" />
              </View>
              <Text style={styles.sectionTitle}>Payment Summary</Text>
            </View>

            {/* SUBTOTAL */}
            <DetailRow
              label="Subtotal"
              value={formatAmount(order.subtotal, currency)}
            />

            {/* DISCOUNT IF ANY */}
            {Number(order.discount) > 0 ? (
              <DetailRow
                label="Discount"
                value={`− ${formatAmount(order.discount, currency)}`}
                valueColor="#2E7D32"
              />
            ) : null}

            {Number(order.discount_amount) > 0 ? (
              <DetailRow
                label="Discount"
                value={`− ${formatAmount(order.discount_amount, currency)}`}
                valueColor="#2E7D32"
              />
            ) : null}

            {/* DIVIDER */}
            <View style={styles.totalDivider} />

            {/* GRAND TOTAL */}
            <DetailRow
              label="Grand Total"
              value={formatAmount(order.total_amount, currency)}
              emphasized
            />

            {/* PAYMENT METHOD ROW */}
            <View style={styles.paymentMethodRow}>
              <Text style={styles.detailLabel}>Payment Method</Text>
              <View style={styles.paymentMethodBadge}>
                <Ionicons name="card-outline" size={13} color="#1A2E22" />
                <Text style={styles.paymentMethodBadgeText}>
                  {String(order.payment_method || 'COD').replaceAll('_', ' ')}
                </Text>
              </View>
            </View>

            {invoiceError ? (
              <Text style={styles.invoiceError}>{invoiceError}</Text>
            ) : null}
            <TouchableOpacity
              style={[
                styles.primaryButton,
                styles.invoiceButton,
                invoiceDownloading && styles.invoiceButtonDisabled,
              ]}
              onPress={handleDownloadInvoice}
              disabled={invoiceDownloading}
              activeOpacity={0.85}
              accessibilityRole="button"
            >
              {invoiceDownloading ? (
                <ActivityIndicator size="small" color="#FFFFFF" />
              ) : (
                <Ionicons name="download-outline" size={16} color="#FFFFFF" />
              )}
              <Text style={styles.primaryButtonText}>
                {invoiceDownloading ? 'Downloading…' : 'Download Invoice'}
              </Text>
            </TouchableOpacity>
          </View>

          {/* ============================================================
              CARD 4: DELIVERY ADDRESS
          ============================================================ */}
          <View style={styles.sectionCard}>
            {/* HEADER */}
            <View style={styles.sectionHeaderRow}>
              <View style={styles.sectionIconWrap}>
                <Ionicons name="location-outline" size={18} color="#123D2B" />
              </View>
              <Text style={styles.sectionTitle}>Delivery Address</Text>
            </View>

            {/* WARM ADDRESS CONTAINER */}
            {addressData ? (
              <View style={styles.addressBox}>
                {addressData.recipient_name ? (
                  <Text style={styles.addressName}>
                    {addressData.recipient_name}
                  </Text>
                ) : null}

                {addressData.phone ? (
                  <Text style={styles.addressPhone}>{addressData.phone}</Text>
                ) : null}

                {addressData.street ? (
                  <Text style={styles.addressStreet}>{addressData.street}</Text>
                ) : null}

                {addressData.location ? (
                  <Text style={styles.addressLocation}>
                    {addressData.location}
                  </Text>
                ) : null}
              </View>
            ) : (
              <Text style={styles.helperText}>
                No delivery address was provided.
              </Text>
            )}
          </View>

          {/* ============================================================
              CARD 5: NEED HELP WITH THIS ORDER BANNER
          ============================================================ */}
          <TouchableOpacity
            accessibilityRole="button"
            style={styles.helpCard}
            onPress={() => router.push('/contact')}
            activeOpacity={0.85}
          >
            <View style={styles.helpIconWrap}>
              <Ionicons name="headset-outline" size={20} color="#123D2B" />
            </View>

            <View style={styles.helpContent}>
              <Text style={styles.helpTitle}>Need help with this order?</Text>
              <Text style={styles.helpSubtitle}>
                Get support for returns, exchanges or other queries.
              </Text>
            </View>

            <Ionicons name="chevron-forward" size={18} color="#123D2B" />
          </TouchableOpacity>

          <View style={styles.bottomSpace} />
        </ScrollView>
      )}
    </View>
  );
}

