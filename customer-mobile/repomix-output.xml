            </View>
          </View>

          {/* ACCOUNT & EXPLORE SECTION */}
          <View style={styles.menuSection}>
            <Text style={styles.sectionTitle}>Account Services</Text>

            <View style={styles.menuCard}>
              <ProfileMenuItem
                icon="bag-handle-outline"
                title="My Orders"
                subtitle="Track and view past shipments"
                badgeText="Login"
                onPress={() =>
                  router.push({
                    pathname: '/(auth)/login',
                    params: { returnTo: '/orders' },
                  })
                }
              />

              <ProfileMenuItem
                icon="heart-outline"
                title="Wishlist"
                subtitle="View your saved herbal essentials"
                badgeText="Login"
                onPress={() =>
                  router.push({
                    pathname: '/(auth)/login',
                    params: { returnTo: '/wishlist' },
                  })
                }
              />

              <ProfileMenuItem
                icon="location-outline"
                title="Saved Addresses"
                subtitle="Manage your delivery addresses"
                badgeText="Login"
                onPress={() =>
                  router.push({
                    pathname: '/(auth)/login',
                    params: { returnTo: '/address' },
                  })
                }
              />

              <ProfileMenuItem
                icon="notifications-outline"
                title="Notifications"
                subtitle="View order and account updates"
                badgeText="Login"
                onPress={() =>
                  router.push({
                    pathname: '/(auth)/login',
                    params: { returnTo: '/notifications' },
                  })
                }
              />
            </View>

            <Text style={styles.sectionTitle}>Support & About</Text>

            <View style={styles.menuCard}>
              <ProfileMenuItem
                icon="help-circle-outline"
                title="Help & Customer Care"
                subtitle="Consult with our Ayurvedic advisors"
                onPress={() => router.push('/contact')}
              />

              <ProfileMenuItem
                icon="information-circle-outline"
                title="About Aumveda"
                subtitle="Our Vedic heritage and philosophy"
                onPress={() => router.push('/about')}
              />

              <ProfileMenuItem
                icon="settings-outline"
                title="App Settings"
                subtitle="Notifications, currency, and theme"
                onPress={() => router.push('/account/settings')}
              />
            </View>
          </View>

          {/* FOOTER NOTE */}
          <View style={styles.footerNote}>
            <View style={styles.footerRule} />
            <MaterialCommunityIcons
              name="leaf"
