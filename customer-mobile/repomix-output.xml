import React, { useEffect, useState } from 'react';
import {
  ActivityIndicator,
  Image,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from 'react-native';
import { useLocalSearchParams, useRouter } from 'expo-router';
import { Ionicons } from '@expo/vector-icons';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
import { StatusBar } from 'expo-status-bar';

import OrderTracking from '../../src/components/orders/OrderTracking';
import { useAuth } from '../../src/context/AuthContext';
import {
  createReturnRequest,
  downloadOrderInvoice,
  getOrder,
  getOrderReturnRequests,
} from '../../src/services/orderService';
import {
  getCustomerOrderReviews,
  submitProductReview,
} from '../../src/services/reviewService';
import { colors } from '../../src/theme/colors';

function formatAmount(value, currency = 'INR') {
  const amount = Number(value);
  const formattedNumber = Number.isFinite(amount)
    ? amount.toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })
    : '0.00';
  return currency === 'INR' || currency === '₹'
    ? `₹${formattedNumber}`
    : `${currency} ${formattedNumber}`;
}

function getStatusTheme(statusRaw) {
  const s = String(statusRaw || '').toLowerCase();
  if (s.includes('deliver') || s.includes('complete')) {
    return {
      bg: '#E8F2E7',
      border: '#CDE2CB',
      color: '#123D2B',
      icon: 'checkmark-circle-outline',
    };
  }
  if (s.includes('cancel')) {
    return {
      bg: '#FDEEEE',
      border: '#F7D7D7',
      color: '#B85C5C',
      icon: 'close-circle-outline',
    };
  }
  if (s.includes('return')) {
    return {
      bg: '#FEF7E6',
      border: '#EBDCB9',
      color: '#A87E34',
      icon: 'return-down-back-outline',
    };
  }
  if (s.includes('ship') || s.includes('transit')) {
    return {
      bg: '#EBF4F6',
      border: '#BDE0E8',
      color: '#1C5B6B',
      icon: 'car-outline',
    };
  }
  return {
    bg: '#FEF7E6',
    border: '#F6E5C8',
    color: '#B8860B',
    icon: 'time-outline',
  };
}

function getReturnStatusTheme(statusRaw, requestType) {
  const status = String(statusRaw || '').trim().toLowerCase();
  const labels = {
    requested: 'Request submitted',
    under_review: 'Request processing',
    approved: 'Request processing',
    rejected: 'Request declined',
    pickup_scheduled: 'Pickup scheduled',
    item_received: 'Item received',
    replacement_processing: 'Exchange processing',
    refund_processing: 'Refund processing',
    completed:
      requestType === 'replacement' ? 'Exchange complete' : 'Refund complete',
    cancelled: 'Cancelled',
  };

  if (status === 'rejected' || status === 'cancelled') {
    return {
      label: labels[status],
      backgroundColor: '#FDEEEE',
      color: '#B85C5C',
      icon: 'close-circle-outline',
    };
  }

  if (status === 'completed' || status === 'approved') {
    return {
      label: labels[status],
      backgroundColor: '#E8F2E7',
      color: '#123D2B',
      icon: 'checkmark-circle-outline',
    };
  }

  if (
    status === 'pickup_scheduled' ||
    status === 'item_received' ||
    status === 'replacement_processing' ||
    status === 'refund_processing'
  ) {
    return {
      label: labels[status],
      backgroundColor: '#EBF4F6',
      color: '#1C5B6B',
      icon: 'sync-outline',
    };
  }

  return {
    label:
      labels[status] ||
      (status ? status.replaceAll('_', ' ') : 'Status unavailable'),
    backgroundColor: '#FEF7E6',
    color: '#A87E34',
    icon: 'time-outline',
  };
}

function ReturnRequestTracking({ request }) {
  const isExchange = request.request_type === 'replacement';
  const status = String(request.status || '')
    .trim()
    .toLowerCase()
    .replace(/[\s-]+/g, '_');
  const steps = [
    'Request submitted',
    'Pickup scheduled',
    'Item received',
    isExchange ? 'Exchange processing' : 'Refund processing',
    isExchange ? 'Exchange complete' : 'Refund complete',
  ];
  const activeStepByStatus = {
    requested: 0,
    under_review: 0,
    approved: 0,
    pickup_scheduled: 1,
    item_received: 2,
    replacement_processing: 3,
    refund_processing: 3,
    completed: 4,
  };
  const isTerminal = status === 'rejected' || status === 'cancelled';
  const activeStep = activeStepByStatus[status] ?? 0;

  return (
    <View style={styles.returnTracking}>
      <Text style={styles.returnTrackingTitle}>
        {isExchange ? 'Exchange tracking' : 'Refund tracking'}
      </Text>
      {isTerminal ? (
        <Text style={styles.returnTrackingTerminal}>
          {status === 'rejected'
            ? 'This request could not be completed.'
            : 'The request was cancelled.'}
        </Text>
      ) : (
        <>
          {steps.map((step, index) => {
            const isComplete = index <= activeStep;

            return (
              <View key={step} style={styles.returnTrackingStep}>
                <View style={styles.returnTrackingRail}>
                  <View
                    style={[
                      styles.returnTrackingDot,
                      isComplete && styles.returnTrackingDotComplete,
                    ]}
                  />
                  {index < steps.length - 1 ? (
                    <View
                      style={[
                        styles.returnTrackingLine,
                        index < activeStep &&
                          styles.returnTrackingLineComplete,
                      ]}
                    />
                  ) : null}
                </View>
                <Text
                  style={[
                    styles.returnTrackingLabel,
                    isComplete && styles.returnTrackingLabelComplete,
                  ]}
                >
                  {step}
                </Text>
              </View>
            );
          })}
          <Text style={styles.returnTrackingNote}>
            {isExchange
              ? 'Track the pickup of your original item and delivery of the exchange here.'
              : 'Track your item pickup and refund progress here.'}
          </Text>
        </>
      )}
    </View>
  );
}

function DetailRow({ label, value, emphasized = false, valueColor }) {
  return (
    <View style={styles.detailRow}>
      <Text style={[styles.detailLabel, emphasized && styles.emphasizedLabel]}>
        {label}
      </Text>
      <Text
        style={[
          styles.detailValue,
          emphasized && styles.totalValue,
          valueColor ? { color: valueColor } : null,
        ]}
      >
        {value}
      </Text>
    </View>
  );
}

function addressLines(order) {
  const address = order?.shipping_address;

  if (!address || typeof address !== 'object') {
    return null;
  }

  const street = [address.address_line1, address.address_line2]
    .filter(Boolean)
    .join(', ');

  const location = [address.city, address.state, address.postal_code, address.country]
    .filter(Boolean)
    .join(', ');

  return {
    recipient_name: address.recipient_name || '',
    phone: address.phone || '',
    street,
    location,
  };
}

export default function OrderDetailsScreen() {
  const insets = useSafeAreaInsets();
  const router = useRouter();
  const { id } = useLocalSearchParams();
  const orderId = Array.isArray(id) ? id[0] : id;
  const { token } = useAuth();
  const [order, setOrder] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [retryKey, setRetryKey] = useState(0);
  const [returnRequests, setReturnRequests] = useState([]);
  const [returnLoading, setReturnLoading] = useState(true);
  const [returnError, setReturnError] = useState('');
  const [returnFormItemId, setReturnFormItemId] = useState(null);
  const [returnType, setReturnType] = useState('return');
  const [returnQuantity, setReturnQuantity] = useState('1');
  const [returnReason, setReturnReason] = useState('damaged_product');
  const [returnDescription, setReturnDescription] = useState('');
  const [returnSubmitting, setReturnSubmitting] = useState(false);
  const [returnSubmitError, setReturnSubmitError] = useState('');
  const [returnSubmitSuccess, setReturnSubmitSuccess] = useState('');
  const [reviewFormItemId, setReviewFormItemId] = useState(null);
  const [reviewRating, setReviewRating] = useState(5);
  const [reviewTitle, setReviewTitle] = useState('');
  const [reviewText, setReviewText] = useState('');
  const [reviewSubmittingItemId, setReviewSubmittingItemId] = useState(null);
  const [reviewSubmitError, setReviewSubmitError] = useState('');
  const [reviewRetryKey, setReviewRetryKey] = useState(0);
  const [reviewResultState, setReviewResultState] = useState({
    key: '',
    reviews: null,
    error: '',
  });
  const reviewRequestKey =
    `${token || ''}:${orderId || ''}:${reviewRetryKey}`;
  const [invoiceDownloading, setInvoiceDownloading] = useState(false);
  const [invoiceError, setInvoiceError] = useState('');

  useEffect(() => {
    let active = true;
    getOrder(token, orderId)
      .then((result) => {
        if (active) {
          setOrder(result);
          setError('');
        }
      })
      .catch((loadError) => {
        console.error('Load order details error:', loadError);
        if (active) {
          setError(loadError?.message || 'Unable to load order details.');
        }
      })
      .finally(() => {
        if (active) setLoading(false);
      });
    return () => {
      active = false;
    };
  }, [orderId, retryKey, token]);

  useEffect(() => {
    if (!token || !orderId) return undefined;

    const controller = new AbortController();
    let active = true;

    getCustomerOrderReviews(token, orderId, controller.signal)
      .then((reviews) => {
        if (active) {
          setReviewResultState({
            key: reviewRequestKey,
            reviews,
            error: '',
          });
        }
      })
      .catch((loadError) => {
        if (!active || loadError?.name === 'AbortError') return;
        console.error('Load order reviews error:', loadError);
        setReviewResultState({
          key: reviewRequestKey,
          reviews: null,
          error: loadError?.message || 'Unable to load your order reviews.',
        });
      });

    return () => {
      active = false;
      controller.abort();
    };
  }, [orderId, reviewRequestKey, token]);

  useEffect(() => {
    let active = true;

    async function loadReturnRequests() {
      if (!token || !orderId) {
        setReturnRequests([]);
        setReturnLoading(false);
        return;
      }

      setReturnLoading(true);
      setReturnError('');

      try {
        const requests = await getOrderReturnRequests(token, orderId);

        if (active) {
          setReturnRequests(requests);
        }
      } catch (err) {
        console.error('Load return requests error:', err);

        if (active) {
          setReturnError('Unable to load return details.');
        }
      } finally {
        if (active) {
          setReturnLoading(false);
        }
      }
    }

    loadReturnRequests();

    return () => {
      active = false;
    };
  }, [token, orderId]);

  async function handleDownloadInvoice() {
    if (!token || !orderId) {
      router.push('/(auth)/login');
      return;
    }

    setInvoiceDownloading(true);
    setInvoiceError('');

    try {
      const blob = await downloadOrderInvoice(token, orderId);

      if (!blob) {
        throw new Error('Invoice PDF was not returned by the server.');
      }

      if (typeof window !== 'undefined' && window.URL) {
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');

        link.href = url;
        link.download = `${order?.order_number || orderId}-invoice.pdf`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        window.URL.revokeObjectURL(url);
      } else {
        setInvoiceError(
          'Invoice download is not supported on this device yet.'
        );
      }
    } catch (invoiceDownloadError) {
      console.error(
        'Download invoice error:',
        invoiceDownloadError
      );

      setInvoiceError(
        invoiceDownloadError?.message ||
          'Unable to download invoice.'
      );
    } finally {
      setInvoiceDownloading(false);
    }
  }

  async function submitReturnRequest(item) {
    if (!token) {
      router.push('/(auth)/login');
      return;
    }

    if (!item?.id) {
      setReturnSubmitError('This order item is missing its ID.');
      return;
    }

    const quantity = Number(returnQuantity);
    const availableQuantity = Number(item.quantity) || 0;

    if (!Number.isInteger(quantity) || quantity < 1 || quantity > availableQuantity) {
      setReturnSubmitError(`Enter a quantity between 1 and ${availableQuantity}.`);
      return;
    }

    if (!returnReason.trim()) {
      setReturnSubmitError('Please select a reason for your request.');
      return;
    }

    setReturnSubmitting(true);
    setReturnSubmitError('');
    setReturnSubmitSuccess('');

    try {
      await createReturnRequest({
        token,
        orderId,
        orderItemId: item.id,
        requestType: returnType,
        requestedQuantity: quantity,
        reason: returnReason,
        description: returnDescription,
      });

      const requests = await getOrderReturnRequests(token, orderId);
      setReturnRequests(requests);
      setReturnFormItemId(null);
      setReturnDescription('');
      setReturnQuantity('1');
      setReturnSubmitSuccess('Your request has been submitted successfully.');
    } catch (submitError) {
      console.error('Create return request error:', submitError);
      setReturnSubmitError(
        submitError?.message || 'Unable to submit your return request.'
      );
    } finally {
      setReturnSubmitting(false);
    }
  }

  async function submitReview(item, productId) {
    if (!token) {
      router.push('/(auth)/login');
      return;
    }

    if (!item?.id || !productId) {
      setReviewSubmitError('This purchased item is missing review details.');
      return;
    }

    if (!reviewTitle.trim() && !reviewText.trim()) {
      setReviewSubmitError('Please enter a title or written feedback.');
      return;
    }

    setReviewSubmittingItemId(String(item.id));
    setReviewSubmitError('');

    try {
      const result = await submitProductReview({
        productId,
        orderItemId: item.id,
        rating: reviewRating,
        title: reviewTitle,
        reviewText,
        token,
      });

      if (!result?.data?.order_item_id) {
        throw new Error('The server did not return the saved review.');
      }

      setReviewResultState((current) => {
        const currentReviews =
          current.key === reviewRequestKey && Array.isArray(current.reviews)
            ? current.reviews
            : [];
        return {
          key: reviewRequestKey,
          reviews: [
            result.data,
            ...currentReviews.filter(
              (review) => String(review.order_item_id) !== String(item.id)
            ),
          ],
          error: '',
        };
      });
      setReviewFormItemId(null);
      setReviewTitle('');
      setReviewText('');
      setReviewRating(5);
    } catch (submitError) {
      console.error('Submit order review error:', submitError);
      setReviewSubmitError(
        submitError?.message || 'Unable to submit your review.'
      );
    } finally {
      setReviewSubmittingItemId(null);
    }
  }

  const currency = order?.currency || 'INR';
  const items = Array.isArray(order?.items) ? order.items : [];
  const currentReviewResult =
    reviewResultState.key === reviewRequestKey
      ? reviewResultState
      : null;
  const orderReviews = currentReviewResult?.reviews ?? null;
  const reviewLookupError = currentReviewResult?.error || '';
  const addressData = order ? addressLines(order) : null;
  const statusTheme = getStatusTheme(order?.status);

  // Formatted order ID string (matches mockup: #AUM-20261105065552518)
  const displayOrderId = order
    ? order.order_number
      ? String(order.order_number).startsWith('#')
        ? order.order_number
        : String(order.order_number).startsWith('AUM-')
          ? `#${order.order_number}`
          : `#AUM-${order.order_number}`
      : `#AUM-${order.id}`
    : '';

  return (
    <View style={styles.container}>
      <StatusBar style="dark" />

      {/* TOP-RIGHT CORNER BOTANICAL BRANCH ACCENT */}
      <Image
        source={require('../../assets/leaves-top-left.png')}
        style={styles.topRightBranch}
        resizeMode="contain"
        pointerEvents="none"
      />

      {/* TOP NAVIGATION BAR */}
      <View style={[styles.headerBar, { paddingTop: Math.max(insets.top, 14) }]}>
        <TouchableOpacity
          accessibilityRole="button"
          accessibilityLabel="Go back"
          onPress={() => router.back()}
          hitSlop={10}
          style={styles.circleBackButton}
          activeOpacity={0.8}
        >
          <Ionicons name="arrow-back" size={20} color="#123D2B" />
        </TouchableOpacity>

        <Text style={styles.headerTitle}>Order Details</Text>
      </View>

      {/* BODY CONTENT */}
      {loading ? (
        <View style={styles.center}>
          <ActivityIndicator size="large" color="#123D2B" />
          <Text style={styles.helperText}>Loading order details…</Text>
        </View>
      ) : !token ? (
        <View style={styles.center}>
          <View style={styles.stateCard}>
            <View style={styles.stateIconOuter}>
              <View style={styles.stateIconInner}>
                <Ionicons name="person-outline" size={34} color="#123D2B" />
              </View>
            </View>
            <Text style={styles.emptyTitle}>Sign In Required</Text>
            <Text style={styles.message}>Sign in to view details for this order.</Text>
            <TouchableOpacity
              style={styles.primaryButton}
              onPress={() => router.push('/(auth)/login')}
