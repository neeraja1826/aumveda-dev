import { useWishlist } from '../../src/context/WishlistContext';
import { colors } from '../../src/theme/colors';
import ProductCard from '../../src/components/home/ProductCard';
import { getCategoryPastelTheme } from '../../src/components/home/HomeHeader';


export default function CategoryProductsPage() {

  const router = useRouter();
  const { width } = useWindowDimensions();
  const horizontalPadding = 14;
  const gap = 12;
  const cardWidth =
    (width - horizontalPadding * 2 - gap) / 2;
  const imageHeight = Math.max(
    125,
    Math.min(175, cardWidth * 0.9)
  );

  const {
    categoryId,
    categoryName,
  } = useLocalSearchParams();

  const activeTheme = useMemo(() => {
    return getCategoryPastelTheme(String(categoryName || ''));
  }, [categoryName]);


  const {
    addToCart,
    cartItems,
    increaseQuantity,
    decreaseQuantity,
  } = useCart();


  const {
    isWishlisted,
    toggleWishlist,
  } = useWishlist();


  const [products, setProducts] = useState([]);

  const [loading, setLoading] = useState(true);


  // ============================================================
  // LOAD PRODUCTS
  // ============================================================

  useEffect(() => {

    if (!categoryId) {
      return;
    }

    loadProducts();

  }, [categoryId]);


  const loadProducts = async () => {

    try {

      setLoading(true);


      const data =
        await getProducts({
          categoryId: String(categoryId),
          limit: 50,
          offset: 0,
        });


      setProducts(
        Array.isArray(data)
          ? data
          : []
      );

    } catch (error) {

      console.log(
        'Category products error:',
        error
      );

      setProducts([]);

    } finally {

      setLoading(false);

    }

  };


  // ============================================================
  // IMAGE
  // ============================================================

  const getProductImage = (product) => {

    return (
      product?.image_url ||
      product?.image ||
      product?.thumbnail_url ||
      product?.images?.[0] ||
      null
    );

  };


  // ============================================================
  // CART QUANTITY
  // ============================================================

  const getCartItem = (product) => {

    if (!product?.id) {
      return null;
    }


    return (
      cartItems?.find(
        (item) =>
          String(item?.productId) ===
          String(product.id)
      ) || null
    );

  };


  const getQuantity = (product) => {

    const item =
      getCartItem(product);

    return item?.quantity || 0;

  };


  // ============================================================
  // ADD TO CART
  // ============================================================

  
const handleAddToCart = (product) => {
  if (!product) {
    return;
  }

  addToCart(
    product,
    1,
    product?.variant ?? null
  );
};


  // ============================================================
  // QUANTITY
  // ============================================================

  const handleIncrease = (product) => {

    const item =
      getCartItem(product);

    if (!item) {

      handleAddToCart(product);

      return;

    }


    increaseQuantity(
      item.itemKey
    );

  };


  const handleDecrease = (product) => {

    const item =
      getCartItem(product);

    if (!item) {
      return;
    }


    decreaseQuantity(
      item.itemKey
    );

  };


  // ============================================================
  // OPEN PRODUCT
  // ============================================================

  const handleProductPress = (product) => {

    if (!product?.slug) {
      return;
    }


    router.push(
      `/products/${product.slug}`
    );

  };


  // ============================================================
  // LOADING
  // ============================================================

  if (loading) {

    return (
      <SafeAreaView
        style={[styles.container, { backgroundColor: activeTheme.screenBackground }]}
        edges={['top']}
      >
        <View style={styles.loadingContainer}>

          <ActivityIndicator
            size="large"
            color="#174B35"
          />

          <Text style={styles.loadingText}>
            Loading products...
          </Text>

        </View>
      </SafeAreaView>
    );

  }


  // ============================================================
  // PRODUCT CARD
  // ============================================================

  const renderProduct = ({ item }) => (
    <ProductCard
      product={item}
      theme={activeTheme}
      onPress={() => handleProductPress(item)}
    />
  );

  // eslint-disable-next-line no-unused-vars
  const _oldRenderProduct = ({ item }) => {

    const imageUrl =
      getProductImage(item);


    const quantity =
      getQuantity(item);


    const wished =
      isWishlisted(
        item?.id
      );


    const price =
      item?.price ??
      item?.selling_price ??
      0;


    const mrp =
      item?.mrp ??
      item?.original_price ??
      null;


    return (
      <View
        style={[
          styles.productCard,
          {
            width: cardWidth,
          },
        ]}
      >

        {/* ====================================================
            IMAGE
        ==================================================== */}

        <Pressable
          onPress={() =>
            handleProductPress(item)
          }
        >

          <View
            style={[
              styles.imageContainer,
              {
                height: imageHeight,
              },
            ]}
          >

            {imageUrl ? (

              <Image
                source={{
                  uri: imageUrl,
                }}
                style={styles.productImage}
                resizeMode="contain"
              />

            ) : (

              <View
                style={styles.imagePlaceholder}
              >

                <Text
                  style={styles.placeholderText}
                >
                  AUMVEDA
                </Text>

              </View>

            )}


            {/* WISHLIST */}

            <Pressable
              style={styles.wishlistButton}
              onPress={() =>
                toggleWishlist(item)
              }
              hitSlop={8}
            >

              <Ionicons
                name={
                  wished
                    ? 'heart'
                    : 'heart-outline'
                }
                size={21}
                color={
                  wished
                    ? '#A74B55'
                    : '#174B35'
                }
              />

            </Pressable>

          </View>

        </Pressable>


        {/* ====================================================
            PRODUCT INFO
        ==================================================== */}

        <Pressable
          onPress={() =>
            handleProductPress(item)
          }
        >

          <Text
            style={styles.productName}
            numberOfLines={2}
          >
            {item?.name || 'Product'}
          </Text>


          {/* PRICE */}

          <View style={styles.priceRow}>

            <Text style={styles.price}>
              ₹{price}
            </Text>


            {mrp &&
              Number(mrp) >
                Number(price) && (

                <Text style={styles.mrp}>
                  ₹{mrp}
                </Text>

              )}

          </View>

        </Pressable>


        {/* ====================================================
            CART
        ==================================================== */}

        {quantity > 0 ? (

          <View style={styles.quantityControl}>

            <Pressable
              style={styles.quantityButton}
              onPress={() =>
                handleDecrease(item)
              }
            >

              <Text
                style={styles.quantityButtonText}
              >
                −
              </Text>

            </Pressable>


            <Text style={styles.quantity}>
              {quantity}
            </Text>


            <Pressable
              style={styles.quantityButton}
              onPress={() =>
                handleIncrease(item)
              }
            >

              <Text
                style={styles.quantityButtonText}
              >
                +
              </Text>

            </Pressable>

          </View>

        ) : (

          <Pressable
            style={styles.addButton}
            onPress={() =>
              handleAddToCart(item)
            }
          >

            <Ionicons
              name="bag-add-outline"
              size={18}
              color="#FFFFFF"
            />

            <Text style={styles.addButtonText}>
              Add to Cart
            </Text>

          </Pressable>

        )}

      </View>
    );

  };


  // ============================================================
  // EMPTY
  // ============================================================

  if (!products.length) {

    return (
      <SafeAreaView
        style={[styles.container, { backgroundColor: activeTheme.screenBackground }]}
        edges={['top']}
      >

        <View style={[styles.header, { backgroundColor: activeTheme.headerGradient[0], borderBottomColor: activeTheme.headerBorder }]}>

          <Pressable
            style={styles.backButton}
            onPress={() => router.back()}
          >

            <Ionicons
              name="arrow-back"
              size={24}
              color="#1F2922"
            />

          </Pressable>


          <Text
            style={[styles.headerTitle, { color: activeTheme.accent }]}
            numberOfLines={1}
          >
            {categoryName || 'Category'}
          </Text>

        </View>


        <View style={styles.emptyContainer}>

          <View style={styles.emptyIcon}>

            <Ionicons
              name="leaf-outline"
              size={36}
              color="#174B35"
            />

          </View>


          <Text style={styles.emptyTitle}>
            No Products Found
          </Text>


          <Text style={styles.emptyText}>
            There are no products available in this category yet.
          </Text>

        </View>

      </SafeAreaView>
    );

  }


  // ============================================================
  // PAGE
  // ============================================================

  return (
    <SafeAreaView
      style={[styles.container, { backgroundColor: activeTheme.screenBackground }]}
      edges={['top']}
    >

      {/* ======================================================
          HEADER
      ====================================================== */}

      <View style={[styles.header, { backgroundColor: activeTheme.headerGradient[0], borderBottomColor: activeTheme.headerBorder }]}>

        <Pressable
          style={styles.backButton}
          onPress={() => router.back()}
          hitSlop={8}
        >

          <Ionicons
            name="arrow-back"
            size={24}
            color="#1F2922"
          />

        </Pressable>


        <View style={styles.headerText}>

          <Text
            style={[styles.headerTitle, { color: activeTheme.accent }]}
            numberOfLines={1}
          >
            {categoryName || 'Products'}
          </Text>


          <Text style={[styles.headerSubtitle, { color: activeTheme.accent + 'B3' }]}>
            {products.length}{' '}
            {products.length === 1
              ? 'Product'
              : 'Products'}
          </Text>

        </View>

      </View>


      {/* ======================================================
          PRODUCTS
      ====================================================== */}

      <FlatList
        data={products}
        renderItem={renderProduct}
        keyExtractor={(item, index) =>
          String(
            item?.id ??
            index
          )
        }
        numColumns={2}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={
          styles.productList
        }
        columnWrapperStyle={
          styles.columnWrapper
        }
      />

    </SafeAreaView>
  );
}


