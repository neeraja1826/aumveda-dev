import React from 'react';
import {
  View,
  Text,
  Pressable,
  StyleSheet,
} from 'react-native';
import { Image } from 'expo-image';
import { Ionicons } from '@expo/vector-icons';

// Organic pastel color palettes for concern tiles
const CONCERN_THEMES = [
  {
    bg: '#F4F8F3', // Soft Sage
    border: '#DEEBDC',
    accent: '#123D2B',
    tagBg: 'rgba(18, 61, 43, 0.08)',
    tagText: '#123D2B',
    iconBg: '#E7F2E5',
  },
  {
    bg: '#FAF6ED', // Warm Honey / Herbal
    border: '#EFE5CE',
    accent: '#8E6720',
    tagBg: 'rgba(217, 165, 46, 0.12)',
    tagText: '#8E6720',
    iconBg: '#F5ECDA',
  },
  {
    bg: '#F5F7F6', // Eucalyptus Mint
    border: '#DFEAE5',
    accent: '#1B563D',
    tagBg: 'rgba(27, 86, 61, 0.08)',
    tagText: '#1B563D',
    iconBg: '#E3EDE8',
  },
  {
    bg: '#FAF4F1', // Rose & Hibiscus
    border: '#EFE0D9',
    accent: '#8F4E3F',
    tagBg: 'rgba(154, 91, 76, 0.09)',
    tagText: '#8F4E3F',
    iconBg: '#F3E5DF',
  },
  {
    bg: '#F6F5F8', // Calming Ashwagandha / Lavender
    border: '#E5E2EC',
    accent: '#4C4269',
    tagBg: 'rgba(76, 66, 105, 0.08)',
    tagText: '#4C4269',
    iconBg: '#EAE6F0',
  },
  {
    bg: '#F8F6F1', // Sandalwood Ivory
    border: '#ECE7DC',
    accent: '#7D5C28',
    tagBg: 'rgba(140, 104, 48, 0.09)',
    tagText: '#7D5C28',
    iconBg: '#EDE7DA',
  },
];

// Minimal botanical icons matching common Ayurvedic concerns
function getConcernIcon(name = '') {
  const n = String(name || '').toLowerCase();
  if (
    n.includes('digest') ||
    n.includes('gut') ||
    n.includes('stomach') ||
    n.includes('acid') ||
    n.includes('constipat')
  ) {
    return 'leaf-outline';
  }
  if (
    n.includes('skin') ||
    n.includes('glow') ||
    n.includes('acne') ||
    n.includes('face') ||
    n.includes('pigment')
  ) {
    return 'sparkles-outline';
  }
  if (
    n.includes('hair') ||
    n.includes('scalp') ||
    n.includes('dandruff') ||
    n.includes('fall')
  ) {
    return 'water-outline';
  }
  if (
    n.includes('sleep') ||
    n.includes('stress') ||
    n.includes('anxiety') ||
    n.includes('mind') ||
    n.includes('calm')
  ) {
    return 'moon-outline';
  }
  if (
    n.includes('immunit') ||
    n.includes('energy') ||
    n.includes('vital') ||
    n.includes('stamina') ||
    n.includes('cold')
  ) {
    return 'shield-checkmark-outline';
  }
  if (
    n.includes('joint') ||
    n.includes('pain') ||
    n.includes('bone') ||
    n.includes('arthrit') ||
    n.includes('muscle')
  ) {
    return 'fitness-outline';
  }
  if (
    n.includes('weight') ||
    n.includes('fat') ||
    n.includes('detox') ||
    n.includes('slim')
  ) {
    return 'scale-outline';
  }
  if (
    n.includes('diabet') ||
    n.includes('sugar') ||
    n.includes('blood') ||
    n.includes('heart')
  ) {
    return 'heart-outline';
  }
  if (n.includes('tea') || n.includes('herb')) {
    return 'cafe-outline';
  }
  return 'flower-outline';
}

// Compute rhythmic asymmetric Bento dimensions (Wide, Tall, 4-Column Compact, Medium)
function getItemConfig(index, total) {
  if (total <= 4) {
    return {
      width: '48.5%',
      minHeight: 96,
      variant: 'medium',
    };
  }

  if (total === 5) {
    if (index === 0) return { width: '58%', minHeight: 110, variant: 'wide' };
    if (index === 1) return { width: '39%', minHeight: 110, variant: 'tall' };
    return { width: '31%', minHeight: 88, variant: 'compact' };
  }

  // 6 or more items: Rhythmic Bento Grid
  // Items 0, 1: Bento Duo (58% wide + 39% tall)
  // Items 2, 3, 4, 5: 4-Column Grid Row (23% each)
  // Items 6, 7: Inverted Bento Duo (39% tall + 58% wide)
  // Items 8, 9, 10, 11: 4-Column Grid Row (23% each)
  const cycleIndex = index % 12;

  if (cycleIndex === 0) {
    return { width: '58%', minHeight: 112, variant: 'wide' };
  }
  if (cycleIndex === 1) {
    return { width: '39%', minHeight: 112, variant: 'tall' };
  }
  if (cycleIndex >= 2 && cycleIndex <= 5) {
    const remainingInGroup = total - Math.floor(index / 12) * 12 - 2;
    if (remainingInGroup === 1 && cycleIndex === 2) {
      return { width: '100%', minHeight: 92, variant: 'wide' };
    }
    if (remainingInGroup === 2) {
      return { width: '48.5%', minHeight: 92, variant: 'medium' };
    }
    if (remainingInGroup === 3) {
      return { width: '31%', minHeight: 88, variant: 'compact' };
    }
    return { width: '23%', minHeight: 88, variant: 'compact' };
  }
  if (cycleIndex === 6) {
    if (index === total - 1) {
      return { width: '100%', minHeight: 96, variant: 'wide' };
    }
    return { width: '39%', minHeight: 112, variant: 'tall' };
  }
  if (cycleIndex === 7) {
    return { width: '58%', minHeight: 112, variant: 'wide' };
  }
  if (cycleIndex >= 8 && cycleIndex <= 11) {
    const remainingInGroup = total - Math.floor(index / 12) * 12 - 8;
    if (remainingInGroup === 1 && cycleIndex === 8) {
      return { width: '100%', minHeight: 92, variant: 'wide' };
    }
    if (remainingInGroup === 2) {
      return { width: '48.5%', minHeight: 92, variant: 'medium' };
    }
    if (remainingInGroup === 3) {
      return { width: '31%', minHeight: 88, variant: 'compact' };
    }
    return { width: '23%', minHeight: 88, variant: 'compact' };
  }

  return { width: '48.5%', minHeight: 96, variant: 'medium' };
}

