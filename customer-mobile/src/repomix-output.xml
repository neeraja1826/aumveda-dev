<file path="components/home/ProductCard.jsx">
import React from 'react';

import {
  Pressable,
  StyleSheet,
  Text,
  View,
} from 'react-native';

import { Image } from 'expo-image';

import { Ionicons } from '@expo/vector-icons';
import { useWishlist } from '../../context/WishlistContext';
import { useCart } from '../../context/CartContext';

import { colors } from '../../theme/colors';

export default function ProductCard({
  product,
  onPress,
  compact = false,
}) {
  // --------------------------------------------------
  // CART
  // --------------------------------------------------
  const {
    cartItems,
    addToCart,
    increaseQuantity,
    decreaseQuantity,
  } = useCart();
const {
  isWishlisted,
  toggleWishlist,
} = useWishlist();
  // --------------------------------------------------
  // PRODUCT IMAGE
  // --------------------------------------------------

  const image =
    product?.image_url ??
    product?.image ??
    product?.thumbnail ??
    product?.images?.[0] ??
    product?.image_urls?.[0] ??
    null;

  // --------------------------------------------------
  // PRICE
  // --------------------------------------------------

  const price = Number(
    product?.price ??
      product?.variant?.price ??
      0
  );

  const compareAtPrice = Number(
    product?.compare_at_price ??
      product?.variant?.compare_at_price ??
      0
  );

  // --------------------------------------------------
  // DISCOUNT
  // --------------------------------------------------

  const discount =
    compareAtPrice > price && price > 0
      ? Math.round(
          ((compareAtPrice - price) /
            compareAtPrice) *
            100
        )
      : 0;

  // --------------------------------------------------
  // RATING
  // --------------------------------------------------

  const rating =
    product?.rating ??
    product?.average_rating ??
    0;

  const reviews =
    product?.review_count ?? 0;

  // --------------------------------------------------
  // DESCRIPTION
  // --------------------------------------------------

  const description =
    product?.description ??
    product?.short_description ??
    '';

  // --------------------------------------------------
  // VARIANT
  // --------------------------------------------------

  const variant =
    product?.variant ?? null;

  const variantId =
    variant?.id ?? null;

  // --------------------------------------------------
  // CART ITEM KEY
  //
  // Must match CartContext:
  // `${product.id}-${variantId ?? 'default'}`
  // --------------------------------------------------

  const itemKey =
    `${product?.id}-${variantId ?? 'default'}`;

  // --------------------------------------------------
  // FIND PRODUCT IN CART
  // --------------------------------------------------

  const cartItem = cartItems.find(
    (item) =>
      item.itemKey === itemKey
  );

  const quantity = Number(
    cartItem?.quantity ?? 0
  );

  const isAdded =
    quantity > 0;

  // --------------------------------------------------
  // ADD TO CART
  // --------------------------------------------------


const handleAddToCart = (event) => {
  event?.stopPropagation?.();

  if (!product?.id) {
    return;
  }

  addToCart(
    product,
    1,
    variant
  );
};


  // --------------------------------------------------
  // INCREASE
  // --------------------------------------------------

  const handleIncrease = (
    event
  ) => {
    event?.stopPropagation?.();

    if (!product?.id) {
      return;
    }

    increaseQuantity(
      itemKey
    );
  };

  // --------------------------------------------------
  // DECREASE
  // --------------------------------------------------

  const handleDecrease = (
    event
  ) => {
    event?.stopPropagation?.();

    if (!product?.id) {
      return;
    }

    decreaseQuantity(
      itemKey
    );
  };

  // --------------------------------------------------
  // CARD
  // --------------------------------------------------

  return (
    <Pressable
      style={[
        styles.card,
        compact && styles.compactCard,
      ]}
      onPress={onPress}
      android_ripple={{ color: '#E9E8DF' }}
    >

      {/* ==========================================
          IMAGE
      ========================================== */}

      <View
        style={[
          styles.imageContainer,
          compact && styles.compactImageContainer,
        ]}
      >

        <Image
  source={{ uri: image }}
  style={[
    styles.image,
    compact && styles.compactImage,
  ]}
  contentFit="contain"
  cachePolicy="memory-disk"
  transition={150}
  onError={(event) => {
    console.log(
      'Product image failed:',
      image,
      event.error
    );
  }}
/>

        {/* DISCOUNT */}

        {discount > 0 && (
          <View
            style={[
              styles.discountBadge,
              compact && styles.compactDiscountBadge,
            ]}
          >
            <Text
              style={[
                styles.discountText,
                compact && styles.compactDiscountText,
              ]}
            >
              {discount}% OFF
            </Text>
          </View>
        )}

        {/* WISHLIST */}

        {/* WISHLIST */}

<Pressable
  style={styles.wishlistButton}
  onPress={async () => {
    console.log(
      'WISHLIST CLICKED:',
      product?.id,
      product?.name
    );

    if (!product?.id) {
      console.log('WISHLIST ERROR: Product ID missing');
      return;
    }

    const result = await toggleWishlist(product);

    console.log(
      'WISHLIST RESULT:',
      result
    );
  }}
  hitSlop={10}
>
  <Ionicons
    name={
      isWishlisted(product?.id)
        ? 'heart'
        : 'heart-outline'
    }
    size={21}
    color={
      isWishlisted(product?.id)
        ? '#B94A48'
        : '#4A4036'
    }
  />
</Pressable>
</View>

      {/* ==========================================
          CONTENT
      ========================================== */}

      <View
        style={[
          styles.content,
          compact && styles.compactContent,
        ]}
      >

        {/* PRODUCT NAME */}

        <Text
          style={[
            styles.name,
            compact && styles.compactName,
          ]}
          numberOfLines={2}
        >
          {product?.name ||
            'Product'}
        </Text>

        {/* DESCRIPTION */}

        {description ? (
          <Text
            style={
              [
                styles.description,
                compact && styles.compactDescription,
              ]
            }
            numberOfLines={1}
          >
            {description}
          </Text>
        ) : null}

        {/* RATING */}

        <View
          style={[
            styles.ratingRow,
            compact && styles.compactRatingRow,
          ]}
        >
          <Ionicons
            name="star"
            size={compact ? 15 : 11}
            color="#D9A52E"
          />

          <Text
            style={
              [
                styles.ratingValue,
                compact && styles.compactRatingValue,
              ]
            }
          >
            {Number(
              rating
            ).toFixed(1)}
          </Text>

          <Text
            style={[
              styles.dot,
              compact && styles.compactDot,
            ]}
          >
            •
          </Text>

          <Text
            style={
              [
                styles.reviewText,
                compact && styles.compactReviewText,
              ]
            }
          >
            {reviews} reviews
          </Text>
        </View>

        {/* PRICE */}

        <View
          style={[
            styles.priceRow,
            compact && styles.compactPriceRow,
          ]}
        >
          <Text
            style={[
              styles.price,
              compact && styles.compactPrice,
            ]}
          >
            ₹
            {price.toLocaleString(
              'en-IN'
            )}
          </Text>

          {compareAtPrice >
            price && (
            <Text
              style={
                [
                  styles.comparePrice,
                  compact && styles.compactComparePrice,
                ]
              }
            >
              ₹
              {compareAtPrice.toLocaleString(
                'en-IN'
              )}
            </Text>
          )}
        </View>

        {/* ======================================
            CART CONTROL
        ====================================== */}

        {isAdded ? (

          // ------------------------------------
          // QUANTITY CONTROL
          // ------------------------------------

          <View
            style={
              [
                styles.quantityContainer,
                compact && styles.compactQuantityContainer,
              ]
            }
          >

            {/* DECREASE */}

            <Pressable
              style={
                [
                  styles.quantityButton,
                  compact && styles.compactQuantityButton,
                ]
              }
              onPress={
                handleDecrease
              }
              hitSlop={6}
            >
              <Ionicons
                name="remove-outline"
                size={compact ? 20 : 18}
                color="#315C3B"
              />
            </Pressable>

            {/* QUANTITY */}

            <Text
              style={
                [
                  styles.quantityText,
                  compact && styles.compactQuantityText,
                ]
              }
            >
              {quantity}
            </Text>

            {/* INCREASE */}

            <Pressable
              style={
                [
                  styles.quantityButton,
                  compact && styles.compactQuantityButton,
                ]
              }
              onPress={
                handleIncrease
              }
              hitSlop={6}
            >
              <Ionicons
                name="add-outline"
                size={compact ? 20 : 18}
                color="#315C3B"
              />
            </Pressable>

          </View>

        ) : (

          // ------------------------------------
          // ADD TO CART
          // ------------------------------------

          <Pressable
            style={
              [
                styles.addButton,
                compact && styles.compactAddButton,
              ]
            }
            onPress={
              handleAddToCart
            }
          >
            <Ionicons
              name="bag-add-outline"
              size={compact ? 20 : 16}
              color="#FFFFFF"
            />

            <Text
              style={
                [
                  styles.addButtonText,
                  compact && styles.compactAddButtonText,
                ]
              }
            >
              Add to Cart
            </Text>
          </Pressable>

        )}

      </View>

    </Pressable>
  );
}

// ==================================================
// STYLES
// ==================================================

