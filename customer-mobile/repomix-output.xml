  // HEADER THEME
  // ============================================================

  const activeHeaderTheme = useMemo(() => {
    return getCategoryPastelTheme(selectedCategoryName, 0);
  }, [selectedCategoryName]);


  // ============================================================
  // SELECTED CATEGORY BANNER
  // ============================================================
  // Category banners now come from the API.
  // They are matched using category_id.
  // ============================================================

  const selectedCategoryBanner = useMemo(() => {
    if (selectedCategory === 'all') {
      return null;
    }

    const banners = Array.isArray(data.categoryBanners)
      ? data.categoryBanners
      : [];

    return (
      banners.find(
        (banner) =>
          String(banner?.category_id) === String(selectedCategory)
      ) || null
    );
  }, [data.categoryBanners, selectedCategory]);


  // ============================================================
  // CATEGORY SELECTION
  // ============================================================

  const handleSelectCategory = (category) => {
    const categoryId = category?.id
      ? String(category.id)
      : 'all';

    setSelectedCategory(categoryId);

    setSelectedCategoryName(category?.name || 'All');

    if (categoryId === 'all') {
      setCategoryProducts([]);
      setLoadingCategoryProducts(false);
    } else {
      setLoadingCategoryProducts(true);
    }
  };


  // ============================================================
  // FETCH PRODUCTS FOR SELECTED CATEGORY
  // ============================================================

  useEffect(() => {
    if (selectedCategory === 'all') {
      return;
    }

    let isMounted = true;

    const fetchCategoryProducts = async () => {
      try {
        setLoadingCategoryProducts(true);

        const items = await getProducts({
          categoryId: selectedCategory,
          limit: 100,
        });

        if (!isMounted) return;

        setCategoryProducts(
          Array.isArray(items) ? items : []
        );

      } catch (error) {
        console.error(
          'Error fetching category products:',
          error
        );

        if (isMounted) {
          setCategoryProducts([]);
        }

      } finally {
        if (isMounted) {
          setLoadingCategoryProducts(false);
        }
      }
    };

    fetchCategoryProducts();

    return () => {
      isMounted = false;
    };

  }, [selectedCategory]);


  // ============================================================
  // LOADING
  // ============================================================

  const [loading, setLoading] = useState(true);


  // ============================================================
  // ERROR
  // ============================================================

  const [error, setError] = useState(null);


  // ============================================================
  // LOAD HOME DATA
  // ============================================================

  const loadHome = useCallback(async () => {
    try {
      setError(null);

      console.log('HOME AUTH:', {
        loggedIn: Boolean(token),
        hasToken: Boolean(token),
      });

      const response = await getHomeData({
        token,
      });

      console.log(
        'JUST ARRIVED PRODUCTS:',
        response.newArrivals
      );

      console.log(
        'CATEGORY BANNERS:',
        response.categoryBanners
      );

      setData(response);

    } catch (error) {
      console.error('Home API Error:', error);

      setError(
        error?.message || 'Unable to load home.'
      );

    } finally {
      setLoading(false);
    }

  }, [token]);


  // ============================================================
  // LOAD BUY AGAIN PRODUCTS
  // ============================================================

  const loadBuyAgain = useCallback(async () => {
    if (!token) {
      setBuyAgainProducts([]);
      setBuyAgainLoading(false);
      return;
    }

    try {
      setBuyAgainLoading(true);

      const products = await getBuyAgainProducts(token);

      setBuyAgainProducts(
        Array.isArray(products) ? products : []
      );

    } catch (error) {
      console.error('Buy Again API Error:', error);
      setBuyAgainProducts([]);
    } finally {
      setBuyAgainLoading(false);
    }
  }, [token]);


  // ============================================================
  // LOAD ALL PRODUCTS
  // ============================================================

  const loadAllProducts = useCallback(async () => {
    try {
      setLoadingAllProducts(true);
      setAllProductsError(null);

      const products = [];
      let offset = 0;
      let page;

      do {
        page = await getProducts({
          limit: PRODUCTS_PAGE_SIZE,
          offset,
        });

        products.push(...page);
        offset += page.length;

      } while (page.length === PRODUCTS_PAGE_SIZE);

      setAllProducts(products);

    } catch (error) {
      console.error('All Products API Error:', error);

      setAllProducts([]);
      setAllProductsError(
        error?.message || 'Unable to load products.'
      );

    } finally {
      setLoadingAllProducts(false);
    }

  }, []);


  // ============================================================
  // REFRESH HOME WHEN SCREEN GETS FOCUS
  // ============================================================

  useFocusEffect(
    useCallback(() => {
      loadHome();
      loadBuyAgain();
      loadAllProducts();
    }, [loadHome, loadBuyAgain, loadAllProducts])
  );


  // ============================================================
  // FONT LOADING
  // ============================================================

  if (!fontsLoaded) {
    return (
      <SafeAreaView style={styles.safeArea}>
        <View style={styles.container}>
          <Text style={{ padding: 20, color: '#333' }}>
            Loading fonts...
          </Text>
        </View>
      </SafeAreaView>
    );
  }


  // ============================================================
  // INITIAL LOADING
  // ============================================================

  if (loading) {
    return (
      <SafeAreaView
        style={[
          styles.safeArea,
          {
            backgroundColor:
              activeHeaderTheme.statusBarColor,
          },
        ]}
        edges={['top', 'bottom']}
      >
        <LoadingScreen />
      </SafeAreaView>
    );
  }

  const allProductsSection = (
    <View style={styles.allProductsSection}>
      <View style={styles.allProductsDivider}>
        <Text style={styles.allProductsHeading}>{' '}</Text>
      </View>

      {loadingAllProducts ? (
        <ActivityIndicator
          style={styles.allProductsLoading}
          color={activeHeaderTheme.accent}
        />
      ) : allProductsError ? (
        <Text style={styles.allProductsError}>
          {allProductsError}
        </Text>
      ) : allProducts.length > 0 ? (
        <View style={styles.allProductsGrid}>
          {allProducts.map((product) => (
            <ProductCard
              key={product.id || product.slug}
              product={product}
              onPress={() => {
                if (product?.slug) {
                  router.push(`/products/${product.slug}`);
                }
              }}
            />
          ))}
        </View>
      ) : (
        <Text style={styles.allProductsEmpty}>
          No products available.
        </Text>
      )}
    </View>
  );

  const appHomeSectionElements = [
    {
      key: 'deals_of_week',
      content: <DealsOfTheWeek />,
    },
    {
      key: 'explore_ayurveda',
      content: <ExploreAyurveda categories={data.categories} />,
    },
    {
      key: 'bestsellers',
      content: <BestsellersRail products={data.featuredProducts} />,
    },
    {
      key: 'recently_viewed',
      content:
        !authLoading && isAuthenticated ? (
          <RecentlyViewed products={data.featuredProducts || []} />
        ) : null,
    },
    {
      key: 'available_coupons',
      content: <CouponsOffers coupons={data.coupons || []} />,
    },
    {
      key: 'just_arrived',
      content: <JustArrived products={data.newArrivals || []} />,
    },
    {
      key: 'category_campaigns',
      content: (
        <CategoryCampaigns
          campaigns={data.categoryCampaigns || []}
          onPressCampaign={(campaign) => {
            const category = Array.isArray(campaign.categories)
              ? campaign.categories[0]
              : campaign.categories;
            const categoryId =
              category?.id ?? campaign.category_id;

            if (!categoryId) return;

            router.navigate({
              pathname: '/(tabs)/categories',
              params: {
                categoryId: String(categoryId),
                categoryName:
                  category?.name || campaign.title || 'Products',
              },
            });
          }}
        />
      ),
    },
    {
      key: 'all_products',
      content: allProductsSection,
    },
  ]
    .filter(({ content }) => content)
    .map((entry) => {
      const configuredSection = (data.homeSections || []).find(
        (section) => {
          const sectionKey = normalizeHomeSectionKey(
            section?.key || section?.section_key
          );
          const definition = APP_HOME_SECTION_COMPONENTS.find(
            (item) => item.key === entry.key
          );
          return definition?.aliases.includes(sectionKey);
        }
      );
      const definition = APP_HOME_SECTION_COMPONENTS.find(
        (item) => item.key === entry.key
      );
      const configuredOrder = Number(configuredSection?.sort_order);

      return {
        ...entry,
        defaultOrder: definition.defaultOrder,
        sortOrder: Number.isFinite(configuredOrder)
          ? configuredOrder
          : definition.defaultOrder,
      };
    })
    .sort(
      (left, right) =>
        left.sortOrder - right.sortOrder ||
        left.defaultOrder - right.defaultOrder
    );


  // ============================================================
  // HOME UI
  // ============================================================

  return (
    <SafeAreaView
      style={[
        styles.safeArea,
        {
          backgroundColor:
            activeHeaderTheme.statusBarColor,
        },
      ]}
      edges={['top', 'bottom']}
    >
      <View style={styles.container}>

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={styles.scroll}
        >

          {/* HEADER */}

          <HomeHeader
            categories={data.categories}
            selectedCategoryId={selectedCategory}
            onSelectCategory={handleSelectCategory}
          />


          {/* ERROR */}

          {error ? (
            <View style={styles.error}>
              <Text style={styles.errorText}>
                {error}
              </Text>
            </View>
          ) : null}


          {/* CATEGORY VIEW */}

          {selectedCategory !== 'all' ? (

            <View style={styles.categoryViewContainer}>

              {/* CATEGORY BANNER FROM API */}

              {selectedCategoryBanner?.image_url ||
              selectedCategoryBanner?.mobile_image_url ? (
                <View style={styles.categoryBannerWrap}>
                  <Image
                    source={{
                      uri:
                        selectedCategoryBanner.mobile_image_url ||
                        selectedCategoryBanner.image_url,
                    }}
                    style={styles.categoryBanner}
                    contentFit="cover"
                    transition={200}
                    accessibilityLabel={
                      selectedCategoryBanner.title ||
                      `${selectedCategoryName} category banner`
                    }
                  />
                </View>
              ) : null}


              {/* CATEGORY PRODUCTS */}

              {loadingCategoryProducts ? (

                <View style={styles.categoryLoadingWrap}>
                  <ActivityIndicator
                    size="large"
                    color={activeHeaderTheme.accent}
                  />

                  <Text
                    style={[
                      styles.categoryLoadingText,
                      {
                        color:
                          activeHeaderTheme.accent,
                      },
                    ]}
                  >
                    Loading {selectedCategoryName} products...
                  </Text>
                </View>

              ) : categoryProducts.length > 0 ? (

                <View style={styles.categoryGrid}>
                  {categoryProducts.map((product) => (
                    <ProductCard
                      key={product.id}
                      product={product}
                      theme={activeHeaderTheme}
                      onPress={() => {
                        if (product?.slug) {
                          router.push(
                            `/products/${product.slug}`
                          );
                        }
                      }}
                    />
                  ))}
                </View>

              ) : (

                <View style={styles.categoryEmptyWrap}>

                  <Ionicons
                    name="leaf-outline"
                    size={42}
                    color={activeHeaderTheme.accent}
                  />

                  <Text
                    style={[
                      styles.categoryEmptyTitle,
                      {
                        color:
                          activeHeaderTheme.accent,
                      },
                    ]}
                  >
                    No products found
                  </Text>

                  <Text style={styles.categoryEmptySub}>
                    We are currently restocking Ayurvedic{' '}
                    {selectedCategoryName} essentials.
                  </Text>

                  <Pressable
                    style={[
                      styles.categoryBackHomeBtn,
                      {
                        backgroundColor:
                          activeHeaderTheme.accent,
                      },
                    ]}
                    onPress={() =>
                      handleSelectCategory({
                        id: 'all',
                        name: 'All',
                      })
                    }
                  >
                    <Text
                      style={styles.categoryBackHomeText}
                    >
                      View All Products
                    </Text>
                  </Pressable>

                </View>

              )}

            </View>

          ) : (

            /* NORMAL HOME CONTENT */

            <>
              {appHomeSectionElements.map(({ key, content }) =>
                React.cloneElement(content, { key })
              )}
            </>

          )}

        </ScrollView>

      </View>
    </SafeAreaView>
  );
}


// ============================================================
// STYLES
// ============================================================

const styles = StyleSheet.create({

  safeArea: {
    flex: 1,
    backgroundColor: '#CEA04B',
  },

  container: {
    flex: 1,
