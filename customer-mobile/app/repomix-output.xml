import React, {
  useEffect,
  useState,
} from 'react';

import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  
  useWindowDimensions,
} from 'react-native';
import {
  SafeAreaView,
} from 'react-native-safe-area-context';

import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { Image } from 'expo-image';

import {
  useLocalSearchParams,
  useRouter,
} from 'expo-router';

import {
  getProductBySlug,
} from '../../src/services/productService';
import {
  getProductReviews,
  submitProductReview,
} from '../../src/services/reviewService';

import { useAuth } from '../../src/context/AuthContext';
import {
  useCart,
} from '../../src/context/CartContext';
import { useWishlist } from '../../src/context/WishlistContext';

import ProductCard from '../../src/components/home/ProductCard';

export default function ProductDetailsScreen() {

  // ==========================================================
  // ROUTER
  // ==========================================================

  const {
    slug,
  } = useLocalSearchParams();

  const productSlug = slug ? String(slug) : '';
  const router =
    useRouter();

  const { width } = useWindowDimensions();
  const imageHeight = Math.min(width * 0.95, 460);
const [reviews, setReviews] = useState([]);
const [reviewsLoading, setReviewsLoading] = useState(false);
const { token, isAuthenticated } = useAuth();

const [reviewRating, setReviewRating] = useState(5);
const [reviewTitle, setReviewTitle] = useState('');
const [reviewText, setReviewText] = useState('');
const [reviewSubmitting, setReviewSubmitting] = useState(false);
const [reviewMessage, setReviewMessage] = useState('');
const [reviewError, setReviewError] = useState('');
  // ==========================================================
  // CART
  // ==========================================================

  const {
    cartItems,
    cartCount,
    addToCart,
    increaseQuantity,
    decreaseQuantity,
    removeFromCart,
  } = useCart();

  const {
    isWishlisted,
    toggleWishlist,
  } = useWishlist();

  // ==========================================================
  // PRODUCT STATE
  // ==========================================================

  const [product, setProduct] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [retryCount, setRetryCount] = useState(0);

  // ==========================================================
  // RETRY HANDLER
  // ==========================================================

  const handleRetry = () => {
    if (!productSlug) return;
    setRetryCount((count) => count + 1);
  };
const handleSubmitReview = async () => {
  if (!isAuthenticated || !token) {
    router.push('/login');
    return;
  }

  if (!reviewTitle.trim() && !reviewText.trim()) {
    setReviewError('Please enter a title or written feedback.');
    setReviewMessage('');
    return;
  }

  if (!product?.id) {
    setReviewError('Product information is unavailable.');
    return;
  }

  try {
    setReviewSubmitting(true);
    setReviewError('');
    setReviewMessage('');

    const result = await submitProductReview({
      productId: product.id,
      rating: reviewRating,
      title: reviewTitle,
      reviewText,
      token,
    });

    setReviewMessage(
      result.message || 'Your review was submitted for approval.'
    );

    setReviewTitle('');
    setReviewText('');
    setReviewRating(5);
  } catch (error) {
    setReviewError(
      error.message || 'Unable to submit your review.'
    );
  } finally {
    setReviewSubmitting(false);
  }
};
  // ==========================================================
  // LOAD WHEN PRODUCT / AUTH CHANGES
  // ==========================================================
useEffect(() => {
  if (!product?.id) return;

  let active = true;

  setReviewsLoading(true);

  getProductReviews(product.id)
    .then((data) => {
      if (active) setReviews(data);
    })
    .catch((err) => {
      console.warn('Product reviews:', err.message);
      if (active) setReviews([]);
    })
    .finally(() => {
      if (active) setReviewsLoading(false);
    });

  return () => {
    active = false;
  };
}, [product?.id]);
  useEffect(() => {
    let active = true;

    if (!slug) {
      return () => {
        active = false;
      };
    }

    Promise.resolve()
      .then(() => {
        if (!active) return null;

        setLoading(true);
        setError(null);
        return getProductBySlug(String(slug));
      })
      .then((data) => {
        if (!active) return;

        if (!data) {
          setProduct(null);
          setError('Product not found.');
          return;
        }

        setProduct(data);
      })
      .catch((err) => {
        if (!active) return;

        setProduct(null);
        setError(err?.message || 'Unable to load product.');
      })
      .finally(() => {
        if (active) setLoading(false);
      });

    return () => {
      active = false;
    };
  }, [slug, retryCount]);

  // ==========================================================
  // PRODUCT DATA
  // ==========================================================

  const variantId =
    product?.variant?.id ??
    null;

  const cartItem =
    cartItems.find(
      (item) =>
        item.productId ===
          product?.id &&
        item.variantId ===
          variantId
    );

  const isInCart =
    !!cartItem;

  const cartQuantity =
    Number(
      cartItem?.quantity || 0
    );

  const image =
    product?.image ||
    product?.image_url ||
    product?.thumbnail ||
    null;

  const price =
    Number(
      product?.variant?.price ??
        product?.price ??
        0
    );

  const comparePrice =
    Number(
      product?.variant
        ?.compare_at_price ??
        product?.compare_at_price ??
        0
    );

 const reviewCount = reviews.length;

const rating = reviewCount > 0
  ? reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / reviewCount
  : 0;

  const stock =
    Number(
      product?.variant
        ?.stock_quantity
    ) || 0;

  const variantName =
    product?.variant?.name ||
    '';

  const relatedProducts =
    product?.related_products ||
    [];

  const discount =
    comparePrice > price
      ? Math.round(
          ((comparePrice -
            price) /
            comparePrice) *
            100
        )
      : 0;

  const savingsAmount = comparePrice > price ? comparePrice - price : 0;

  const handleWishlistToggle = async () => {
    if (!product?.id) {
      return;
    }
    await toggleWishlist(product);
  };

  // ==========================================================
  // ADD TO CART
  // ==========================================================

  const handleAddToCart = () => {
    if (!product) {
      return;
    }

    addToCart(
      product,
      1,
      product.variant ?? null
    );
  };

  // ==========================================================
  // BUY NOW
  // ==========================================================

  const handleBuyNow = () => {
    if (!product) {
      return;
    }

    router.push({
      pathname: '/checkout',
      params: {
        buyNow: 'true',
        productId: String(product.id),
        productSlug: String(product.slug || slug),
        variantId: product.variant?.id
          ? String(product.variant.id)
          : '',
        quantity: '1',
      },
    });
  };

  // ==========================================================
  // INCREASE
  // ==========================================================

  const handleIncrease = () => {
    if (!cartItem) {
      return;
    }

    if (
      stock > 0 &&
      cartQuantity >= stock
    ) {
      return;
    }

    increaseQuantity(
      cartItem.itemKey
    );
  };

  // ==========================================================
  // DECREASE
  // ==========================================================

  const handleDecrease = () => {
    if (!cartItem) {
      return;
    }

    if (
      cartQuantity <= 1
    ) {
      removeFromCart(
        cartItem.itemKey
      );
      return;
    }

    decreaseQuantity(
      cartItem.itemKey
    );
  };

  // ==========================================================
  // LOADING STATE
  // ==========================================================

  if (slug && loading) {
    return (
      <SafeAreaView
        style={styles.screen}
        edges={['top', 'bottom']}
      >
        <View style={styles.center}>
          <View style={styles.loadingEmblem}>
            <ActivityIndicator
              size="large"
              color="#D9A52E"
            />
          </View>
          <Text style={styles.loadingBrand}>AUMVEDA</Text>
          <Text style={styles.loadingText}>
            Preparing botanical details...
          </Text>
        </View>
      </SafeAreaView>
    );
  }

  // ==========================================================
  // ERROR STATE
  // ==========================================================

  if (
    !slug ||
    error ||
    !product
  ) {
    return (
      <SafeAreaView
        style={styles.screen}
        edges={['top', 'bottom']}
      >
        <View style={styles.center}>
          <View style={styles.errorIconWrap}>
            <Ionicons
              name="leaf-outline"
              size={42}
              color="#D9A52E"
            />
          </View>

          <Text style={styles.errorTitle}>
            Product Unavailable
          </Text>

          <Text style={styles.errorText}>
            {error ||
              (!slug
                ? 'Product slug is missing.'
                : 'We could not load this Ayurvedic formulation.')}
          </Text>

          {slug && (
            <Pressable
              style={styles.retryButton}
              onPress={handleRetry}
            >
              <Text style={styles.retryText}>
                Retry Formulation
              </Text>
            </Pressable>
          )}
        </View>
      </SafeAreaView>
    );
  }

  // ==========================================================
  // UI
  // ==========================================================

  return (
    <SafeAreaView
      style={styles.screen}
      edges={['top', 'bottom']}
    >
      {/* =====================================================
          PREMIUM HEADER
      ===================================================== */}
      <View style={styles.header}>
        {/* BACK BUTTON */}
        <Pressable
          style={styles.headerButton}
          onPress={() => router.back()}
          hitSlop={8}
          accessibilityRole="button"
          accessibilityLabel="Go back"
        >
          <Ionicons
            name="arrow-back"
            size={20}
            color="#143828"
          />
        </Pressable>

        {/* TITLE / BRAND EMBLEM */}
        <View style={styles.headerTitleWrap}>
          <Text style={styles.headerEyebrow}>AUMVEDA BOTANICALS</Text>
          <Text
            style={styles.headerTitle}
            numberOfLines={1}
          >
            Pure Ayurveda
          </Text>
        </View>

        {/* RIGHT ACTIONS */}
        <View style={styles.headerActions}>
          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/search')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="Search products"
          >
            <Ionicons
              name="search-outline"
              size={19}
              color="#143828"
            />
          </Pressable>

          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/wishlist')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="View Wishlist"
          >
            <Ionicons
              name={isWishlisted(product?.id) ? 'heart' : 'heart-outline'}
              size={19}
              color={isWishlisted(product?.id) ? '#C2410C' : '#143828'}
            />
          </Pressable>

          <Pressable
            style={styles.headerButton}
            onPress={() => router.push('/cart')}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel={`Cart with ${cartCount} items`}
          >
            <Ionicons
              name="cart-outline"
              size={19}
              color="#143828"
            />
            {cartCount > 0 && (
              <View style={styles.headerCartBadge}>
                <Text style={styles.headerCartBadgeText}>
                  {cartCount > 99 ? '99+' : cartCount}
                </Text>
              </View>
            )}
          </Pressable>
        </View>
      </View>

      {/* =====================================================
          SCROLL CONTENT
      ===================================================== */}
      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.scrollContent}
      >
        {/* ===================================================
            HERO PRODUCT IMAGE STAGE
        =================================================== */}
        <View
          style={[
            styles.imageStage,
            {
              height: imageHeight,
            },
          ]}
        >
          {/* Subtle gold concentric halo behind bottle */}
          <View style={styles.imageHaloOuter}>
            <View style={styles.imageHaloInner} />
          </View>

          {image ? (
            <Image
  source={{ uri: image }}
  style={styles.productImage}
  contentFit="contain"
  cachePolicy="memory-disk"
  transition={0}
/>
          ) : (
            <View style={styles.imagePlaceholder}>
              <Ionicons
                name="leaf-outline"
                size={64}
                color="#D9A52E"
              />
              <Text style={styles.placeholderText}>
                Authentic Formulation
              </Text>
            </View>
          )}

          {/* DISCOUNT BADGE */}
          {discount > 0 && (
            <View style={styles.discountBadge}>
              <Text style={styles.discountSparkle}>✦</Text>
              <Text style={styles.discountText}>
                {discount}% OFF
              </Text>
            </View>
          )}

          {/* FLOATING WISHLIST BUTTON */}
          <Pressable
            style={styles.favoriteButton}
            onPress={handleWishlistToggle}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel="Toggle wishlist"
          >
            <Ionicons
              name={
                isWishlisted(product?.id)
                  ? 'heart'
                  : 'heart-outline'
              }
              size={21}
              color={
                isWishlisted(product?.id)
                  ? '#C2410C'
                  : '#123D2B'
              }
            />
          </Pressable>

          {/* AUTHENTICITY PILL AT BOTTOM OF IMAGE */}
          <View style={styles.authenticityPill}>
            <Ionicons
              name="shield-checkmark"
              size={13}
              color="#D9A52E"
            />
            <Text style={styles.authenticityPillText}>
              100% Certified Ayurvedic Formulation
            </Text>
          </View>
        </View>

        {/* ===================================================
            PRODUCT INFORMATION CONTAINER
        =================================================== */}
        <View style={styles.infoCard}>
          {/* CATEGORY & RATING ROW */}
          <View style={styles.eyebrowRow}>
            <Text style={styles.categoryLabel}>
              ✦ AYURVEDA WELLNESS ✦
            </Text>

            <View style={styles.ratingBox}>
              <Ionicons
                name="star"
                size={12}
                color="#D9A52E"
              />
              <Text style={styles.ratingValue}>
                {rating.toFixed(1)}
              </Text>
              <Text style={styles.reviewCount}>
                ({reviewCount})
              </Text>
            </View>
          </View>

          {/* PRODUCT NAME */}
          <Text style={styles.productName}>
            {product.name}
          </Text>

          {/* PRICE ROW */}
          <View style={styles.priceContainer}>
            <View style={styles.priceRow}>
              <Text style={styles.priceCurrency}>₹</Text>
              <Text style={styles.priceValue}>
                {price.toLocaleString('en-IN')}
              </Text>

              {comparePrice > price && (
                <Text style={styles.comparePrice}>
                  ₹{comparePrice.toLocaleString('en-IN')}
                </Text>
              )}

              {savingsAmount > 0 && (
                <View style={styles.savingsPill}>
                  <Text style={styles.savingsPillText}>
                    Save ₹{savingsAmount.toLocaleString('en-IN')}
                  </Text>
                </View>
              )}
            </View>

            <Text style={styles.taxInclusiveText}>
              Inclusive of all taxes • Free express shipping
            </Text>
          </View>

          {/* VARIANT / SIZE */}
          {variantName ? (
            <View style={styles.variantContainer}>
              <Text style={styles.variantLabel}>Select Size / Variant</Text>
              <View style={styles.variantBadge}>
                <Ionicons
                  name="leaf"
                  size={13}
                  color="#D9A52E"
                />
                <Text style={styles.variantText}>
                  {variantName}
                </Text>
              </View>
            </View>
          ) : null}

          {/* 3-PILLAR BOTANICAL TRUST ROW */}
          <View style={styles.trustRow}>
            <View style={styles.trustItem}>
              <View style={styles.trustIconCircle}>
                <Ionicons
