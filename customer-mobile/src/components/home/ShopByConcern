                      styles.minimalIconWrap,
                      { backgroundColor: theme.iconBg },
                    ]}
                  >
                    {item.image_url ? (
                      <Image
                        source={{ uri: item.image_url }}
                        style={styles.minimalImage}
                        contentFit="cover"
                        transition={150}
                      />
                    ) : (
                      <Ionicons
                        name={icon}
                        size={15}
                        color={theme.accent}
                      />
                    )}
                  </View>

                  <Ionicons
                    name="arrow-forward"
                    size={11}
                    color={theme.accent}
                    style={styles.tallArrow}
                  />
                </View>

                <Text
                  style={[
                    styles.tallName,
                    { color: theme.accent },
                  ]}
