                    accessibilityLabel={
                      passwordVisible ? 'Hide password' : 'Show password'
                    }
                    onPress={() => setPasswordVisible((visible) => !visible)}
                    hitSlop={10}
                    style={styles.eyeBtn}
                  >
                    <Ionicons
                      name={passwordVisible ? 'eye-outline' : 'eye-off-outline'}
                      size={19}
                      color="#8F877B"
                    />
                  </Pressable>
                </View>

                {/* FORGOT PASSWORD */}
                <Link
                  href={{
                    pathname: '/(auth)/forgot-password',
                    params: { returnTo: postLoginRoute },
                  }}
                  style={styles.forgot}
                >
                  Forgot Password?
                </Link>

                {/* LOGIN BUTTON WITH GRADIENT & SUBTLE LEAF */}
                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.88}
                  style={[styles.loginButton, loading && styles.buttonDisabled]}
                  onPress={handleLogin}
                  disabled={loading}
                >
                  <LinearGradient
                    colors={['#174C35', '#123D2B', '#0D3021']}
                    start={{ x: 0, y: 0 }}
                    end={{ x: 1, y: 0 }}
                    style={styles.loginGradient}
                  >
                    <View style={styles.btnLeafWatermark} pointerEvents="none">
                      <Ionicons
                        name="leaf"
                        size={30}
                        color="rgba(255, 255, 255, 0.12)"
                      />
                    </View>

                    {loading ? (
                      <ActivityIndicator color={colors.white} />
                    ) : (
                      <View style={styles.loginBtnContent}>
                        <Text style={styles.loginButtonText}>Login</Text>
                        <Ionicons
                          name="arrow-forward"
                          size={17}
                          color={colors.white}
                        />
                      </View>
                    )}
                  </LinearGradient>
                </TouchableOpacity>

                {/* DIVIDER */}
                <View style={styles.divider}>
                  <View style={styles.dividerLine} />
                  <Text style={styles.dividerText}>OR</Text>
                  <View style={styles.dividerLine} />
                </View>

                {/* GOOGLE SIGN IN BUTTON */}
                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.85}
                  style={[
                    styles.googleButton,
                    loading && styles.buttonDisabled,
                  ]}
                  disabled={loading}
                  onPress={async () => {
                    try {
                      setLoading(true);

                      const { session, error, cancelled } =
                        await signInWithGoogle();

                      if (error) {
                        Alert.alert('Google Sign-In Failed', error.message);
                        return;
                      }

                      if (cancelled) {
                        return;
                      }

                      if (session) {
                        await loginWithGoogleSession(session);
                        router.replace(postLoginRoute);
                      } else {
                        Alert.alert(
                          'Sign-in incomplete',
                          'Google sign-in finished without an authenticated session. Please try again.'
                        );
                      }
                    } catch (error) {
                      Alert.alert(
                        'Google Sign-In Failed',
                        error?.message || 'Please try again.'
                      );
                    } finally {
                      setLoading(false);
                    }
                  }}
                >
                  <View style={styles.googleIconCircle}>
                    <Ionicons name="logo-google" size={17} color="#EA4335" />
                  </View>
                  <Text style={styles.googleButtonText}>
                    Continue with Google
                  </Text>
                </TouchableOpacity>
              </View>

              {/* CREATE ACCOUNT SWITCH */}
              <View style={styles.accountSwitch}>
                <Text style={styles.accountText}>
                  Don&apos;t have an account?
                </Text>
                <Link href="/(auth)/register" style={styles.accountLink}>
                  Create Account
                </Link>
              </View>

              {/* FOOTER MOTIF */}
              <View style={styles.footerNote}>
                <View style={styles.footerRule} />
                <MaterialCommunityIcons
                  name="leaf"
                  size={16}
                  color="#7A945A"
                  style={styles.footerLeafIcon}
                />
                <View style={styles.footerRule} />
              </View>
              <Text style={styles.footerText}>
                Mindful wellness, naturally
              </Text>
            </View>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

