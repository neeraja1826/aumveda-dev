    shadowOpacity: 0.08,
    shadowRadius: 10,
    elevation: 3,
    overflow: 'hidden',
    position: 'relative',
  },

  /* TOP-RIGHT BOTANICAL LEAF ACCENT */
  topRightLeaves: {
    position: 'absolute',
    top: -4,
    right: 16,
    flexDirection: 'row',
    zIndex: 0,
  },

  /* BOTTOM-RIGHT DEEP GREEN ORNAMENTAL WAVE WITH GOLD TRIM */
  bottomRightSwoop: {
    position: 'absolute',
    right: -45,
    bottom: -60,
    width: 250,
    height: 96,
    borderRadius: 70,
    backgroundColor: '#113B29',
    borderTopWidth: 2,
    borderColor: '#C59128',
    transform: [{ rotate: '-18deg' }],
    zIndex: 0,
  },

  /* SECTION HEADER */
  headerContainer: {
    paddingHorizontal: 14,
    marginBottom: 14,
    zIndex: 1,
  },

  /* EYEBROW PILL BADGE */
  eyebrowBadge: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 5,
    backgroundColor: 'rgba(197, 154, 69, 0.10)',
    paddingVertical: 2,
    paddingHorizontal: 8,
    borderRadius: 16,
    borderWidth: 1,
    borderColor: '#C59A45',
    alignSelf: 'flex-start',
    marginBottom: 2,
    marginTop: -8,
  },

  eyebrowText: {
    fontSize: 7,
    fontFamily: 'InterSemiBold',
    fontWeight: '700',
    color: '#7C5318',
    letterSpacing: 1.3,
  },

  headingRow: {
    width: '100%',
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
  },

  titleColumn: {
    alignItems: 'flex-start',
  },

  title: {
    fontSize: 27,
    lineHeight: 33,
    fontFamily: 'PlayfairSemiBold',
    fontWeight: '700',
    color: '#113B29',
    letterSpacing: 0.1,
  },

  titleGold: {
    color: '#C58F1D',
  },

  /* SIGNATURE GOLD UNDERLINE BELOW 'Explore' */
  goldUnderline: {
    width: 44,
    height: 2.5,
    borderRadius: 1.5,
    backgroundColor: '#C58F1D',
    marginTop: 4,
  },

  /* DEEP FOREST GREEN VIEW ALL PILL WITH GOLD BORDER */
  viewAllButton: {
    flexDirection: 'row',
    alignItems: 'center',
    paddingVertical: 7,
    paddingHorizontal: 14,
    borderRadius: 22,
    backgroundColor: '#113B29',
    borderWidth: 1.5,
    borderColor: '#FFB005',
    gap: 5,
    shadowColor: '#113B29',
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.15,
    shadowRadius: 4,
    elevation: 2,
    marginTop: -32,
  },

  viewAllPressed: {
