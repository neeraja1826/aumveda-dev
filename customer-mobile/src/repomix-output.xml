                </Text>

                <Link
                  href="/(auth)/register"
                  style={styles.accountLink}
                >
                  Create Account
                </Link>
              </View>

              <View style={styles.footerNote}>
                <View style={styles.footerDot} />

                <Text style={styles.footerText}>
                  Mindful wellness, naturally
                </Text>

                <View style={styles.footerDot} />
              </View>

            </View>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

