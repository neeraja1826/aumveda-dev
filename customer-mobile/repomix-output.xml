<file path="app/address/index.jsx">
import React, {
  useCallback,
  useEffect,
  useState,
} from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';
import {
  ActivityIndicator,
  Alert,
  BackHandler,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';

import {
  useLocalSearchParams,
  useRouter,
} from 'expo-router';
import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { SafeAreaView } from 'react-native-safe-area-context';

import {
  getAddresses,
  createAddress,
  updateAddress,
  deleteAddress,
  setDefaultAddress,
} from '../../src/services/addressService';
import { getCurrentLocation } from '../../src/services/locationService';
import { useAuth } from '../../src/context/AuthContext';

import { colors } from '../../src/theme/colors';

export default function AddressRoute() {
  const router = useRouter();
  const { token } = useAuth();
  const params = useLocalSearchParams();

  const returnToCheckout =
    params?.returnToCheckout === 'true';

  const editAddressId =
    params?.addressId || null;

  // -----------------------------------------
  // STATE
  // -----------------------------------------

  const [addresses, setAddresses] =
    useState([]);

  const [loading, setLoading] =
    useState(true);

  const [saving, setSaving] =
    useState(false);

  const [deletingId, setDeletingId] =
    useState(null);

  const [editingId, setEditingId] =
    useState(editAddressId);

  const [showForm, setShowForm] =
    useState(Boolean(editAddressId));

  // -----------------------------------------
  // FORM
  // -----------------------------------------

  const [label, setLabel] =
    useState('');

  const [labelType, setLabelType] =
    useState('');

  const [recipientName, setRecipientName] =
    useState('');

  const [phone, setPhone] =
    useState('');

  const [addressLine1, setAddressLine1] =
    useState('');

  const [addressLine2, setAddressLine2] =
    useState('');

  const [city, setCity] =
    useState('');

  const [state, setState] =
    useState('');

  const [postalCode, setPostalCode] =
    useState('');

  const [country, setCountry] =
    useState('India');

  const [detectingLocation, setDetectingLocation] =
    useState(false);

  const [detectedLocation, setDetectedLocation] =
    useState('');

  // -----------------------------------------
  // LOAD ADDRESSES
  // -----------------------------------------

  const loadAddresses = useCallback(async () => {
    try {
      setLoading(true);
      const data = await getAddresses(token);
      setAddresses(data || []);
    } catch (error) {
      console.error('Load addresses error:', error);

      Alert.alert(
        'Unable to load addresses',
        error?.message || 'Something went wrong.'
      );
    } finally {
      setLoading(false);
    }
  }, [token]);

  useEffect(() => {
    loadAddresses();
  }, [loadAddresses]);

  // -----------------------------------------
  // POPULATE FORM
  // -----------------------------------------

  const populateForm = (address) => {
    const savedLabel = String(address?.label || '').trim();
    const standardLabel = ['Home', 'Office'].find(
      (option) => option.toLowerCase() === savedLabel.toLowerCase()
    );
    setLabelType(standardLabel || 'Other');
    setLabel(standardLabel || savedLabel);

    setRecipientName(
      address?.recipient_name || ''
    );

    setPhone(
      address?.phone || ''
    );

    setAddressLine1(
      address?.address_line1 || ''
    );

    setAddressLine2(
      address?.address_line2 || ''
    );

    setCity(
      address?.city || ''
    );

    setState(
      address?.state || ''
    );

    setPostalCode(
      address?.postal_code || ''
    );
    setCountry(address?.country || 'India');
  };

  // -----------------------------------------
  // CLEAR FORM
  // -----------------------------------------

  const clearForm = () => {
    setLabel('');
    setLabelType('');
    setRecipientName('');
    setPhone('');
    setAddressLine1('');
    setAddressLine2('');
    setCity('');
    setState('');
    setPostalCode('');
    setCountry('India');
    setEditingId(null);
    setDetectedLocation('');
  };

  useEffect(() => {
    if (!showForm || Platform.OS !== 'android') {
      return undefined;
    }

    const subscription = BackHandler.addEventListener(
      'hardwareBackPress',
      () => {
        setShowForm(false);
        clearForm();
        return true;
      }
    );

    return () => subscription.remove();
  }, [showForm]);

  // -----------------------------------------
  // OPEN ADD FORM
  // -----------------------------------------

  const handleAddNew = () => {
    clearForm();
    setShowForm(true);
  };

  // -----------------------------------------
  // OPEN EDIT FORM
  // -----------------------------------------

  const handleEdit = (address) => {
    setEditingId(address.id);
    populateForm(address);
    setShowForm(true);
  };

  // -----------------------------------------
  // VALIDATE
  // -----------------------------------------

  const validateForm = () => {
    if (!labelType || !label.trim()) {
      Alert.alert(
        'Missing address label',
        labelType === 'Other'
          ? 'Please enter a label for this address.'
          : 'Please select an address label.'
      );
      return false;
    }

    if (!recipientName.trim()) {
      Alert.alert(
        'Missing information',
        'Please enter the recipient name.'
      );
      return false;
    }

    const cleanPhone =
      phone.replace(/\D/g, '');

    if (cleanPhone.length !== 10) {
      Alert.alert(
        'Invalid phone number',
        'Please enter a valid 10-digit phone number.'
      );
      return false;
    }

    if (!addressLine1.trim()) {
      Alert.alert(
        'Missing information',
        'Please enter your address.'
      );
      return false;
    }

    if (!city.trim()) {
      Alert.alert(
        'Missing information',
        'Please enter your city.'
      );
      return false;
    }

    if (!state.trim()) {
      Alert.alert(
        'Missing information',
        'Please enter your state.'
      );
      return false;
    }

    const cleanPostalCode =
      postalCode.replace(/\D/g, '');

    if (cleanPostalCode.length !== 6) {
      Alert.alert(
        'Invalid pincode',
        'Please enter a valid 6-digit pincode.'
      );
      return false;
    }

    return true;
  };

  const handleDetectCurrentLocation = async () => {
    if (detectingLocation) return;

    try {
      setDetectingLocation(true);
      setDetectedLocation('');
      const location = await getCurrentLocation();
      const locationPostalCode = String(
        location.postalCode || ''
      ).replace(/\D/g, '');

      if (location.addressLine1) {
        setAddressLine1(location.addressLine1);
      }
      if (location.addressLine2) {
        setAddressLine2(location.addressLine2);
      }
      if (location.city) setCity(location.city);
      if (location.state) setState(location.state);
      if (location.country) setCountry(location.country);
      if (locationPostalCode.length === 6) {
        setPostalCode(locationPostalCode);
      }
      setDetectedLocation(location.address);
    } catch (error) {
      console.error(
        'Current location detection failed:',
        error
      );
      Alert.alert(
        'Unable to Detect Location',
        error?.message ||
          'Could not detect your location. Please try again.'
      );
    } finally {
      setDetectingLocation(false);
    }
  };

  // -----------------------------------------
  // SAVE ADDRESS
  // -----------------------------------------

  // -----------------------------------------
// SAVE ADDRESS
// -----------------------------------------

// -----------------------------------------
// SAVE ADDRESS
// -----------------------------------------


const handleSave = async () => {
  if (saving) return;
  if (!validateForm()) return;

  try {
    setSaving(true);

    if (!token) {
      Alert.alert(
        'Login required',
        'Please login before adding an address.'
      );
      return;
    }

    const payload = {
      label: label.trim() || null,
      recipient_name: recipientName.trim(),
      phone: phone.replace(/\D/g, ''),
      address_line1: addressLine1.trim(),
      address_line2: addressLine2.trim() || null,
      city: city.trim(),
      state: state.trim(),
      postal_code: postalCode.replace(/\D/g, ''),
      country: country.trim() || 'India',
    };

    const savedAddress = editingId
      ? await updateAddress(token, editingId, payload)
      : await createAddress(token, payload);

    if (!savedAddress) {
      throw new Error('Address could not be saved.');
    }

    const refreshedAddresses = await getAddresses(token);

    // Support common API response formats.
    const addressList = Array.isArray(refreshedAddresses)
      ? refreshedAddresses
      : Array.isArray(refreshedAddresses?.addresses)
        ? refreshedAddresses.addresses
        : Array.isArray(refreshedAddresses?.data)
          ? refreshedAddresses.data
          : Array.isArray(refreshedAddresses?.data?.addresses)
            ? refreshedAddresses.data.addresses
            : Array.isArray(refreshedAddresses?.data?.data)
              ? refreshedAddresses.data.data
              : [];

    setAddresses(addressList);

    if (returnToCheckout) {
      const savedId =
        savedAddress?.id ??
        savedAddress?.data?.id ??
        savedAddress?.address?.id ??
        savedAddress?.data?.address?.id ??
        editingId;

      const addressToReturn =
        addressList.find(
          (item) => savedId && String(item.id) === String(savedId)
        ) ||
        addressList.find(
          (item) =>
            String(item?.phone || '').replace(/\D/g, '') ===
              payload.phone &&
            String(item?.address_line1 || '').trim() ===
              payload.address_line1
        );

      if (!addressToReturn?.id) {
        throw new Error(
          'Address saved, but it could not be identified in your address list. Please open the address list and select it.'
        );
      }

      router.replace({
        pathname: '/checkout',
        params: {
          addressId: String(addressToReturn.id),
          ...(params?.buyNow
            ? { buyNow: String(params.buyNow) }
            : {}),
          ...(params?.productId
            ? { productId: String(params.productId) }
            : {}),
          ...(params?.productSlug
            ? { productSlug: String(params.productSlug) }
            : {}),
          ...(params?.variantId
            ? { variantId: String(params.variantId) }
            : {}),
          ...(params?.quantity
            ? { quantity: String(params.quantity) }
            : {}),
        },
      });

      return;
    }

    setShowForm(false);
    clearForm();

    Alert.alert(
      editingId ? 'Address updated' : 'Address added',
      editingId
        ? 'Your address has been updated successfully.'
        : 'Your address has been added successfully.'
    );
  } catch (error) {
    console.error('Save address error:', error);

    Alert.alert(
      'Unable to save address',
      error?.message ||
        'Something went wrong while saving the address.'
    );
  } finally {
    setSaving(false);
  }
};

  // -----------------------------------------
  // DELETE
  // -----------------------------------------

  const handleDelete = (address) => {
    Alert.alert(
      'Delete address',
      'Are you sure you want to delete this address?',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Delete',
          style: 'destructive',
          onPress: async () => {
            try {
              setDeletingId(address.id);

              if (!token) {
                return;
              }

              await deleteAddress(
                token,
                address.id
              );

              await loadAddresses();
            } catch (error) {
              console.error(
                'Delete address error:',
                error
              );

              Alert.alert(
                'Unable to delete',
                error?.message ||
                  'Could not delete this address.'
              );
            } finally {
              setDeletingId(null);
            }
          },
        },
      ]
    );
  };

  const handleSetDefault = async (addressId) => {
    if (!token || !addressId) {
      Alert.alert(
        'Unable to set default',
        'Please login and try again.'
      );
      return;
    }

    try {
      await setDefaultAddress(token, addressId);

      const response = await getAddresses(token);
      const refreshedAddresses = Array.isArray(response)
        ? response
        : Array.isArray(response?.addresses)
          ? response.addresses
          : Array.isArray(response?.data?.addresses)
            ? response.data.addresses
            : Array.isArray(response?.data)
              ? response.data
              : [];

      setAddresses(refreshedAddresses);

      Alert.alert(
        'Success',
        'Default address updated successfully.'
      );
    } catch (error) {
      console.error('Set default address error:', error);

      Alert.alert(
        'Error',
        error?.message ||
          'Unable to update the default address. Please try again.'
      );
    }
  };

  // -----------------------------------------
  // SELECT ADDRESS FOR CHECKOUT
  // -----------------------------------------
// -----------------------------------------
// SELECT ADDRESS FOR CHECKOUT
// -----------------------------------------


const LOCATION_STORAGE_KEY = '@aumveda_selected_location';

const handleSelectAddress = async (address) => {
  if (!address?.id) {
    Alert.alert(
      'Unable to select address',
      'This address has no valid ID.'
    );
    return;
  }

  // CASE 1: Address selection from checkout
  if (returnToCheckout) {
    router.replace({
      pathname: '/checkout',
      params: {
        ...params,
        addressId: String(address.id),
      },
    });
    return;
  }

  // CASE 2: Address selection from the header
  const selectedLocation = [
    address.city,
    address.state,
  ]
    .filter(Boolean)
    .join(', ');

  try {
    await AsyncStorage.setItem(
      LOCATION_STORAGE_KEY,
      selectedLocation ||
        address.address_line1 ||
        'Delivery location'
    );

    router.back();
  } catch (error) {
    console.error('Address selection error:', error);

    Alert.alert(
      'Unable to select address',
      'Please try again.'
    );
  }
};


  // -----------------------------------------
  // LOADING
  // -----------------------------------------

  if (loading) {
    return (
      <SafeAreaView
        style={styles.loadingContainer}
        edges={['top', 'bottom']}
      >
        <ActivityIndicator
          size="large"
          color={colors.primary}
        />

        <Text style={styles.loadingText}>
          Loading addresses...
        </Text>
      </SafeAreaView>
    );
  }

  // -----------------------------------------
  // FORM
  // -----------------------------------------

  if (showForm) {
    return (
      <SafeAreaView
        style={styles.formScreen}
        edges={['top', 'bottom']}
      >
        <KeyboardAvoidingView
          style={styles.container}
          behavior={
            Platform.OS === 'ios'
              ? 'padding'
              : undefined
          }
        >
        <LinearGradient
          colors={['#E5F2E4', '#D9EAD7', '#CDE2CB']}
          start={{ x: 0, y: 0 }}
          end={{ x: 0, y: 1 }}
          style={styles.formHeaderGradient}
        >
          <View style={styles.formHeader}>
            <Pressable
              style={styles.formBackButton}
              onPress={() => {
                setShowForm(false);
                clearForm();
              }}
            >
              <Ionicons
                name="arrow-back"
                size={20}
                color={colors.primary}
              />
            </Pressable>

            <View style={styles.formHeaderTitleWrap}>
              <Text style={styles.headerEyebrow}>DELIVERY DETAILS</Text>
              <Text style={styles.headerTitle}>
                {editingId ? 'Edit Address' : 'Add Address'}
              </Text>
            </View>

            <View style={styles.headerSpacer} />
          </View>
        </LinearGradient>

        <ScrollView
          showsVerticalScrollIndicator={false}
          contentContainerStyle={
            styles.formContent
          }
          keyboardShouldPersistTaps="handled"
        >
          <View style={styles.formCard}>
            <Text style={styles.label}>
              Address Line 1 *
            </Text>

            <TextInput
              value={addressLine1}
              onChangeText={setAddressLine1}
              placeholder="House / Flat / Street / Area"
              placeholderTextColor={
                colors.textSecondary
              }
              style={[
                styles.input,
                styles.multilineInput,
              ]}
              multiline
            />

            <Text style={styles.label}>
              Address Line 2
            </Text>

            <TextInput
              value={addressLine2}
              onChangeText={setAddressLine2}
              placeholder="Landmark / Apartment / Optional"
              placeholderTextColor={
                colors.textSecondary
              }
              style={[
                styles.input,
                styles.multilineSmall,
              ]}
              multiline
            />

            <Text style={styles.label}>
              Phone Number *
            </Text>

            <TextInput
              value={phone}
              onChangeText={setPhone}
              placeholder="10-digit mobile number"
              placeholderTextColor={colors.textSecondary}
              keyboardType="phone-pad"
              maxLength={10}
              style={styles.input}
            />

            <View style={styles.row}>
              <View style={styles.half}>
                <Text style={styles.label}>
                  City *
                </Text>

                <TextInput
                  value={city}
                  onChangeText={setCity}
                  placeholder="City"
                  placeholderTextColor={
                    colors.textSecondary
                  }
                  style={styles.input}
                />
              </View>

              <View style={styles.half}>
                <Text style={styles.label}>
                  State *
                </Text>

                <TextInput
                  value={state}
                  onChangeText={setState}
                  placeholder="State"
                  placeholderTextColor={
                    colors.textSecondary
                  }
                  style={styles.input}
                />
              </View>
            </View>

            <Text style={styles.label}>
              Postal Code *
            </Text>

            <TextInput
              value={postalCode}
              onChangeText={setPostalCode}
              placeholder="6-digit pincode"
              placeholderTextColor={
                colors.textSecondary
              }
              keyboardType="number-pad"
              maxLength={6}
              style={styles.input}
            />

            <Text style={styles.label}>
              Country *
            </Text>

            <TextInput
              value={country}
              onChangeText={setCountry}
              placeholder="Country"
              placeholderTextColor={colors.textSecondary}
              autoComplete="country-name"
              style={styles.input}
            />

            <Text style={styles.label}>
              Recipient Name *
            </Text>

            <TextInput
              value={recipientName}
              onChangeText={setRecipientName}
              placeholder="Full name"
              placeholderTextColor={colors.textSecondary}
              style={styles.input}
            />

            <Text style={styles.label}>
              SAVE THIS ADDRESS AS *
            </Text>

            <View style={styles.labelChips}>
              {['Home', 'Office', 'Other'].map((option) => {
                const isSelected = labelType === option;
                return (
                  <Pressable
                    key={option}
                    accessibilityRole="button"
                    accessibilityState={{ selected: isSelected }}
                    onPress={() => {
                      setLabelType(option);
                      if (option !== 'Other') {
                        setLabel(option);
                      } else if (labelType !== 'Other') {
                        setLabel('');
                      }
                    }}
                    style={[
                      styles.labelChip,
                      isSelected && styles.selectedLabelChip,
                    ]}
                  >
                    {option !== 'Other' ? (
                      <Ionicons
                        name={option === 'Home' ? 'home-outline' : 'business-outline'}
                        size={16}
                        color={isSelected ? colors.white : colors.primary}
                      />
                    ) : null}
                    <Text
                      style={[
                        styles.labelChipText,
                        isSelected && styles.selectedLabelChipText,
                      ]}
                    >
                      {option}
                    </Text>
                  </Pressable>
                );
              })}
            </View>

            {labelType === 'Other' ? (
              <TextInput
                value={label}
                onChangeText={setLabel}
                placeholder="Enter address label"
                placeholderTextColor={colors.textSecondary}
                style={styles.input}
                returnKeyType="done"
                accessibilityLabel="Custom address label"
              />
            ) : null}

            <Pressable
              style={[
                styles.currentLocationButton,
                (saving || detectingLocation) &&
                  styles.disabledButton,
              ]}
              onPress={handleDetectCurrentLocation}
              disabled={saving || detectingLocation}
            >
              {detectingLocation ? (
                <ActivityIndicator
                  size="small"
                  color={colors.primary}
                />
              ) : (
                <Ionicons
                  name="navigate-outline"
                  size={17}
                  color={colors.primary}
                />
              )}
              <Text style={styles.currentLocationButtonText}>
                {detectingLocation
                  ? 'Detecting current location...'
                  : 'Use Current Location'}
              </Text>
            </Pressable>

            {detectedLocation ? (
              <Text
                style={styles.detectedLocationText}
                accessibilityRole="text"
              >
                Location detected: {detectedLocation}
              </Text>
            ) : null}

            <View style={styles.privacyNote}>
              <Ionicons
                name="shield-checkmark-outline"
                size={16}
                color={colors.primary}
              />
              <Text style={styles.privacyNoteText}>
                Your address is saved securely and only used for delivery.
              </Text>
            </View>

            <Pressable
              style={[
                styles.saveButton,
                saving &&
                  styles.disabledButton,
              ]}
              onPress={handleSave}
              disabled={saving || detectingLocation}
            >
              {saving ? (
                <ActivityIndicator
                  size="small"
                  color={colors.white}
                />
              ) : (
                <>
                  <Ionicons
                    name="checkmark-circle-outline"
                    size={19}
                    color={colors.white}
                  />

                  <Text
                    style={
                      styles.saveButtonText
                    }
                  >
                    {editingId
                      ? 'Update Address'
                      : 'Save Address'}
                  </Text>
                </>
              )}
            </Pressable>
          </View>
        </ScrollView>
        </KeyboardAvoidingView>
      </SafeAreaView>
    );
  }

  // -----------------------------------------
  // ADDRESS LIST
  // -----------------------------------------

  return (
    <SafeAreaView
      style={styles.addressListScreen}
      edges={['top', 'bottom']}
    >
      <LinearGradient
        colors={['#E5F2E4', '#D9EAD7', '#CDE2CB']}
        start={{ x: 0, y: 0 }}
        end={{ x: 0, y: 1 }}
        style={styles.listHeaderGradient}
      >
        <View style={styles.listHeader}>
          <Pressable
            style={styles.listBackButton}
            onPress={() => router.back()}
            accessibilityRole="button"
            accessibilityLabel="Go back"
          >
            <Ionicons
              name="arrow-back"
              size={20}
              color={colors.primary}
            />
          </Pressable>

          <View style={styles.listHeaderTitleWrap}>
            <Text style={styles.listHeaderEyebrow}>DELIVERY DETAILS</Text>
            <Text style={styles.listHeaderTitle}>My Addresses</Text>
          </View>

          {addresses.length > 0 ? (
            <View style={styles.addressCountBadge}>
              <Ionicons name="location" size={13} color={colors.primary} />
              <Text style={styles.addressCountText}>{addresses.length}</Text>
            </View>
          ) : (
            <View style={styles.headerSpacer} />
          )}
        </View>
      </LinearGradient>

      <ScrollView
        style={styles.addressListBody}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={
          styles.listContent
        }
      >
        {addresses.length === 0 ? (
          <View style={styles.emptyCard}>
            <View style={styles.emptyIcon}>
              <Ionicons
                name="location-outline"
                size={34}
                color={colors.primary}
              />
            </View>

            <Text style={styles.emptyTitle}>
              No address saved
            </Text>

            <Text style={styles.emptyText}>
              Add a delivery address to make
              checkout faster and easier.
            </Text>

            <Pressable
              style={styles.addButton}
              onPress={handleAddNew}
            >
