/* ============================================================
   AUMVEDA VENDOR WEB — PRODUCTS PAGE

   Product approval flow:
   draft -> pending -> active / rejected

   Vendor can submit draft and rejected products.
   Only authorized operators can approve or reject.

   This page never changes approval status directly.
   It calls the dedicated Vendor Backend API.
============================================================ */


/* ============================================================
   UTILITIES
============================================================ */

function normalizeProducts(response) {
  if (Array.isArray(response)) {
    return response;
  }

  if (Array.isArray(response?.data)) {
    return response.data;
  }

  if (Array.isArray(response?.products)) {
    return response.products;
  }

  if (Array.isArray(response?.data?.products)) {
    return response.data.products;
  }

  return [];
}


function normalizeStatus(value) {
  return String(value || "draft")
    .trim()
    .toLowerCase();
}


function formatStatus(value) {
  return normalizeStatus(value)
    .replace(/[_-]/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}


function formatNumber(value) {
  const number = Number(value);

  return Number.isFinite(number)
    ? new Intl.NumberFormat("en-IN").format(number)
    : "—";
}


function formatDate(value) {
  if (!value) {
    return "—";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return new Intl.DateTimeFormat("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(date);
}


function getVariantCount(product) {
  if (product.variant_count != null) {
    return Number(product.variant_count) || 0;
  }

  if (Array.isArray(product.variants)) {
    return product.variants.length;
  }

  return 0;
}


function getProductStock(product) {
  if (product.total_stock != null) {
    const amount = Number(product.total_stock);

    return Number.isFinite(amount)
      ? amount
      : null;
  }

  if (Array.isArray(product.variants)) {
    return product.variants.reduce(
      (total, variant) =>
        total + (
          Number(variant.stock_quantity) || 0
        ),
      0
    );
  }

  return null;
}


function getImageUrl(product) {
  const candidates = [
    product.primary_image_url,
    product.image_url,
    product.image,
    product.primary_image,
  ];

  for (const candidate of candidates) {
    if (
      typeof candidate === "string" &&
      candidate.trim()
    ) {
      return candidate;
    }

    if (
      candidate &&
      typeof candidate === "object" &&
      typeof candidate.image_url === "string"
    ) {
      return candidate.image_url;
    }
  }

  return null;
}


function canSubmitForApproval(product) {
  const currentStatus = normalizeStatus(
    product?.status
  );

  return (
    currentStatus === "draft" ||
    currentStatus === "rejected"
  );
}


function canArchiveProduct(product) {
  const currentStatus = normalizeStatus(
    product?.status
  );

  return (
    currentStatus === "draft" ||
    currentStatus === "rejected" ||
    currentStatus === "active"
  );
}


function isContentEditable(product) {
  return canSubmitForApproval(product);
}


/* ============================================================
   STAT CARD
============================================================ */

function ProductStat({
  icon: Icon,
  label,
  value,
  tone = "green",
}) {
  return (
    <div className={`avp-stat avp-stat--${tone}`}>
      <div className="avp-stat-icon">
        <Icon
          size={21}
          strokeWidth={1.8}
        />
      </div>

      <div className="avp-stat-info">
        <span>{label}</span>
        <strong>{formatNumber(value)}</strong>
      </div>
    </div>
  );
}


/* ============================================================
   PRODUCT THUMBNAIL
============================================================ */

function ProductThumbnail({ product }) {
  const [broken, setBroken] = useState(false);

  const url = getImageUrl(product);

  useEffect(() => {
    setBroken(false);
  }, [url]);

  return (
    <div className="avp-thumbnail">
      {url && !broken ? (
        <img
          src={url}
          alt={product.name || "Product"}
          loading="lazy"
          onError={() => setBroken(true)}
        />
      ) : (
        <Package
          size={25}
          strokeWidth={1.5}
        />
      )}
    </div>
  );
}


/* ============================================================
   PRODUCT ROW
============================================================ */

function ProductRow({
  product,
  archiving,
  submitting,
  onArchive,
  onSubmitForApproval,
}) {
  const navigate = useNavigate();

  const currentStatus = normalizeStatus(
    product.status
  );

  const stock = getProductStock(product);
  const variantCount = getVariantCount(product);

  const rating = Number(product.average_rating);

  const ratingAvailable =
    Number(product.review_count || 0) > 0 &&
    Number.isFinite(rating);

  const allowSubmit = canSubmitForApproval(
    product
  );

  const allowArchive = canArchiveProduct(
    product
  );

  const allowContentEditing = isContentEditable(
    product
  );

  const busy = archiving || submitting;

  return (
    <tr>
      {/* PRODUCT IDENTITY */}
      <td>
        <div className="avp-product-identity">
          <ProductThumbnail product={product} />

          <div className="avp-product-details">
            <strong title={product.name}>
              {product.name || "Unnamed Product"}
            </strong>

            <span title={product.slug || ""}>
              {product.slug || "No product slug"}
            </span>
          </div>
        </div>
      </td>

      {/* APPROVAL STATUS */}
      <td>
        <span
          className={
            `avp-status avp-status--${currentStatus}`
          }
        >
          <span className="avp-status-dot" />
          {formatStatus(currentStatus)}
        </span>
      </td>

      {/* VARIANTS */}
      <td>
        <div className="avp-table-number">
          <Layers3 size={16} />
          {formatNumber(variantCount)}
        </div>
      </td>

      {/* STOCK */}
      <td>
        <div className="avp-stock-cell">
          <strong>
            {stock === null
              ? "—"
              : formatNumber(stock)}
          </strong>

          <small>
            {stock === null
              ? "Stock unavailable"
              : stock === 0
                ? "Out of stock"
                : "Units in stock"}
          </small>
        </div>
      </td>

      {/* RATING */}
      <td>
        {ratingAvailable ? (
          <span className="avp-rating">
            <Star
              size={15}
              fill="currentColor"
            />

            {rating.toFixed(1)}

            <small>
              ({formatNumber(product.review_count)})
            </small>
          </span>
        ) : (
          <span className="avp-muted">
            No reviews
          </span>
        )}
      </td>

      {/* LAST UPDATED */}
      <td>
        <span className="avp-date">
          {formatDate(product.updated_at)}
        </span>
      </td>

      {/* ACTIONS */}
      <td>
        <div
          className="avp-row-actions"
          style={{
            display: "flex",
            alignItems: "center",
            flexWrap: "wrap",
            gap: "8px",
          }}
        >
          {/* VARIANTS */}
          <button
            type="button"
            className="avp-action-button"
            title={
              allowContentEditing
                ? "Manage product variants"
                : (
                  currentStatus === "active"
                    ? "View approved variants; inventory updates remain available separately"
                    : "View product variants (editing locked)"
                )
            }
            aria-label={
              `View variants for ${product.name}`
            }
            onClick={() =>
              navigate(
                `/products/${product.id}/variants`
              )
            }
          >
            <Layers3 size={16} />

            <span>
              Variants
            </span>
          </button>

          {/* IMAGES */}
          <button
            type="button"
            className="avp-icon-action"
            title={
              allowContentEditing
                ? "Manage product images"
                : "View product images (editing locked)"
            }
            aria-label={
              `View images for ${product.name}`
            }
            onClick={() =>
              navigate(
                `/products/${product.id}/images`
              )
            }
          >
            <Images size={17} />
          </button>

          {/* SUBMIT FOR APPROVAL */}
          {allowSubmit && (
            <button
              type="button"
              className="avp-action-button"
              title={
                currentStatus === "rejected"
                  ? "Resubmit product for approval"
                  : "Submit product for approval"
              }
              aria-label={
                `Submit ${product.name} for approval`
              }
              disabled={busy}
              onClick={() =>
                onSubmitForApproval(product)
              }
              style={{
                whiteSpace: "nowrap",
              }}
            >
              {submitting ? (
                <RefreshCw
                  size={16}
                  className="avp-spin"
                />
              ) : (
                <Send size={16} />
              )}

              <span>
                {submitting
                  ? "Submitting..."
                  : currentStatus === "rejected"
                    ? "Resubmit"
                    : "Submit"}
              </span>
            </button>
          )}

          {/* ARCHIVE */}
          <button
            type="button"
            className={
              "avp-icon-action " +
              "avp-icon-action--danger"
            }
            title={
              currentStatus === "pending"
                ? "Cannot archive during approval review"
                : currentStatus === "archived"
                  ? "Already archived"
                  : "Archive product"
            }
            aria-label={
              `Archive ${product.name}`
            }
            disabled={
              busy || !allowArchive
            }
            onClick={() => onArchive(product)}
          >
            {archiving ? (
              <RefreshCw
                size={17}
                className="avp-spin"
              />
            ) : (
              <Archive size={17} />
            )}
          </button>
        </div>
      </td>
    </tr>
  );
}


/* ============================================================
   PRODUCTS PAGE
============================================================ */

export default function ProductsPage() {
  const [products, setProducts] = useState([]);

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [loadedOnce, setLoadedOnce] = useState(false);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");

  // Archive operation.
  const [archivingId, setArchivingId] = useState(null);
  const [archiveTarget, setArchiveTarget] = useState(null);

  // Submit for approval operation.
  const [submittingId, setSubmittingId] = useState(null);
  const [submitTarget, setSubmitTarget] = useState(null);


  /* ==========================================================
     LOAD PRODUCTS
  ========================================================== */

  const loadProducts = useCallback(
    async (silent = false) => {
      if (silent) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError("");

      try {
        const response = await vendorApi.getProducts();

        setProducts(normalizeProducts(response));
        setLoadedOnce(true);

        return true;
      } catch (err) {
        setError(
          err?.message ||
          "Unable to load the product catalogue."
        );

        return false;
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    []
  );


  useEffect(() => {
    loadProducts();
  }, [loadProducts]);


  /* ==========================================================
     PRODUCT SUMMARY
  ========================================================== */

  const summary = useMemo(() => {
    return products.reduce(
      (totals, product) => {
        const current = normalizeStatus(
          product.status
        );

        totals.total += 1;

        if (current === "active") {
          totals.active += 1;
        }

        if (current === "draft") {
          totals.draft += 1;
        }

        if (current === "pending") {
          totals.pending += 1;
        }

        if (current === "rejected") {
          totals.rejected += 1;
        }

        if (current === "archived") {
          totals.archived += 1;
        }

        return totals;
      },
      {
        total: 0,
        active: 0,
        draft: 0,
        pending: 0,
        rejected: 0,
        archived: 0,
      }
    );
  }, [products]);


  /* ==========================================================
     SEARCH AND STATUS FILTER
  ========================================================== */

  const filteredProducts = useMemo(() => {
    const query = search.trim().toLowerCase();

    return products.filter((product) => {
      const currentStatus = normalizeStatus(
        product.status
      );

      const variants = Array.isArray(
        product.variants
      )
        ? product.variants
        : [];

      const searchable = [
        product.name,
        product.slug,
        ...variants.map(
          (variant) => variant.sku
        ),
        ...variants.map(
          (variant) => variant.name
        ),
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      const matchesSearch =
        !query ||
        searchable.includes(query);

      const matchesStatus =
        statusFilter === "all" ||
        currentStatus === statusFilter;

      return matchesSearch && matchesStatus;
    });
  }, [
    products,
    search,
    statusFilter,
  ]);


  /* ==========================================================
     ARCHIVE PRODUCT
  ========================================================== */

  async function handleArchive() {
    const product = archiveTarget;

    if (
      !product ||
      !canArchiveProduct(product) ||
      archivingId ||
      submittingId
    ) {
      return;
    }

    setArchivingId(product.id);
    setArchiveTarget(null);

    setError("");
    setSuccess("");

    try {
      await vendorApi.deleteProduct(product.id);

      setProducts((current) =>
        current.map((item) =>
          item.id === product.id
            ? {
                ...item,
                status: "archived",
              }
            : item
        )
      );

      setSuccess(
        `"${product.name}" was archived successfully.`
      );

      // Reconcile the catalogue with backend state.
      try {
        const response = await vendorApi.getProducts();

        setProducts(normalizeProducts(response));
      } catch {
        // Preserve successful archive feedback.
        // Refresh can be retried manually.
      }
    } catch (err) {
      setError(
        err?.message ||
        "Unable to archive product."
      );
    } finally {
      setArchivingId(null);
    }
  }


  /* ==========================================================
     SUBMIT PRODUCT FOR APPROVAL
  ========================================================== */

  async function handleSubmitForApproval() {
    const product = submitTarget;

    if (
      !product ||
      !canSubmitForApproval(product) ||
      submittingId ||
      archivingId
    ) {
      return;
    }

    setSubmittingId(product.id);

    setError("");
    setSuccess("");

    try {
      // This is the real FastAPI endpoint.
      // The frontend never writes status directly.
      const response =
        await vendorApi.submitProductForApproval(
          product.id
        );

      if (
        response?.status !== "pending" &&
        response?.product?.status !== "pending"
      ) {
        throw new Error(
          "The backend did not confirm that the product is pending."
        );
      }

      // Close the confirmation only after success.
      setSubmitTarget(null);

      // Reflect confirmed backend status immediately.
      setProducts((current) =>
        current.map((item) =>
          item.id === product.id
            ? {
                ...item,
                status: "pending",
                updated_at:
                  response?.product?.updated_at ||
                  item.updated_at,
              }
            : item
        )
      );

      setSuccess(
        `"${product.name}" was submitted for approval successfully.`
      );

      // Retrieve the latest server-side product states.
      // Don't turn a successful submission into an error
      // just because the follow-up refresh fails.
      try {
        const latestResponse =
          await vendorApi.getProducts();

        setProducts(
          normalizeProducts(latestResponse)
        );
      } catch {
        // User can refresh manually.
      }
    } catch (err) {
      setError(
        err?.message ||
        "Unable to submit product for approval."
      );
    } finally {
      setSubmittingId(null);
    }
  }


  /* ==========================================================
     INITIAL LOADING
  ========================================================== */

  if (loading && !loadedOnce) {
    return (
      <div className="avp-page">
        <div className="avp-loading">
          <RefreshCw
            size={30}
            className="avp-spin"
          />

          <strong>
            Loading your products
          </strong>

          <p>
            Retrieving your vendor catalogue.
          </p>
        </div>
      </div>
    );
  }


  /* ==========================================================
     INITIAL ERROR
  ========================================================== */

  if (error && !loadedOnce) {
    return (
      <div className="avp-page">
        <div className="avp-loading">
          <CircleAlert size={35} />

          <h2>
            Unable to load products
          </h2>

          <p>{error}</p>

          <button
            type="button"
            className={
              "avp-button avp-button--primary"
            }
            onClick={() => loadProducts()}
          >
            <RefreshCw size={17} />
            Try Again
          </button>
        </div>
      </div>
    );
  }


  /* ==========================================================
     PAGE
  ========================================================== */

  return (
    <div className="avp-page">

      {/* ======================================================
          PAGE INTRO
      ====================================================== */}

      <section className="avp-intro">
        <div className="avp-intro-copy">
          <span className="avp-eyebrow">
            PRODUCT MANAGEMENT
          </span>

          <h1>
            Your product catalogue
          </h1>

          <p>
            Organise your products, manage stock and
            keep your AUMVEDA store ready for customers.
          </p>
        </div>

        <div className="avp-intro-actions">
          <button
            type="button"
            className={
              "avp-button avp-button--secondary"
            }
            disabled={refreshing}
            onClick={() => loadProducts(true)}
          >
            <RefreshCw
              size={17}
              className={
                refreshing ? "avp-spin" : ""
              }
            />

            {refreshing
              ? "Refreshing..."
              : "Refresh"}
          </button>

          <Link
            to="/products/new"
            className={
              "avp-button avp-button--primary"
            }
          >
            <Plus size={18} />
            Add New Product
          </Link>
        </div>
      </section>


      {/* ======================================================
          ERROR MESSAGE
      ====================================================== */}

      {error && (
        <div
          className={
            "avp-message avp-message--error"
          }
          role="alert"
        >
          <CircleAlert size={18} />

          <span>{error}</span>

          <button
            type="button"
            aria-label="Dismiss error"
            onClick={() => setError("")}
          >
            <X size={16} />
          </button>
        </div>
      )}


      {/* ======================================================
          SUCCESS MESSAGE
      ====================================================== */}

      {success && (
        <div
          className={
            "avp-message avp-message--success"
          }
          role="status"
        >
          <CheckCircle2 size={18} />

          <span>{success}</span>

          <button
            type="button"
            aria-label="Dismiss success message"
            onClick={() => setSuccess("")}
          >
            <X size={16} />
          </button>
        </div>
      )}


      {/* ======================================================
          SUMMARY
      ====================================================== */}

      <section
        className="avp-stats"
        aria-label="Product statistics"
      >
        <ProductStat
          icon={Package}
          label="Total Products"
          value={summary.total}
          tone="green"
        />

        <ProductStat
          icon={PackageCheck}
          label="Active Products"
          value={summary.active}
          tone="sage"
        />

        <ProductStat
          icon={FilePenLine}
          label="Draft Products"
          value={summary.draft}
          tone="cream"
        />

        <ProductStat
          icon={Archive}
          label="Archived Products"
          value={summary.archived}
          tone="neutral"
        />
      </section>


      {/* ======================================================
          CATALOGUE
      ====================================================== */}

      <section className="avp-catalogue">
        <header className="avp-catalogue-header">
          <div>
            <span className="avp-eyebrow">
              YOUR INVENTORY
            </span>

            <h2>
              All Products
            </h2>

            <p>
              Search and manage products registered
              under your business.
            </p>

            <p
              style={{
                marginTop: "8px",
                fontSize: "13px",
              }}
            >
              {formatNumber(summary.pending)} awaiting review
              {" · "}
              {formatNumber(summary.rejected)} rejected
            </p>
          </div>

          <span className="avp-result-count">
            {formatNumber(
              filteredProducts.length
            )}{" "}
            results
          </span>
        </header>


        {/* ====================================================
            SEARCH AND FILTERS
        ==================================================== */}

        <div className="avp-toolbar">
          <label className="avp-search">
            <Search size={19} />

            <input
              type="search"
              value={search}
              onChange={(event) =>
                setSearch(event.target.value)
              }
              placeholder={
                "Search products, SKU or variant..."
              }
              aria-label="Search products"
            />

            {search && (
              <button
                type="button"
                onClick={() => setSearch("")}
                aria-label={
                  "Clear product search"
                }
              >
                <X size={16} />
              </button>
            )}
          </label>

          <label className="avp-filter">
            <SlidersHorizontal size={17} />

            <select
              value={statusFilter}
              onChange={(event) =>
                setStatusFilter(event.target.value)
              }
              aria-label={
                "Filter by product status"
              }
            >
              <option value="all">
                All statuses
              </option>

              <option value="active">
                Active
              </option>

              <option value="draft">
                Draft
              </option>

              <option value="pending">
                Pending Approval
              </option>

              <option value="rejected">
                Rejected
              </option>

              <option value="archived">
                Archived
              </option>
            </select>

            <ChevronDown size={15} />
          </label>
        </div>


        {/* ====================================================
            EMPTY STATE
        ==================================================== */}

        {filteredProducts.length === 0 ? (
          <div className="avp-empty">
            <span className="avp-empty-icon">
              <ClipboardList size={30} />
            </span>

            <h3>
              {products.length === 0
                ? "Your catalogue is empty"
                : "No matching products"}
            </h3>

            <p>
              {products.length === 0
                ? (
                  "Add your first product to start " +
                  "building your vendor catalogue."
                )
                : (
                  "Try another search term or clear " +
                  "your filters."
                )}
            </p>

            {products.length === 0 ? (
              <Link
                to="/products/new"
                className={
                  "avp-button avp-button--primary"
                }
              >
                <Plus size={17} />
                Add Product
              </Link>
            ) : (
              <button
                type="button"
                className={
                  "avp-button avp-button--secondary"
                }
                onClick={() => {
                  setSearch("");
                  setStatusFilter("all");
                }}
              >
                Clear Filters
              </button>
            )}
          </div>
        ) : (
          <div className="avp-table-scroll">
            <table className="avp-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Status</th>
                  <th>Variants</th>
                  <th>Stock</th>
                  <th>Rating</th>
                  <th>Updated</th>
                  <th>Manage</th>
                </tr>
              </thead>

              <tbody>
                {filteredProducts.map(
                  (product) => (
                    <ProductRow
                      key={product.id}
                      product={product}
                      archiving={
                        archivingId === product.id
                      }
                      submitting={
                        submittingId === product.id
                      }
                      onArchive={setArchiveTarget}
                      onSubmitForApproval={
                        setSubmitTarget
                      }
                    />
                  )
                )}
              </tbody>
            </table>
          </div>
        )}


        {/* ====================================================
            CATALOGUE FOOTER
        ==================================================== */}

        {filteredProducts.length > 0 && (
          <footer className="avp-catalogue-footer">
            <span>
              Showing{" "}
              {filteredProducts.length} of{" "}
              {products.length} products
            </span>

            <Link to="/inventory">
              Open Inventory
              <ArrowRight size={16} />
            </Link>
          </footer>
        )}
      </section>


      {/* ======================================================
          SUBMIT FOR APPROVAL CONFIRMATION
      ====================================================== */}

      {submitTarget && (
        <div
          className="avp-dialog-overlay"
          onMouseDown={(event) => {
            if (
              event.target ===
                event.currentTarget &&
              !submittingId
            ) {
              setSubmitTarget(null);
            }
          }}
        >
          <div
            className="avp-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="avp-submit-title"
            aria-describedby="avp-submit-description"
          >
            <span className="avp-dialog-icon">
              <Send size={25} />
            </span>

            <h2 id="avp-submit-title">
              Submit product for approval?
            </h2>

            <p id="avp-submit-description">
              <strong>
                {submitTarget.name}
              </strong>{" "}
              will be sent for review.
            </p>

            <p>
              Before submitting, make sure your product
              has a complete description, at least one
              active variant with a valid price, and at
              least one product image.
            </p>

            <p>
              Once submitted, its status will change to
              <strong> Pending</strong>. Product details,
              images, and pricing will be locked while
              awaiting approval.
            </p>

            <div className="avp-dialog-actions">
              <button
                type="button"
                className={
                  "avp-button avp-button--secondary"
                }
                disabled={Boolean(submittingId)}
                onClick={() =>
                  setSubmitTarget(null)
                }
              >
                Cancel
              </button>

              <button
                type="button"
                className={
                  "avp-button avp-button--primary"
                }
                disabled={Boolean(submittingId)}
                onClick={
                  handleSubmitForApproval
                }
              >
                {submittingId ? (
                  <RefreshCw
                    size={17}
                    className="avp-spin"
                  />
                ) : (
                  <Send size={17} />
                )}

                {submittingId
                  ? "Submitting..."
                  : "Submit for Approval"}
              </button>
            </div>
          </div>
        </div>
      )}


      {/* ======================================================
          ARCHIVE CONFIRMATION
      ====================================================== */}

      {archiveTarget && (
        <div
          className="avp-dialog-overlay"
          onMouseDown={(event) => {
            if (
              event.target ===
                event.currentTarget &&
              !archivingId
            ) {
              setArchiveTarget(null);
            }
          }}
        >
          <div
            className="avp-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="avp-archive-title"
          >
            <span className="avp-dialog-icon">
              <Archive size={25} />
            </span>

            <h2 id="avp-archive-title">
              Archive this product?
            </h2>

            <p>
              <strong>
                {archiveTarget.name}
              </strong>{" "}
              will be marked as archived.
              It will no longer be an active product
              listing.
            </p>

            <div className="avp-dialog-actions">
              <button
                type="button"
                className={
                  "avp-button avp-button--secondary"
                }
                disabled={Boolean(archivingId)}
                onClick={() =>
                  setArchiveTarget(null)
                }
              >
                Cancel
              </button>

              <button
                type="button"
                className={
                  "avp-button avp-button--danger"
                }
                disabled={Boolean(archivingId)}
                onClick={handleArchive}
              >
                {archivingId ? (
                  <RefreshCw
                    size={17}
                    className="avp-spin"
                  />
                ) : (
                  <Archive size={17} />
                )}

                {archivingId
                  ? "Archiving..."
                  : "Archive Product"}
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
