<file path="src/screens/RegisterScreen.jsx">
import React, { useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  Image,
  ImageBackground,
  KeyboardAvoidingView,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from 'react-native';
import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';
import { SafeAreaView } from 'react-native-safe-area-context';
import { LinearGradient } from 'expo-linear-gradient';
import { router, useLocalSearchParams } from 'expo-router';

import { useAuth } from '../context/AuthContext';
import { register } from '../services/authService';
import { signInWithGoogle } from '../services/googleAuth';
import { colors } from '../theme/colors';
import { getPostLoginRoute } from '../utils/authNavigation';

export default function RegisterScreen() {
  const { loginWithGoogleSession } = useAuth();
  const { returnTo } = useLocalSearchParams();
  const postLoginRoute = getPostLoginRoute(returnTo);

  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
  const [passwordVisible, setPasswordVisible] = useState(false);

  const handleRegister = async () => {
    const trimmedName = name.trim();
    const trimmedEmail = email.trim().toLowerCase();

    if (!trimmedName || !trimmedEmail || !password) {
      Alert.alert('Missing Details', 'Please fill in all fields.');
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmedEmail)) {
      Alert.alert('Invalid Email', 'Please enter a valid email address.');
      return;
    }

    if (password.length < 8) {
      Alert.alert(
        'Weak Password',
        'Your password must contain at least 8 characters.'
      );
      return;
    }

    try {
      setLoading(true);
      const response = await register(
        trimmedName,
        trimmedEmail,
        password
      );

      console.log('Registration response:', response);

      Alert.alert(
        'Registration Successful',
        'Your account has been created. Please log in.',
        [
          {
            text: 'Go to Login',
            onPress: () =>
              router.replace({
                pathname: '/(auth)/login',
                params: { returnTo: postLoginRoute },
              }),
          },
        ]
      );
    } catch (error) {
      console.error('Registration failed:', error);

      Alert.alert(
        'Registration Failed',
        error?.message || 'Unable to create your account. Please try again.'
      );
    } finally {
      setLoading(false);
    }
  };

  const handleGoogleSignIn = async () => {
    try {
      setGoogleLoading(true);

      const { session, error, cancelled } = await signInWithGoogle();

      if (cancelled) return;
      if (error) throw error;

      if (!session) {
        throw new Error('Google sign-in did not return a session.');
      }

      await loginWithGoogleSession(session);
      router.replace(postLoginRoute);
    } catch (error) {
      Alert.alert(
        'Google Sign-In Failed',
        error?.message || 'Please try again.'
      );
    } finally {
      setGoogleLoading(false);
    }
  };

  const isBusy = loading || googleLoading;

  return (
    <SafeAreaView style={styles.container} edges={['top', 'bottom']}>
      <KeyboardAvoidingView
        style={styles.container}
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}
      >
        <ScrollView
          contentContainerStyle={styles.content}
          keyboardShouldPersistTaps="handled"
          showsVerticalScrollIndicator={false}
          bounces={false}
        >
          {/* ==========================================
              HERO HEADER AREA WITH BOTANICAL BACKDROP
          ========================================== */}
          <ImageBackground
            source={require('../../assets/deals-botanical.jpg')}
            resizeMode="cover"
            style={styles.hero}
          >
            {/* RICH FOREST GREEN LUXURY GRADIENT OVERLAY */}
            <LinearGradient
              colors={[
                'rgba(18, 61, 43, 0.88)',
                'rgba(18, 61, 43, 0.72)',
                'rgba(18, 61, 43, 0.40)',
              ]}
              start={{ x: 0, y: 0 }}
              end={{ x: 0.8, y: 1 }}
              style={styles.heroOverlay}
            />

            <View style={styles.heroContent}>
              {/* GOLD LOTUS EMBLEM */}
              <MaterialCommunityIcons
                name="flower-tulip-outline"
                size={38}
                color="#E5BD69"
                style={styles.brandMark}
              />

              {/* BRAND TITLE WITH REGISTERED MARK */}
              <View style={styles.brandRow}>
                <Text style={styles.brand}>AUMVEDA</Text>
                <Text style={styles.registeredMark}>®</Text>
              </View>

              {/* SUBTITLE */}
              <Text style={styles.eyebrow}>— NATURAL WELLNESS —</Text>

              {/* TAGLINE */}
              <Text style={styles.brandDescription}>
                Thoughtful wellness rooted in nature{'\n'}and guided by Ayurvedic wisdom.
              </Text>
            </View>
          </ImageBackground>

          {/* ==========================================
              LUXURY CREATE ACCOUNT FORM CARD
          ========================================== */}
          <View style={styles.authCard}>
            {/* TOP-RIGHT SUBTLE WATERMARK LEAF */}
            <Image
              source={require('../../assets/leaves-top-left.png')}
              style={styles.topRightLeaf}
              resizeMode="contain"
              pointerEvents="none"
            />

            <View style={styles.formSection}>
              {/* HEADING BLOCK */}
              <View style={styles.heading}>
                <View style={styles.welcomeRow}>
                  <View style={styles.headingRule} />
                  <Text style={styles.headingEyebrow}>CREATE ACCOUNT</Text>
                  <View style={styles.headingRule} />
                </View>

                <Text style={styles.title}>Join AUMVEDA</Text>

                <Text style={styles.subtitle}>
                  Create your account and begin your wellness journey.
                </Text>
              </View>

              {/* FORM FIELDS */}
              <View style={styles.form}>
                {/* FULL NAME */}
                <View style={styles.labelRow}>
                  <Ionicons name="person-outline" size={15} color="#123D2B" />
                  <Text style={styles.inputLabel}>Full Name</Text>
                </View>

                <View style={styles.inputContainer}>
                  <Ionicons
                    name="person-outline"
                    size={19}
                    color="#8F877B"
                    style={styles.inputIcon}
                  />
                  <TextInput
                    value={name}
                    onChangeText={setName}
                    placeholder="Enter your full name"
                    placeholderTextColor="#8F877B"
                    autoCapitalize="words"
                    autoCorrect={false}
                    textContentType="name"
                    style={styles.input}
                    returnKeyType="next"
                    editable={!isBusy}
                  />
                </View>

                {/* EMAIL ADDRESS */}
                <View style={[styles.labelRow, styles.fieldSpacing]}>
                  <Ionicons name="mail-outline" size={15} color="#123D2B" />
                  <Text style={styles.inputLabel}>Email Address</Text>
                </View>

                <View style={styles.inputContainer}>
                  <Ionicons
                    name="mail-outline"
                    size={19}
                    color="#8F877B"
                    style={styles.inputIcon}
                  />
                  <TextInput
                    value={email}
                    onChangeText={setEmail}
                    placeholder="Enter your email"
                    placeholderTextColor="#8F877B"
                    keyboardType="email-address"
                    autoCapitalize="none"
                    autoCorrect={false}
                    textContentType="emailAddress"
                    style={styles.input}
                    returnKeyType="next"
                    editable={!isBusy}
                  />
                </View>

                {/* PASSWORD */}
                <View style={[styles.labelRow, styles.fieldSpacing]}>
                  <Ionicons name="lock-closed-outline" size={15} color="#123D2B" />
                  <Text style={styles.inputLabel}>Password</Text>
                </View>

                <View style={styles.inputContainer}>
                  <Ionicons
                    name="lock-closed-outline"
                    size={19}
                    color="#8F877B"
                    style={styles.inputIcon}
                  />
                  <TextInput
                    value={password}
                    onChangeText={setPassword}
                    placeholder="Create a password"
                    placeholderTextColor="#8F877B"
                    secureTextEntry={!passwordVisible}
                    textContentType="newPassword"
                    autoCapitalize="none"
                    style={styles.input}
                    returnKeyType="done"
                    onSubmitEditing={handleRegister}
                    editable={!isBusy}
                  />
                  <Pressable
                    accessibilityRole="button"
                    accessibilityLabel={
                      passwordVisible ? 'Hide password' : 'Show password'
                    }
                    onPress={() => setPasswordVisible((visible) => !visible)}
                    hitSlop={10}
                    style={styles.eyeBtn}
                  >
                    <Ionicons
                      name={passwordVisible ? 'eye-outline' : 'eye-off-outline'}
                      size={19}
                      color="#8F877B"
                    />
                  </Pressable>
                </View>

                {/* CREATE ACCOUNT BUTTON WITH GRADIENT & SUBTLE LEAF */}
                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.88}
                  style={[styles.registerButton, isBusy && styles.buttonDisabled]}
                  onPress={handleRegister}
                  disabled={isBusy}
                >
                  <LinearGradient
                    colors={['#174C35', '#123D2B', '#0D3021']}
                    start={{ x: 0, y: 0 }}
                    end={{ x: 1, y: 0 }}
                    style={styles.registerGradient}
                  >
                    <View style={styles.btnLeafWatermark} pointerEvents="none">
                      <Ionicons
                        name="leaf"
                        size={30}
                        color="rgba(255, 255, 255, 0.12)"
                      />
                    </View>

                    {loading ? (
                      <ActivityIndicator color={colors.white} />
                    ) : (
                      <View style={styles.registerBtnContent}>
                        <Text style={styles.registerButtonText}>Create Account</Text>
                        <Ionicons
                          name="arrow-forward"
                          size={17}
                          color={colors.white}
                        />
                      </View>
                    )}
                  </LinearGradient>
                </TouchableOpacity>

                {/* DIVIDER */}
                <View style={styles.divider}>
                  <View style={styles.dividerLine} />
                  <Text style={styles.dividerText}>OR</Text>
                  <View style={styles.dividerLine} />
                </View>

                {/* GOOGLE SIGN IN BUTTON */}
                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.85}
                  style={[
                    styles.googleButton,
                    isBusy && styles.buttonDisabled,
                  ]}
                  disabled={isBusy}
                  onPress={handleGoogleSignIn}
                >
                  {googleLoading ? (
                    <ActivityIndicator color={colors.primary} />
                  ) : (
                    <>
                      <View style={styles.googleIconCircle}>
                        <Ionicons name="logo-google" size={17} color="#EA4335" />
                      </View>
                      <Text style={styles.googleButtonText}>
                        Continue with Google
                      </Text>
                    </>
                  )}
                </TouchableOpacity>
              </View>

              {/* ACCOUNT SWITCH */}
              <View style={styles.accountSwitch}>
                <Text style={styles.accountText}>
                  Already have an account?
                </Text>
                <TouchableOpacity
                  accessibilityRole="button"
                  onPress={() =>
                    router.push({
                      pathname: '/(auth)/login',
                      params: { returnTo: postLoginRoute },
                    })
                  }
                  hitSlop={8}
                >
                  <Text style={styles.accountLink}>Login</Text>
                </TouchableOpacity>
              </View>

              {/* FOOTER MOTIF */}
              <View style={styles.footerNote}>
                <View style={styles.footerRule} />
                <MaterialCommunityIcons
                  name="leaf"
                  size={16}
                  color="#7A945A"
                  style={styles.footerLeafIcon}
                />
                <View style={styles.footerRule} />
              </View>
              <Text style={styles.footerText}>
                Mindful wellness, naturally
              </Text>
            </View>
          </View>
        </ScrollView>
      </KeyboardAvoidingView>
    </SafeAreaView>
  );
}

