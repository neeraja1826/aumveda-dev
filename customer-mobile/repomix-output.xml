import React, {
  useEffect,
  useRef,
  useState,
} from 'react';

import {
  ActivityIndicator,
  Image,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
  Alert,
} from 'react-native';

import { Ionicons } from '@expo/vector-icons';
import { useRouter } from 'expo-router';
import { LinearGradient } from 'expo-linear-gradient';

import { useCart } from '../../src/context/CartContext';
import { useWishlist } from '../../src/context/WishlistContext';
import { getProductById } from '../../src/services/productService';
import { SafeAreaView } from 'react-native-safe-area-context';
import CouponApplication from '../../src/components/CouponApplication';
import {
  clearStoredCoupon,
  getStoredCoupon,
} from '../../src/services/couponStorage';

export default function CartScreen() {
  const router = useRouter();
  const [appliedCoupon, setAppliedCoupon] = useState(null);
  const [productDescriptions, setProductDescriptions] = useState({});
  const requestedDescriptions = useRef(new Set());
  const isMounted = useRef(true);

  // -----------------------------------------
  // CART
  // -----------------------------------------

  const {
    cartItems,
    cartCount,
    subtotal,
    isEmpty,
    isCartLoaded,
    cartError,
    reloadCart,
    increaseQuantity,
    decreaseQuantity,
    removeFromCart,
  } = useCart();

  useEffect(() => {
    let active = true;
    getStoredCoupon()
      .then((coupon) => {
        if (active) setAppliedCoupon(coupon);
      })
      .catch((error) => {
        console.error('Unable to load the applied coupon:', error);
      });

    return () => {
      active = false;
    };
  }, []);

  useEffect(() => {
    if (!isCartLoaded || !isEmpty) return;
    clearStoredCoupon()
      .then(() => setAppliedCoupon(null))
      .catch((error) => {
        console.error('Unable to clear the applied coupon:', error);
      });
  }, [isCartLoaded, isEmpty]);

  const cartCoupon = appliedCoupon?.placement === 'cart'
    ? appliedCoupon
    : null;
  const couponDiscount = cartCoupon?.applied
    ? Math.min(Number(subtotal || 0), Number(cartCoupon.discount_amount || 0))
    : 0;
  const cartTotal = Math.max(0, Number(subtotal || 0) - couponDiscount);

  // -----------------------------------------
  // WISHLIST
  // -----------------------------------------

  const {
    addProduct,
  } = useWishlist();

  useEffect(() => {
    return () => {
      isMounted.current = false;
    };
  }, []);

  useEffect(() => {
    cartItems.forEach((item) => {
      if (
        item.description ||
        !item.productId ||
        requestedDescriptions.current.has(item.itemKey)
      ) {
        return;
      }

      requestedDescriptions.current.add(item.itemKey);

      getProductById(item.productId)
        .then((product) => {
          const description =
            product?.description ??
            product?.short_description;

          if (
            isMounted.current &&
            typeof description === 'string' &&
            description.trim()
          ) {
            setProductDescriptions((current) => ({
              ...current,
              [item.itemKey]: description.trim(),
            }));
          }
        })
        .catch((error) => {
          console.error(
            'Cart product description error:',
            error
          );
        });
    });
  }, [cartItems]);

  // -----------------------------------------
  // REMOVE ITEM
  // -----------------------------------------

  const handleRemovePress = (item) => {
    if (!item?.itemKey) {
      return;
    }

    Alert.alert(
      'Remove Product',
      `What would you like to do with "${item.name}"?`,
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },

        {
          text: 'Remove from Cart',
          style: 'destructive',
          onPress: () => {
            removeFromCart(
              item.itemKey
            );
          },
        },

        {
          text: 'Move to Wishlist',
          onPress: async () => {
            try {
              const product = {
                id: item.productId,
                name: item.name,
                slug: item.slug,
                image: item.image,
                price: item.price,

                variant: item.variantId
                  ? {
                      id: item.variantId,
                      name: item.variantName,
                      price: item.price,
                    }
                  : null,
              };

              const result =
                await addProduct(
                  product
                );

              if (!result?.success) {
                Alert.alert(
                  'Unable to move',
                  result?.error?.message ||
                    'Could not add this product to your wishlist.'
                );

                return;
              }

              // Remove from cart only
              // after wishlist succeeds.
              removeFromCart(
                item.itemKey
              );

              Alert.alert(
                'Moved to Wishlist',
                `${item.name} has been moved to your wishlist.`
              );
            } catch (error) {
              console.error(
                'MOVE TO WISHLIST ERROR:',
                error
              );

              Alert.alert(
                'Unable to move',
                'Something went wrong. Please try again.'
              );
            }
          },
        },
      ]
    );
  };

  const handleProductPress = (item) => {
    if (!item?.slug) {
      console.warn(
        'Cart product does not have a slug:',
        item
      );
      return;
    }

    router.push({
      pathname: '/products/[slug]',
      params: {
        slug: item.slug,
      },
    });
  };

  // -----------------------------------------
  // EMPTY CART
  // -----------------------------------------
  if (!isCartLoaded) {
    return (
      <SafeAreaView
        style={styles.emptyContainer}
        edges={['top', 'bottom']}
      >
        <ActivityIndicator
          size="large"
          color="#0F442C"
        />
      </SafeAreaView>
    );
  }

  if (cartError && isEmpty) {
    return (
      <SafeAreaView style={styles.emptyContainer} edges={['top', 'bottom']}>
        <Text
          style={styles.emptyDescription}
          accessibilityLiveRegion="polite"
        >
          {cartError}
        </Text>
        <Pressable
          style={styles.shopButtonWrapper}
          onPress={reloadCart}
          accessibilityRole="button"
          accessibilityLabel="Retry loading your cart"
        >
          <Text style={styles.shopButtonText}>Try Again</Text>
        </Pressable>
      </SafeAreaView>
    );
  }

  if (isEmpty) {
    return (
      <SafeAreaView style={styles.emptyContainer} edges={['top', 'bottom']}>
        <View style={styles.emptyIconWrapper}>
          <View style={styles.emptyIconInner}>
            <Ionicons name="bag-handle-outline" size={42} color="#A87E34" />
          </View>
        </View>

        <Text style={styles.emptyTitle}>Your Cart is Empty</Text>

        <Text style={styles.emptyDescription}>
          Immerse yourself in authentic Ayurvedic wellness and discover pure botanical formulations crafted for daily harmony.
        </Text>

        <Pressable
          style={({ pressed }) => [
            styles.shopButtonWrapper,
            pressed && styles.buttonPressed,
          ]}
          onPress={() => router.push('/products')}
          accessibilityRole="button"
          accessibilityLabel="Explore Formulations"
        >
          <LinearGradient
            colors={['#F5D68E', '#DCA84E', '#B88226']}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
            style={styles.shopButton}
          >
            <Text style={styles.shopButtonText}>Explore Formulations</Text>
            <Ionicons name="arrow-forward" size={16} color="#082618" />
          </LinearGradient>
        </Pressable>

        <View style={styles.emptyTrustRow}>
          <View style={styles.emptyTrustItem}>
            <Ionicons name="sparkles" size={13} color="#A87E34" />
            <Text style={styles.emptyTrustText}>100% Authentic</Text>
          </View>
          <View style={styles.emptyTrustDivider} />
          <View style={styles.emptyTrustItem}>
            <Ionicons name="shield-checkmark" size={13} color="#A87E34" />
            <Text style={styles.emptyTrustText}>Secure Checkout</Text>
          </View>
          <View style={styles.emptyTrustDivider} />
          <View style={styles.emptyTrustItem}>
            <Ionicons name="gift-outline" size={13} color="#A87E34" />
            <Text style={styles.emptyTrustText}>Free Delivery</Text>
          </View>
        </View>
      </SafeAreaView>
    );
  }

  // -----------------------------------------
  // MAIN CART
  // -----------------------------------------
  return (
    <SafeAreaView style={styles.container} edges={['top', 'bottom']}>
      {/* ---------------------------------- */}
      {/* HEADER */}
      {/* ---------------------------------- */}
      <View style={styles.header}>
        <View style={styles.headerLeft}>
          <View style={styles.eyebrowRow}>
            <Ionicons name="sparkles" size={11} color="#A87E34" />
            <Text style={styles.eyebrow}>AUMVEDA BOTANICALS</Text>
          </View>

          <Text style={styles.title}>Your Cart</Text>
        </View>

        <View style={styles.countBadge}>
          <Text style={styles.countBadgeText}>
            {cartCount} {cartCount === 1 ? 'Item' : 'Items'}
          </Text>
        </View>
      </View>

      {/* Free Delivery Banner */}
      <View style={styles.deliveryBanner}>
        <Ionicons name="gift-outline" size={15} color="#0F442C" />
        <Text style={styles.deliveryBannerText}>
          ✨ Complimentary Express Delivery included with your order!
        </Text>
      </View>

      {cartError ? (
        <View
          style={{
            marginHorizontal: 16,
            marginTop: 10,
            padding: 12,
            borderRadius: 12,
            backgroundColor: '#FDECEC',
          }}
        >
          <Text
            style={{ color: '#842029' }}
            accessibilityLiveRegion="polite"
          >
            {cartError}
          </Text>
          <Pressable onPress={reloadCart} accessibilityRole="button">
            <Text style={{ color: '#0F442C', marginTop: 6, fontWeight: '700' }}>
              Retry
            </Text>
          </Pressable>
        </View>
      ) : null}

      {/* ---------------------------------- */}
      {/* CART ITEMS */}
      {/* ---------------------------------- */}
      <ScrollView
        style={styles.scroll}
        contentContainerStyle={styles.scrollContent}
        showsVerticalScrollIndicator={false}
      >
        {cartItems.map((item) => (
          <View key={item.itemKey} style={styles.cartItem}>
            {/* Image */}
            <Pressable
              style={styles.imageContainer}
              onPress={() => handleProductPress(item)}
            >
              {item.image ? (
                <Image
                  source={{ uri: item.image }}
                  style={styles.productImage}
                  resizeMode="contain"
                />
              ) : (
                <View style={styles.noImage}>
                  <Ionicons name="leaf-outline" size={28} color="#0F442C" />
                </View>
              )}
            </Pressable>

            {/* Details */}
            <View style={styles.details}>
              <View style={styles.topRow}>
                <Pressable
                  style={styles.productLink}
                  onPress={() => handleProductPress(item)}
                >
                  <Text style={styles.productName} numberOfLines={2}>
                    {item.name}
                  </Text>
                </Pressable>

                {/* Remove */}
                <Pressable
                  onPress={() => handleRemovePress(item)}
                  hitSlop={10}
                  style={({ pressed }) => [
                    styles.removeButton,
                    pressed && styles.buttonPressed,
                  ]}
                  accessibilityRole="button"
                  accessibilityLabel="Remove item"
                >
                  <Ionicons name="trash-outline" size={17} color="#948E84" />
                </Pressable>
              </View>

              {(item.description || productDescriptions[item.itemKey]) ? (
                <Text style={styles.description} numberOfLines={1}>
                  {item.description || productDescriptions[item.itemKey]}
                </Text>
              ) : null}

              {/* Variant Badge */}
              {item.variantName ? (
                <View style={styles.variantBadge}>
                  <Text style={styles.variantText}>{item.variantName}</Text>
                </View>
              ) : null}

              {/* Price & Quantity Controls */}
              <View style={styles.bottomRow}>
                <View style={styles.quantityContainer}>
                  <Pressable
                    style={styles.quantityButton}
                    onPress={() => decreaseQuantity(item.itemKey)}
                    hitSlop={6}
                    accessibilityRole="button"
                    accessibilityLabel="Decrease quantity"
                  >
                    <Ionicons name="remove" size={14} color="#0F442C" />
                  </Pressable>

                  <Text style={styles.quantity}>{item.quantity}</Text>

                  <Pressable
                    style={styles.quantityButton}
                    onPress={() => increaseQuantity(item.itemKey)}
                    hitSlop={6}
                    accessibilityRole="button"
                    accessibilityLabel="Increase quantity"
                  >
                    <Ionicons name="add" size={14} color="#0F442C" />
                  </Pressable>
                </View>

                {/* Item Total */}
                <Text style={styles.itemTotal}>
                  ₹{(Number(item.price || 0) * Number(item.quantity || 0)).toLocaleString('en-IN')}
                </Text>
              </View>
            </View>
          </View>
        ))}

        {/* -------------------------------- */}
        {/* CART TOTALS AND CHECKOUT */}
        {/* -------------------------------- */}
        <LinearGradient
          colors={['#0C2B1D', '#061D13']}
          style={styles.summary}
        >
          <View style={styles.summaryHeaderRow}>
            <Ionicons name="sparkles" size={12} color="#D4AF37" />
            <Text style={styles.summaryEyebrow}>ORDER SUMMARY</Text>
          </View>

          <CouponApplication
            placement="cart"
            subtotal={subtotal}
            coupon={cartCoupon}
            onChange={setAppliedCoupon}
          />

          <View style={styles.summaryDetails}>
            <View style={styles.summaryDetailRow}>
              <Text style={styles.summaryLabel}>Total Items</Text>
              <Text style={styles.summaryValue}>{cartCount}</Text>
            </View>

            <View style={styles.summaryDetailRow}>
              <Text style={styles.summaryLabel}>Subtotal</Text>
              <Text style={styles.summaryValue}>
                ₹{Number(subtotal || 0).toLocaleString('en-IN')}
              </Text>
            </View>

            {couponDiscount > 0 ? (
              <View style={styles.summaryDetailRow}>
                <Text style={styles.summaryLabel}>Coupon discount</Text>
                <Text style={styles.couponDiscount}>
                  -₹{couponDiscount.toLocaleString('en-IN')}
                </Text>
              </View>
            ) : null}

            <View style={styles.summaryDetailRow}>
              <Text style={styles.summaryLabel}>Standard Delivery</Text>
              <View style={styles.freeBadge}>
                <Text style={styles.freeBadgeText}>FREE</Text>
              </View>
            </View>
          </View>

          <View style={styles.summaryDivider} />

          <View style={styles.summaryTotalRow}>
            <Text style={styles.totalLabel}>Estimated Total</Text>
            <Text style={styles.summaryPrice}>
              ₹{cartTotal.toLocaleString('en-IN')}
            </Text>
          </View>

          {/* Checkout Button */}
          <Pressable
            style={({ pressed }) => [
              styles.checkoutButtonWrapper,
              pressed && styles.buttonPressed,
            ]}
            onPress={() => router.push('/checkout')}
            accessibilityRole="button"
            accessibilityLabel="Proceed to Checkout"
          >
            <LinearGradient
              colors={['#F5D68E', '#DCA84E', '#B88226']}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 1 }}
              style={styles.checkoutButton}
            >
              <Text style={styles.checkoutText}>Proceed to Checkout</Text>
              <Ionicons name="arrow-forward" size={18} color="#082618" />
            </LinearGradient>
          </Pressable>

          {/* Trust Badges */}
          <View style={styles.trustRow}>
            <View style={styles.trustBadge}>
              <Ionicons name="shield-checkmark" size={14} color="#D4AF37" />
