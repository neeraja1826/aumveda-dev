import {
  Ionicons,
} from '@expo/vector-icons';

import {
  usePathname,
  useRouter,
} from 'expo-router';

import { colors } from '../../theme/colors';

const items = [
  {
    label: 'Home',
    icon: 'home-outline',
    activeIcon: 'home',
    route: '/(tabs)',
  },
  {
    label: 'Categories',
    icon: 'grid-outline',
    activeIcon: 'grid',
    route: '/(tabs)/categories',
  },
  {
    label: 'Cart',
    icon: 'cart-outline',
    activeIcon: 'cart',
    route: '/(tabs)/cart',
  },
  {
    label: 'Profile',
    icon: 'person-outline',
    activeIcon: 'person',
    route: '/(tabs)/profile',
  },
];

export default function BottomNavigation() {
  const router = useRouter();
  const pathname = usePathname();

  return (
    <View style={styles.container}>
      {items.map((item) => {
        const active =
          pathname === item.route ||
          (
            item.route === '/(tabs)' &&
            pathname === '/'
          );

        return (
          <Pressable
            key={item.label}
            style={styles.item}
            onPress={() =>
              router.push(item.route)
            }
          >
            <Ionicons
              name={
                active
                  ? item.activeIcon
                  : item.icon
              }
              size={21}
              color={
                active
                  ? colors.primary
