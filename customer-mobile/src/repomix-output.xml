                >
                  Forgot Password?
                </Link>

                <View style={styles.buttonWrapper}>
                  <AppButton
                    title="Login"
                    onPress={handleLogin}
                    loading={loading}
                  />
                </View>

                <TouchableOpacity
                  accessibilityRole="button"
                  activeOpacity={0.8}
                  style={styles.googleButton}

                  onPress={async () => {
                    try {
                      setLoading(true);

                      console.log('Starting Google sign-in');

                      const { session, error, cancelled } = await signInWithGoogle();

                      console.log('Google sign-in result:', {
                        hasSession: !!session,
                        cancelled,
                        error: error?.message ?? null,
                      });

                      if (error) {
                        Alert.alert('Google Sign-In Failed', error.message);
                        return;
                      }

                      if (cancelled) {
                        console.log('Google sign-in was cancelled');
                        return;
                      }

                      if (session) {
                        await loginWithGoogleSession(session);
                        router.replace(postLoginRoute);
                      } else {
                        Alert.alert(
                          'Sign-in incomplete',
                          'Google sign-in finished without an authenticated session. Please try again.'
                        );
                      }
                    } catch (error) {
                      console.error('Google button error:', error);
                      Alert.alert(
                        'Google Sign-In Failed',
                        error?.message || 'Please try again.'
                      );
                    } finally {
                      setLoading(false);
                    }
                  }}

                >
