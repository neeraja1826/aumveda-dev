          <Text style={styles.errorText}>
            {error ||
              (!slug
                ? 'Product slug is missing.'
                : 'We could not load this Ayurvedic formulation.')}
          </Text>

          {slug && (
            <Pressable
              style={styles.retryButton}
              onPress={handleRetry}
            >
              <Text style={styles.retryText}>
                Retry Formulation
              </Text>
            </Pressable>
          )}
        </View>
      </SafeAreaView>
    );
  }

  // ==========================================================
  // UI
  // ==========================================================

  return (
    <SafeAreaView
      style={styles.screen}
      edges={['top', 'bottom']}
    >
      {/* =====================================================
          PREMIUM HEADER
