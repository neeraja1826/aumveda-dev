import React from 'react';
import {
  View,
  Text,
  StyleSheet,
  FlatList,
  Pressable,
  ActivityIndicator,
  RefreshControl,
  Alert,
} from 'react-native';
import { Image } from 'expo-image';
import { Ionicons } from '@expo/vector-icons';
import { useRouter } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';
import { LinearGradient } from 'expo-linear-gradient';
import { StatusBar } from 'expo-status-bar';

import { useWishlist } from '../src/context/WishlistContext';
import { useCart } from '../src/context/CartContext';
import { colors } from '../src/theme/colors';

export default function WishlistScreen() {
  const router = useRouter();

  // -----------------------------------------
  // WISHLIST
  // -----------------------------------------
  const {
    wishlist,
    loading,
    removeProduct,
    loadWishlist,
  } = useWishlist();

  // -----------------------------------------
  // CART
  // -----------------------------------------
  const {
    cartItems,
    addToCart,
    increaseQuantity,
    decreaseQuantity,
  } = useCart();

  // -----------------------------------------
  // FIND CART ITEM
  // -----------------------------------------
  const getCartItem = (product) => {
    if (!product?.id) {
      return null;
    }

    const variantId = product?.variant?.id ?? null;

    return (
      cartItems.find((item) => {
        if (item?.productId !== product.id) {
          return false;
        }

        // Match exact variant
        if (variantId) {
          return item?.variantId === variantId;
        }

        return true;
      }) || null
    );
  };

  // -----------------------------------------
  // ADD TO CART
  // -----------------------------------------
  const handleAddToCart = (product) => {
    if (!product?.id) {
      return;
    }

    const existingCartItem = getCartItem(product);

    // Already in cart
    if (existingCartItem) {
      increaseQuantity(existingCartItem.itemKey);
      return;
    }

    // Not in cart
    addToCart(product, 1, product?.variant ?? null);
  };

  // -----------------------------------------
  // PLUS
  // -----------------------------------------
  const handleIncrease = (product) => {
    const cartItem = getCartItem(product);

    if (!cartItem) {
      handleAddToCart(product);
      return;
    }

    increaseQuantity(cartItem.itemKey);
  };

  // -----------------------------------------
  // MINUS
  // -----------------------------------------
  const handleDecrease = (product) => {
    const cartItem = getCartItem(product);

    if (!cartItem) {
      return;
    }

    decreaseQuantity(cartItem.itemKey);
  };

  // -----------------------------------------
  // REMOVE FROM WISHLIST
  // -----------------------------------------
  const handleRemove = async (productId) => {
    const result = await removeProduct(productId);

    if (!result?.success) {
      Alert.alert('Unable to remove', 'Please try again.');
    }
  };

  // -----------------------------------------
  // OPEN PRODUCT
  // -----------------------------------------
  const openProduct = (product) => {
    if (!product?.slug) {
      return;
    }

    router.push(`/products/${product.slug}`);
  };

  // -----------------------------------------
  // SAFE BACK NAVIGATION
  // -----------------------------------------
  const handleBack = () => {
    if (router.canGoBack()) {
      router.back();
    } else {
      router.replace('/(tabs)');
    }
  };

  // -----------------------------------------
  // PRODUCT CARD
  // -----------------------------------------
  const renderProduct = ({ item }) => {
    const cartItem = getCartItem(item);
    const quantity = Number(cartItem?.quantity || 0);
    const isInCart = Boolean(cartItem && quantity > 0);

    const price = Number(item?.price ?? item?.variant?.price ?? 0);
    const compareAtPrice = Number(
      item?.compare_at_price ?? item?.variant?.compare_at_price ?? 0
    );
    const hasDiscount = compareAtPrice > price && price > 0;
    const discount = hasDiscount
      ? Math.round(((compareAtPrice - price) / compareAtPrice) * 100)
      : 0;

    const imageUrl =
      item?.image ??
      item?.image_url ??
      item?.thumbnail ??
      item?.images?.[0] ??
      item?.product_images?.[0]?.image_url ??
      null;

    const imageSource =
      typeof imageUrl === 'string' ? { uri: imageUrl } : imageUrl;

    const categoryLabel =
      item?.category_name ||
      item?.category?.name ||
      'Ayurvedic Care';

    return (
      <View style={styles.productCard}>
        {/* PRODUCT IMAGE SECTION */}
        <Pressable
          style={styles.imageContainer}
          onPress={() => openProduct(item)}
          accessibilityRole="button"
          accessibilityLabel={`View details for ${item.name}`}
        >
          {imageUrl ? (
            <Image
              source={imageSource}
              style={styles.productImage}
              contentFit="contain"
              transition={150}
            />
          ) : (
            <View style={styles.imagePlaceholder}>
              <Ionicons
                name="leaf-outline"
                size={30}
                color={colors.sageDark}
              />
            </View>
          )}

          {/* DISCOUNT BADGE */}
          {hasDiscount && discount > 0 && (
            <View style={styles.discountBadge}>
              <Text style={styles.discountText}>{discount}% OFF</Text>
            </View>
          )}

          {/* REMOVE FROM WISHLIST BUTTON */}
          <Pressable
            style={({ pressed }) => [
              styles.removeButton,
              pressed && styles.removeButtonPressed,
            ]}
            onPress={() => handleRemove(item.id)}
            hitSlop={8}
            accessibilityRole="button"
            accessibilityLabel={`Remove ${item.name} from wishlist`}
          >
            <Ionicons name="heart" size={17} color={colors.danger} />
          </Pressable>
        </Pressable>

        {/* PRODUCT DETAILS */}
        <View style={styles.productInfo}>
          <Pressable
            onPress={() => openProduct(item)}
            style={styles.detailsPressable}
          >
            {/* CATEGORY EYEBROW */}
            <Text style={styles.categoryEyebrow} numberOfLines={1}>
              {categoryLabel.toUpperCase()}
            </Text>

            {/* NAME */}
            <Text style={styles.productName} numberOfLines={2}>
              {item.name}
            </Text>

            {/* RATING */}
            {item.rating ? (
              <View style={styles.ratingRow}>
                <View style={styles.ratingChip}>
                  <Ionicons name="star" size={11} color={colors.gold} />
                  <Text style={styles.ratingText}>
                    {Number(item.rating).toFixed(1)}
                  </Text>
                </View>

                {item.review_count ? (
                  <Text style={styles.reviewCount}>
                    ({item.review_count})
                  </Text>
                ) : null}
              </View>
            ) : null}

            {/* PRICE ROW */}
            <View style={styles.priceRow}>
              <Text style={styles.price}>
                ₹{price.toLocaleString('en-IN')}
              </Text>

              {hasDiscount && (
                <Text style={styles.comparePrice}>
                  ₹{compareAtPrice.toLocaleString('en-IN')}
                </Text>
              )}
            </View>
          </Pressable>

          {/* CART CONTROL */}
          {!isInCart ? (
            <Pressable
              style={({ pressed }) => [
                styles.addToCartButton,
                pressed && styles.addToCartButtonPressed,
              ]}
              onPress={() => handleAddToCart(item)}
              accessibilityRole="button"
              accessibilityLabel={`Add ${item.name} to cart`}
            >
              <Ionicons
                name="bag-add-outline"
                size={16}
                color={colors.white}
              />
              <Text style={styles.addToCartText}>Add to Cart</Text>
            </Pressable>
          ) : (
            <View style={styles.quantityContainer}>
              {/* MINUS */}
              <Pressable
                style={({ pressed }) => [
                  styles.quantityButton,
                  pressed && styles.quantityButtonPressed,
                ]}
                onPress={() => handleDecrease(item)}
                hitSlop={8}
                accessibilityRole="button"
                accessibilityLabel="Decrease quantity"
              >
                <Ionicons name="remove" size={16} color={colors.primary} />
              </Pressable>

              {/* QUANTITY */}
              <View style={styles.quantityTextWrap}>
                <Text style={styles.quantityText}>{quantity}</Text>
                <Text style={styles.inCartSubtext}>in cart</Text>
              </View>

              {/* PLUS */}
              <Pressable
                style={({ pressed }) => [
                  styles.quantityButton,
                  pressed && styles.quantityButtonPressed,
                ]}
                onPress={() => handleIncrease(item)}
                hitSlop={8}
                accessibilityRole="button"
                accessibilityLabel="Increase quantity"
              >
                <Ionicons name="add" size={16} color={colors.primary} />
              </Pressable>
            </View>
          )}
        </View>
      </View>
    );
  };

  // -----------------------------------------
  // EMPTY STATE
  // -----------------------------------------
  const renderEmpty = () => {
    if (loading) {
      return (
        <View style={styles.centerState}>
          <View style={styles.loadingCard}>
            <ActivityIndicator size="large" color={colors.primary} />
            <Text style={styles.loadingText}>
              Gathering your botanical treasures...
            </Text>
          </View>
        </View>
      );
    }

    return (
      <View style={styles.centerState}>
        <View style={styles.stateCard}>
          {/* DUAL RING BOTANICAL ICON */}
          <View style={styles.stateIconOuter}>
            <View style={styles.stateIconInner}>
              <Ionicons name="heart-outline" size={34} color={colors.danger} />
            </View>
          </View>

          <View style={styles.emptyEyebrowRow}>
            <Ionicons name="sparkles" size={11} color={colors.gold} />
            <Text style={styles.emptyEyebrow}>YOUR WELLNESS WISHLIST</Text>
          </View>

          <Text style={styles.emptyTitle}>Your Wishlist is Empty</Text>

          <Text style={styles.emptyDescription}>
            Save your favorite Ayurvedic formulations, herbal remedies, and teas to curate your personal wellness ritual.
          </Text>

          <Pressable
            style={({ pressed }) => [
              styles.shopButton,
              pressed && styles.buttonPressed,
            ]}
            onPress={() => router.replace('/(tabs)')}
            accessibilityRole="button"
            accessibilityLabel="Explore Products"
          >
            <LinearGradient
              colors={['#123D2B', '#1E583E']}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 1 }}
              style={styles.shopButtonGradient}
            >
              <Text style={styles.shopButtonText}>Explore Products</Text>
              <Ionicons name="arrow-forward" size={16} color={colors.white} />
            </LinearGradient>
          </Pressable>

          {/* TRUST BADGES ROW */}
          <View style={styles.trustRow}>
            <View style={styles.trustItem}>
              <Ionicons name="leaf-outline" size={13} color={colors.primary} />
              <Text style={styles.trustText}>100% Herbal</Text>
            </View>
            <View style={styles.trustDivider} />
            <View style={styles.trustItem}>
              <Ionicons name="shield-checkmark-outline" size={13} color={colors.primary} />
