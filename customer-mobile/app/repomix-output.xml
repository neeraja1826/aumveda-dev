              <View style={styles.trustIconCircle}>
                <Ionicons
                  name="cube-outline"
                  size={16}
                  color="#143828"
                />
              </View>
              <Text style={styles.trustTitle}>Free Express</Text>
              <Text style={styles.trustSubtitle}>Fast Dispatch</Text>
