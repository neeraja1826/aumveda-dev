  },

  title: {
    fontSize: 16,
    fontWeight: '700',
    color: '#123D2B',
    fontFamily: 'InterSemiBold',
    letterSpacing: -0.2,
  },

  /* HORIZONTAL STEPPER */
  stepperWrapper: {
